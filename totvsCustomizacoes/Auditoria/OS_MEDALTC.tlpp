#INCLUDE "TOTVS.CH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "FILEIO.CH"

#DEFINE __JOB_NAME   "OSMEDALTC"

// Log em arquivo, um por dia: __LOG_DIR + __LOG_ARQ + "_AAAAMMDD.log" (relativo ao RootPath).
// Gravado pelo PlsPtuLog (padrao PLS, grava em \logpls\); __LOG_DIR so vale no fallback fLogArq
#DEFINE __LOG_DIR    "\logpls\"
#DEFINE __LOG_ARQ    "alto_custo"

// Destinatarios do alerta; cada e-mail um elemento: {"a@oestesaude.com.br", "b@oestesaude.com.br"}
// #DEFINE __MAIL_TO    {"michel.ramos@oestesaude.com.br"}
#DEFINE __MAIL_TO    {"michel.ramos@oestesaude.com.br", "alencar.magalhaes@oestesaude.com.br", "teresa.bueno@oestesaude.com.br"}

// SMTP do alerta (conta sistema@ da Skymail), fixo no fonte; nao usa os MV_REL*
#DEFINE __SMTP_HOST  "sender.skymail.net.br"
#DEFINE __SMTP_PORTA 587
#DEFINE __SMTP_USER  "sistema@oestesaude.com.br"
#DEFINE __SMTP_SENHA "fr6RxF41Q8de"
#DEFINE __SMTP_FROM  __SMTP_USER
#DEFINE __SMTP_AUTH  .T.
#DEFINE __SMTP_SSL   .F.
#DEFINE __SMTP_TLS   .T.

// URL da API: __URL_PROD no ambiente __ENV_PROD, __URL_DEV em qualquer outro (ver fApiUrl)
#DEFINE __ENV_PROD   "CYWSXT_PROD"
#DEFINE __URL_PROD   "http://10.1.5.14:6177"
#DEFINE __URL_DEV    "http://10.1.5.14:6177"
#DEFINE __API_PATH   "/verificar-sftp"
#DEFINE __API_URL    fApiUrl()
// GET que informa se a IA esta ligada (IA_HABILITADA) e o criterio dos medicamentos (MEDICAMENTO_*) no .env da API
#DEFINE __CFG_PATH   "/config"
// POST com a lista completa de medicamentos, uma vez por execucao; devolve o listaId usado no __API_PATH
#DEFINE __LST_PATH   "/medicamentos"
// Erro da API quando nao conhece o listaId (API reiniciada): o job reenvia a lista e tenta de novo
#DEFINE __LST_DESC   "lista de medicamentos desconhecida"
#DEFINE __API_TOKEN  SuperGetMV("Z_MEDAPIT", .F., "")

// Departamentos (B71_CODDEP) verificados; {} = todos
//#DEFINE __CODDEP     {"012"}
#DEFINE __CODDEP     {}
#DEFINE __CODOBJ     ""

// Debug: B71_DATMOV fixo (AAAAMMDD) no lugar da data de hoje. Deixar "" em producao
#DEFINE __DATA_DBG   ""

#DEFINE __PAR_WATER  "Z_NOTIENCA"

// Posicoes do resumo devolvido por U_OSMEDALTC / fProcessa()
#DEFINE __P_TOTAL    1
#DEFINE __P_FEITAS   2
#DEFINE __P_EMAILS   3
#DEFINE __P_INICIO   4
#DEFINE __P_FINAL    5

// Posicoes do item de B71 devolvido por fConsulta()
#DEFINE __I_RECNO    1
#DEFINE __I_ALIMOV   2
#DEFINE __I_RECMOV   3
#DEFINE __I_NUMGUI   4
#DEFINE __I_ANEXOS   5
#DEFINE __I_STATUS   6
#DEFINE __I_TEXTOS   7
#DEFINE __I_DATMOV   8
#DEFINE __I_PESSOAS  9
#DEFINE __I_TIPO     10
#DEFINE __I_B53GUI   11
#DEFINE __I_CHVBEA   12
#DEFINE __I_BENEF    13
#DEFINE __I_DATENT   14
#DEFINE __I_TAM      14

// Chave da BEA (= indice 1 da BE2 e formato do B53_NUMGUI), lida no registro do B71_RECMOV
#DEFINE __CPO_CHVBEA {"BEA_OPEMOV", "BEA_ANOAUT", "BEA_MESAUT", "BEA_NUMAUT"}

// Campo da B53 que, com o B71_ALIMOV, escolhe a tabela de itens da guia (fCfgProc)
#DEFINE __CPO_B53    {"B53_TIPO"}
// B53_TIPO cujos itens ficam na BE2 (cabecalho BEA); 11 com B71_ALIMOV = B4Q usa a BQV; os demais, a B4C
#DEFINE __TIP_BE2    {1, 2, 3, 4, 5, 7}
#DEFINE __TIP_BQV    11
// B53_NUMGUI = OPEMOV + ANOAUT + MESAUT + NUMAUT: tamanho de cada parte, na ordem da chave dos itens
#DEFINE __NUMGUI_PT  {4, 4, 2, 8}

// Posicoes do mapa de itens devolvido por fCfgProc()
#DEFINE __C_ALIAS    1
#DEFINE __C_CHAVE    2
#DEFINE __C_CODPAD   3
#DEFINE __C_CODPRO   4
#DEFINE __C_QTD      5
#DEFINE __C_VALOR    6

// Campos de nome lidos na tabela origem da guia (prefixo = alias), se existirem no dicionario
#DEFINE __CPO_NOMES  {"_NOMUSR", "_NOMSOL"}
// Campos da matricula do beneficiario na tabela origem, na ordem da chave da BA1
#DEFINE __CPO_MATRIC {"_OPEUSR", "_CODEMP", "_MATRIC", "_TIPREG", "_DIGITO"}
// Data em que a guia entrou no sistema, na tabela origem (prefixo = alias): vale o primeiro sufixo
// que existir no dicionario e estiver preenchido (conferir com levantamento/08-campos-data-entrada.sql)
#DEFINE __CPO_DATENT {"_DTDIGI", "_DATDIG", "_DATSOL"}

// Posicoes de cada anexo em __I_ANEXOS
#DEFINE __A_CODOBJ   1
#DEFINE __A_OBJETO   2

// Posicoes de cada anexo verificado em __I_TEXTOS (preenchido por fProcessaB71)
#DEFINE __T_OBJETO   1
#DEFINE __T_METODO   2
#DEFINE __T_ACHADOS  3
#DEFINE __T_AVISOS   4

// Posicoes do retorno de fExtraiTexto()
#DEFINE __R_OK       1
#DEFINE __R_METODO   2
#DEFINE __R_ERRO     3
#DEFINE __R_DEFINIT  4
#DEFINE __R_ACHADOS  5
#DEFINE __R_AVISOS   6
#DEFINE __R_MODELO   7
#DEFINE __R_CANDID   8

// Posicoes da lista de medicamentos enviada a API (fEnviaLista)
#DEFINE __LS_MEDS    1
#DEFINE __LS_ID      2

// Posicoes de cada achado da API em __R_ACHADOS / __T_ACHADOS
#DEFINE __V_CODIGO   1
#DEFINE __V_TERMO    2
#DEFINE __V_OBS      3

// Posicoes de cada aviso da API em __R_AVISOS / __T_AVISOS
#DEFINE __W_TIPO     1
#DEFINE __W_CODIGO   2
#DEFINE __W_OBS      3

// Segundos por anexo. A API limita o OCR de PDF a PDF_MAX_PAGINAS paginas para caber aqui
#DEFINE __API_TIMEOUT 300

// Termos com menos letras que isso nao vao para a IA (a descricao da BR8 sempre vai)
#DEFINE __MIN_TERMO  4

// Tabelas padrao (BR8_CODPAD) consideradas no alto custo
#DEFINE __CODPAD_BR8 {"00", "20"}

// Criterio da lista de medicamentos (MEDICAMENTO_CRITERIO no .env da API, lido pelo GET __CFG_PATH):
// __CRIT_ALT = BR8_ALTCUS = '1'; __CRIT_VLR = valor de tabela BD4 vigente > MEDICAMENTO_VALOR_MIN.
// __CRIT_PAD vale quando a API (versao anterior) nao informa o criterio
#DEFINE __CRIT_ALT   "ALTCUS"
#DEFINE __CRIT_VLR   "VALOR"
#DEFINE __CRIT_PAD   __CRIT_ALT

// Posicoes de cada item de alto custo do alerta (fProcAltoCusto, fBuscaMed, fMescla)
#DEFINE __F_CODPSA   1
#DEFINE __F_DESCRI   2
#DEFINE __F_TERMO    3
#DEFINE __F_OBJETO   4
#DEFINE __F_CODPAD   5
#DEFINE __F_VLRTAB   6
#DEFINE __F_VLRGUI   7
#DEFINE __F_IAOBS    8
#DEFINE __F_ORIGEM   9
#DEFINE __F_QTD      10

// Valores de __F_ORIGEM
#DEFINE __O_PROC     "Procedimento"
#DEFINE __O_PROCIA   "Procedimento + IA"
#DEFINE __O_IA       "Anexo (IA)"

// Valor na guia de medicamento que a IA achou no anexo e nao esta nos itens da guia
#DEFINE __VLR_NAO    "nao consta"

// Posicoes do item de medicamento devolvido por fCarregaMed()
#DEFINE __M_CODPSA   1
#DEFINE __M_DESCRI   2
#DEFINE __M_TERMOS   3
#DEFINE __M_CODPAD   4
#DEFINE __M_VLRTAB   5

// Cadastro das tabelas de preco (BD4_CODTAB = CODINT + CODIGO): descricao e Tp.Pad.Saude no e-mail.
// Sem a tabela/campos no dicionario, o e-mail sai so com o codigo. Ordem: CODINT, CODIGO, descricao, CODPAD
#DEFINE __TAB_ALIAS  "BF8"
#DEFINE __TAB_CPOS   {"BF8_CODINT", "BF8_CODIGO", "BF8_DESCM", "BF8_CODPAD"}

// Posicoes de cada linha do valor de tabela (__M_VLRTAB / __F_VLRTAB quando array; texto = __VLR_ND ou sem valor)
#DEFINE __L_VALOR    1
#DEFINE __L_CODTAB   2
#DEFINE __L_DESCRI   3
#DEFINE __L_CODPAD   4
#DEFINE __L_UNID     5
#DEFINE __L_VIGFIM   6

// Texto mostrado no e-mail quando a tabela/campo de valor nao existe no dicionario
#DEFINE __VLR_ND     "n/d"

// Status de cada B71 resolvida por fMontaB71()
#DEFINE __ST_OK        "OK"
#DEFINE __ST_SEMANEXO  "SEM_ANEXO"
#DEFINE __ST_SEMGUIA   "SEM_GUIA"
#DEFINE __ST_ORIGEM    "ORIGEM_NAO_ENCONTRADA"
#DEFINE __ST_ALIAS     "ALIAS_DESCONHECIDO"
#DEFINE __ST_CAMPO     "CAMPO_GUIA_INEXISTENTE"
#DEFINE __ST_SEMB53    "SEM_B53"
#DEFINE __ST_CPOB53    "CAMPO_B53_INEXISTENTE"

/*/{Protheus.doc} OSMEDALTC
Job de deteccao de itens de alto custo em guias (procedimentos lancados e anexos).

Fluxo: B71 (R_E_C_N_O_ > Z_NOTIENCA, DATMOV = hoje, CODDEP em __CODDEP; {} = todos)
  -> tabela origem (BEA | BE4 | B44 | B4Q | B4A) -> numero da guia -> B53 (B53_TIPO)
     (B71 da BEA com BEA_GUIORI vazio: guia = chave da propria BEA, OPEMOV + ANOAUT + MESAUT + NUMAUT)
  -> 1. procedimentos lancados na guia, pela chave do B53_NUMGUI (fCfgProc; BE2 de B71 da BEA: chave da BEA):
        B53_TIPO 1, 2, 3, 4, 5, 7 -> BE2; 11 com B71_ALIMOV = B4Q -> BQV; demais -> B4C
        item cujo CODPAD + CODPRO esta na lista de medicamentos (fCarregaMed) e procedimento de alto custo.
        A lista segue o criterio do GET __CFG_PATH (MEDICAMENTO_CRITERIO no .env da API), com CODPAD em
        __CODPAD_BR8: ALTCUS = BR8_ALTCUS = '1'; VALOR = valor de tabela BD4 vigente > MEDICAMENTO_VALOR_MIN
  -> 2. so com a IA ligada (IA_HABILITADA no .env da API, lido por GET __CFG_PATH a cada execucao):
        a lista completa de medicamentos BR8/BA8 vai uma vez por execucao no POST __LST_PATH (sem limite
        de tamanho no job), que devolve o listaId. Para cada anexo, AC9 -> ACB -> API (__API_URL) com o
        ACB_OBJETO, o listaId e os nomes da guia a mascarar: a API baixa o arquivo do SFTP, extrai o
        texto, faz uma pre-busca das palavras da lista no texto (tolerando erros de OCR) e pede ao Claude
        so os candidatos achados. A IA confirma os procedimentos e acrescenta medicamentos citados que nao
        foram lancados (confianca alta ou media; baixa so no log). API reiniciada no meio da execucao
        responde __LST_DESC e o job reenvia a lista
  -> e-mail para os destinatarios de __MAIL_TO se houver algum item.

Com a IA desligada, os anexos nao sao enviados a API e o alerta sai so pelos procedimentos. Com a IA
ligada mas indisponivel (sem chave, Claude fora), a API devolve erro e a B71 fica para a proxima rodada,
como em qualquer falha temporaria da API.

As credenciais do SFTP ficam no .env da API, nao no Protheus. O job envia o ambiente
(GetEnvServer) no POST e a API usa o SFTP de producao quando ele e CYWSXT_PROD, senao o de dev.

URL da API por ambiente (GetEnvServer): CYWSXT_PROD -> __URL_PROD + __API_PATH;
qualquer outro -> __URL_DEV + __API_PATH.

Parametros SX6:
  Z_NOTIENCA - ultimo R_E_C_N_O_ da B71 ja verificado (criar com U_OSCRIAZNOT)
  Z_MEDAPIT  - token Bearer da API de extracao

SMTP: conta fixa no fonte (__SMTP_HOST, __SMTP_PORTA, __SMTP_USER, __SMTP_SENHA...); nao usa os MV_REL*.

Z_NOTIENCA avanca apos cada B71 concluida (com ou sem anexo/medicamento/e-mail). Falha de API
(inclusive o GET __CFG_PATH), SFTP, SMTP ou da consulta dos itens interrompe a execucao sem avancar, e a
B71 e retomada na proxima rodada. B53_TIPO ausente no dicionario tambem bloqueia.

Agendamento (Scheduler / CFGX032):
  Rotina....: U_OSMEDALTC
  Parametros: {'01','01'} (empresa, filial)
  Recorrencia: a cada 15 minutos
  Execucao concorrente bloqueada por LockByName.

Log: \logpls\alto_custo_AAAAMMDD.log no RootPath (um arquivo por dia, gravado pelo PlsPtuLog),
alem do console do AppServer.

Teste: U_chkMEDALTC([cArquivo]) confere configuracao, API/SFTP e SMTP sem gravar nada;
U_mailMEDALTC([cPara]) envia um e-mail de teste pela conta do alerta; U_dbgMEDALTC roda o job; U_dataMEDALTC("AAAAMMDD") roda o job para as B71 de outra data;
U_tstMEDALTC (teste-integrado/OS_TSTMEDALTC.tlpp) roda duas vezes
e confere que nao ha reprocessamento.

@type function
@author Michel Ramos
@since 28/09/2026
@param aJob, array, {cEmpresa, cFilial} enviado pelo Scheduler
@return array, resumo {nTotalB71, nVerificadas, nEmails, nWaterInicial, nWaterFinal};
	watermark -1 quando a execucao nao chegou a ler o Z_NOTIENCA
/*/
User Function OSMEDALTC(aJob)
Return fExecuta(aJob, Nil)

/*/{Protheus.doc} fExecuta
Execucao do job: abre o ambiente, trava o lock e roda fProcessa. Compartilhada por U_OSMEDALTC
(data de hoje) e U_dataMEDALTC (data informada). A data nao vem no aJob porque o Scheduler pode
mandar outros elementos alem de empresa e filial.
@type function
@param aJob, array, {cEmpresa, cFilial}
@param xData, character, Nil = hoje; senao data informada (AAAAMMDD ou DD/MM/AAAA), validada aqui
@return array, resumo {nTotalB71, nVerificadas, nEmails, nWaterInicial, nWaterFinal}
/*/
Static Function fExecuta(aJob, xData)

	Local cEmp    := "01"
	Local cFil    := "01"
	Local cData   := ""
	Local lAbriu  := .F.
	Local bErrOld := Nil
	Local oErro   := Nil
	Local aRes    := {0, 0, 0, -1, -1}

	Default aJob := {}

	If ValType(aJob) == "A" .And. Len(aJob) >= 2
		cEmp := aJob[1]
		cFil := aJob[2]
	EndIf

	If Select("SX2") <= 0
		RpcSetType(3)
		RpcSetEnv(cEmp, cFil, , , "PLS")
		lAbriu := .T.
	EndIf

	If ValType(xData) != "U"
		cData := fDataParam(xData)
		If Empty(cData)
			fLog("ERROR", "Data invalida ou futura: '" + cValToChar(xData) + "'. Use AAAAMMDD ou DD/MM/AAAA.")
			If lAbriu
				RpcClearEnv()
			EndIf
			Return aRes
		EndIf
	EndIf

	If !LockByName(__JOB_NAME, .T., .F.)
		fLog("WARN", "Ja existe uma execucao em andamento (lock ativo). Encerrando.")
		If lAbriu
			RpcClearEnv()
		EndIf
		Return aRes
	EndIf

	fLog("INFO", "Inicio da execucao (empresa " + cEmp + ", filial " + cFil + ")" +;
		IIf(Empty(cData), "", " - data informada manualmente: " + DToC(SToD(cData))))

	bErrOld := ErrorBlock({|e| Break(e)})
	BEGIN SEQUENCE
		fProcessa(aRes, cData)
	RECOVER USING oErro
		fLog("ERROR", "Execucao interrompida: " + IIf(ValType(oErro) == "O", oErro:Description, "erro desconhecido"))
	END SEQUENCE
	ErrorBlock(bErrOld)

	fLog("INFO", "Fim da execucao")

	UnLockByName(__JOB_NAME, .T., .F.)

	If lAbriu
		RpcClearEnv()
	EndIf

Return aRes

/*/{Protheus.doc} dbgMEDALTC
Executa o job manualmente para depuracao.
@type function
@return array, resumo de U_OSMEDALTC
/*/
User Function dbgMEDALTC()
Return U_OSMEDALTC({'01','01'})

/*/{Protheus.doc} dataMEDALTC
Executa o job manualmente verificando as B71 de uma data (B71_DATMOV) no lugar de hoje, com o
fluxo normal: B71 com R_E_C_N_O_ > Z_NOTIENCA, extracao, e-mail e avanco do Z_NOTIENCA.
B71 dessa data com recno <= Z_NOTIENCA nao sao vistas; para inclui-las, baixar antes o
Z_NOTIENCA (U_OSCRIAZNOT("<recno - 1>")), com o agendamento pausado.
Uso: U_dataMEDALTC("20260925") ou U_dataMEDALTC("25/09/2026")
@type function
@param cData, character, data da movimentacao: AAAAMMDD ou DD/MM/AAAA
@return array, resumo como o de U_OSMEDALTC ({0,0,0,-1,-1} se a data for invalida)
/*/
User Function dataMEDALTC(cData)

	Default cData := ""

Return fExecuta({'01', '01'}, cData)

/*/{Protheus.doc} fDataParam
Converte a data informada em U_dataMEDALTC sem depender do SET DATE do ambiente.
@type function
@param xData, character|date, AAAAMMDD, DD/MM/AAAA ou tipo Data
@return character, AAAAMMDD, ou "" se vazia, inexistente (ex.: 31/02) ou futura
/*/
Static Function fDataParam(xData)

	Local cData := ""

	Do Case
	Case ValType(xData) == "D"
		cData := DToS(xData)
	Case ValType(xData) == "C" .And. Len(AllTrim(xData)) == 10 .And. SubStr(AllTrim(xData), 3, 1) == "/"
		cData := AllTrim(xData)
		cData := Right(cData, 4) + SubStr(cData, 4, 2) + Left(cData, 2)
	Case ValType(xData) == "C"
		cData := AllTrim(xData)
	EndCase

	// SToD nao recusa data inexistente; a volta por DToS precisa dar o mesmo texto
	If Len(cData) != 8 .Or. !fSoDigitos(cData) .Or. DToS(SToD(cData)) != cData .Or. SToD(cData) > Date()
		cData := ""
	EndIf

Return cData

/*/{Protheus.doc} chkMEDALTC
Diagnostico do teste integrado: confere cada peca sem gravar Z_NOTIENCA e sem enviar e-mail
(configuracao, watermark, flag da IA, medicamentos, B71 da janela com B53_TIPO, tabela de itens e
procedimentos de alto custo, API + token + SFTP e conexao SMTP).
Com cArquivo (um ACB_OBJETO real) e a IA ligada, verifica o anexo na API (extracao + IA) e lista os
medicamentos que entrariam no alerta e os avisos. Sem cArquivo ou com a IA desligada, a IA nao e chamada.
Uso: U_chkMEDALTC() ou U_chkMEDALTC("arquivo.pdf")
@type function
@param cArquivo, character, opcional; nome do arquivo no SFTP (sem pasta)
@return logical, .T. se todas as verificacoes passaram
/*/
User Function chkMEDALTC(cArquivo)

	Local lAbriu  := .F.
	Local lOk     := .F.
	Local bErrOld := Nil
	Local oErro   := Nil

	Default cArquivo := ""

	If Select("SX2") <= 0
		RpcSetType(3)
		RpcSetEnv("01", "01", , , "PLS")
		lAbriu := .T.
	EndIf

	fLog("INFO", "=== Diagnostico " + __JOB_NAME + " (nao grava " + __PAR_WATER + " e nao envia e-mail) ===")

	bErrOld := ErrorBlock({|e| Break(e)})
	BEGIN SEQUENCE
		lOk := fDiagnostico(AllTrim(cArquivo))
	RECOVER USING oErro
		fLog("ERROR", "Diagnostico interrompido: " + IIf(ValType(oErro) == "O", oErro:Description, "erro desconhecido"))
	END SEQUENCE
	ErrorBlock(bErrOld)

	fLog(IIf(lOk, "INFO", "ERROR"), "=== Diagnostico " + IIf(lOk, "OK", "COM FALHAS") + " ===")

	If lAbriu
		RpcClearEnv()
	EndIf

Return lOk

/*/{Protheus.doc} fDiagnostico
@type function
@param cArquivo, character, ACB_OBJETO real para extrair, ou "" para so testar API/token/SFTP
@return logical, .T. se todas as verificacoes passaram
/*/
Static Function fDiagnostico(cArquivo)

	Local lOk      := .T.
	Local lSmtp    := .F.
	Local nUltimo  := -1
	Local nCampo   := 0
	Local nSemNome := 0
	Local nSemData := 0
	Local nInicio  := 0
	Local aMed     := {}
	Local aB71     := {}
	Local aRes     := {}
	Local aItem    := {}
	Local aAchados := {}
	Local aLista   := {}
	Local oServer  := Nil
	Local oCrit    := Nil
	Local lCfg     := .F.
	Local lIa      := .F.
	Local lProcOk  := .T.
	Local lTab     := .F.
	Local cModelo  := ""
	Local cErro    := ""
	Local cFalta   := ""
	Local nI       := 0

	lOk := fChk("Configuracao (token Z_MEDAPIT e __MAIL_TO)", fValidaCfg(), "") .And. lOk

	nUltimo := fLeWatermark()
	lOk := fChk("Watermark " + __PAR_WATER, nUltimo >= 0, cValToChar(nUltimo)) .And. lOk

	lCfg := fConfigApi(@lIa, @cModelo, @oCrit, @cErro)
	lOk := fChk("Flag da IA e criterio (GET " + fApiBase() + __CFG_PATH + ")", lCfg,;
		IIf(!lCfg, cErro, IIf(lIa, "IA habilitada (" + cModelo + "): procedimentos + confirmacao nos anexos",;
			"IA desabilitada: alerta so pelos procedimentos da guia") + "; criterio " + fCritTxt(oCrit))) .And. lOk

	aMed := fCarregaMed(oCrit)
	lOk := fChk("Medicamentos de alto custo (" + fCritTxt(oCrit) + ", BR8_CODPAD " + fCodPadTxt() + ", termos da BA8 se houver)", Len(aMed) > 0, cValToChar(Len(aMed)) + " item(ns)") .And. lOk
	For nI := 1 To Min(Len(aMed), 5)
		fLog("INFO", "  " + aMed[nI][__M_CODPSA] + " " + aMed[nI][__M_DESCRI] + " | " + cValToChar(Len(aMed[nI][__M_TERMOS])) +;
			" termo(s) | valor de tabela: " + fVlrTabTxt(aMed[nI][__M_VLRTAB]))
	Next nI
	lTab := fCamposOk(__TAB_ALIAS, __TAB_CPOS, @cFalta)
	fLog(IIf(lTab, "INFO", "WARN"), "  Descricao das tabelas de preco (" + __TAB_ALIAS + "): " +;
		IIf(lTab, "campos " + fListaCpo(__TAB_CPOS) + " no dicionario", cFalta + " nao existe no dicionario; e-mail so com o codigo"))

	If nUltimo >= 0
		aB71 := fConsulta(nUltimo)
		For nI := 1 To Len(aB71)
			fLogB71(aB71[nI])
			If aB71[nI][__I_STATUS] == __ST_CAMPO .Or. aB71[nI][__I_STATUS] == __ST_CPOB53
				nCampo++
			EndIf
			If aB71[nI][__I_STATUS] == __ST_OK .Or. aB71[nI][__I_STATUS] == __ST_SEMANEXO
				fProcAltoCusto(aB71[nI], aMed, oCrit, @lProcOk)
				If !lProcOk
					nCampo++
				EndIf
				nSemNome += IIf(Empty(aB71[nI][__I_BENEF]), 1, 0)
				nSemData += IIf(Empty(aB71[nI][__I_DATENT]), 1, 0)
			EndIf
		Next nI
		lOk := fChk("B71 na janela (R_E_C_N_O_ > " + cValToChar(nUltimo) + ", DATMOV = " + fDataMov() + ", CODDEP = " + fDepTxt() + ")",;
			nCampo == 0, cValToChar(Len(aB71)) + " registro(s)" +;
			IIf(nCampo > 0, "; " + cValToChar(nCampo) + " com campo inexistente ou erro na consulta dos itens (bloqueia o watermark)", "")) .And. lOk
		If nSemNome + nSemData > 0
			fLog("WARN", "  e-mail: " + cValToChar(nSemNome) + " B71 sem nome do beneficiario e " + cValToChar(nSemData) +;
				" sem data da solicitacao (" + fListaCpo(__CPO_DATENT) + "); saem como " + __VLR_ND)
		EndIf
	EndIf

	// A API exige a lista de medicamentos (listaId) mesmo no teste de conexao
	aLista  := {aMed, ""}
	nInicio := Seconds()
	lOk := fChk("Lista de medicamentos na API (POST " + fApiBase() + __LST_PATH + ")", fEnviaLista(aLista, @cErro),;
		IIf(Empty(cErro), cValToChar(Len(aMed)) + " item(ns) em " + cValToChar(Round(Seconds() - nInicio, 1)) + "s", cErro)) .And. lOk
	nInicio := Seconds()
	If !Empty(cArquivo) .And. lCfg .And. !lIa
		fLog("INFO", "  IA desabilitada: o anexo " + cArquivo + " nao seria enviado a API; testando so a conexao")
		cArquivo := ""
	EndIf
	If Empty(cArquivo)
		aRes := fExtraiTexto("chk_medaltc_inexistente.pdf", aLista)
		lOk := fChk("API + token + SFTP (" + __API_URL + ")", aRes[__R_DEFINIT] .And. "encontrado no SFTP" $ aRes[__R_ERRO],;
			IIf(aRes[__R_DEFINIT], "API respondeu e consultou o SFTP",;
				IIf("Cannot POST" $ aRes[__R_ERRO], "API sem o " + __API_PATH + ": atualizar a API antes do patch", aRes[__R_ERRO]))) .And. lOk
		fLog("INFO", "  Para testar a extracao e a IA, informe um arquivo: U_chkMEDALTC(" + '"arquivo.pdf"' + ")")
	Else
		aRes := fExtraiTexto(cArquivo, aLista)
		lOk := fChk("Verificacao de " + cArquivo + " (extracao + pre-busca + IA)", aRes[__R_OK] .And. !Empty(aRes[__R_MODELO]),;
			IIf(!aRes[__R_OK], aRes[__R_ERRO],;
				IIf(Empty(aRes[__R_MODELO]), "resposta sem o modelo da IA (API de versao anterior): atualizar a API",;
					"via " + aRes[__R_METODO] + ", " + cValToChar(aRes[__R_CANDID]) + " candidato(s) da pre-busca, " +;
					aRes[__R_MODELO] + " em " + cValToChar(Round(Seconds() - nInicio, 1)) + "s"))) .And. lOk
		If aRes[__R_OK]
			aItem := Array(__I_TAM)
			aItem[__I_TEXTOS] := {{cArquivo, aRes[__R_METODO], aRes[__R_ACHADOS], aRes[__R_AVISOS]}}
			aAchados := fBuscaMed(aItem, aMed)
			fLog("INFO", "  " + cValToChar(Len(aAchados)) + " medicamento(s) de alto custo entraria(m) no alerta")
			For nI := 1 To Len(aAchados)
				fLog("INFO", "  " + aAchados[nI][__F_CODPSA] + " " + aAchados[nI][__F_DESCRI] + " | termo: " + aAchados[nI][__F_TERMO] +;
					" | " + aAchados[nI][__F_IAOBS])
			Next nI
		EndIf
	EndIf

	lSmtp := fSmtpConecta(@oServer)
	If lSmtp
		oServer:SMTPDisconnect()
	EndIf
	lOk := fChk("SMTP (" + __SMTP_HOST + ")", lSmtp, IIf(lSmtp, "conexao" + IIf(__SMTP_AUTH, " e autenticacao", "") + " OK", "")) .And. lOk

Return lOk

/*/{Protheus.doc} fChk
@type function
@return logical, lPassou (registra "[OK]" ou "[FALHA]" no log)
/*/
Static Function fChk(cItem, lPassou, cDetalhe)

	fLog(IIf(lPassou, "INFO", "ERROR"), IIf(lPassou, "[OK] ", "[FALHA] ") + cItem + IIf(Empty(cDetalhe), "", " - " + cDetalhe))

Return lPassou

/*/{Protheus.doc} fProcessa
Processamento principal do job.
@type function
@param aRes, array, resumo da execucao (preenchido por referencia; posicoes __P_*)
@param cData, character, B71_DATMOV (AAAAMMDD) informado manualmente; "" = hoje
/*/
Static Function fProcessa(aRes, cData)

	Local nUltimo  := 0
	Local nGravado := 0
	Local aMed     := {}
	Local aLista   := {}
	Local aB71     := {}
	Local nEmails  := 0
	Local oCrit    := Nil
	Local lIa      := .F.
	Local cModelo  := ""
	Local cErro    := ""
	Local nI       := 0

	Default cData := ""

	If !fValidaCfg()
		Return
	EndIf

	nUltimo := fLeWatermark()
	If nUltimo < 0
		Return
	EndIf
	aRes[__P_INICIO] := nUltimo
	aRes[__P_FINAL]  := nUltimo

	If !fConfigApi(@lIa, @cModelo, @oCrit, @cErro)
		fLog("ERROR", "GET " + __CFG_PATH + " (flag da IA e criterio): " + cErro + ". Encerrando sem avancar " + __PAR_WATER + ".")
		Return
	EndIf
	fLog("INFO", IIf(lIa, "IA habilitada (" + cModelo + "): procedimentos da guia + confirmacao nos anexos",;
		"IA desabilitada (IA_HABILITADA na API): alerta so pelos procedimentos da guia, anexos nao sao enviados"))

	aMed := fCarregaMed(oCrit)
	fLog("INFO", cValToChar(Len(aMed)) + " medicamento(s) de alto custo carregado(s) (" + fCritTxt(oCrit) + ", BR8_CODPAD " + fCodPadTxt() + ", termos da BA8 se houver)")
	If Len(aMed) == 0
		fLog("WARN", "Nenhum medicamento de alto custo na BR8/BA8; nada a comparar. Encerrando sem avancar " + __PAR_WATER + ".")
		Return
	EndIf

	// A lista so vai para a API (POST __LST_PATH) no primeiro anexo verificado: rodada sem anexo nao a envia
	aLista := {aMed, ""}

	fLog("INFO", "Watermark " + __PAR_WATER + " = " + cValToChar(nUltimo) +;
		"; buscando B71 com R_E_C_N_O_ > " + cValToChar(nUltimo) +;
		", CODDEP = " + fDepTxt() + ", DATMOV = " + fDataMov(cData))

	fAvisaAtrasadas(nUltimo, cData)

	aB71 := fConsulta(nUltimo, cData)
	aRes[__P_TOTAL] := Len(aB71)
	If Len(aB71) == 0
		fLog("INFO", "Nenhuma B71 nova.")
		Return
	EndIf

	nGravado := nUltimo
	For nI := 1 To Len(aB71)
		fLogB71(aB71[nI])
		If !fVerificaB71(aB71[nI], aMed, oCrit, @nEmails, aLista, lIa)
			fLog("WARN", "B71 " + cValToChar(aB71[nI][__I_RECNO]) + " nao concluida; ela e as seguintes" +;
				" serao retomadas na proxima execucao. " + __PAR_WATER + " permanece em " + cValToChar(nGravado) + ".")
			Exit
		EndIf
		nGravado := aB71[nI][__I_RECNO]
		fGravaWatermark(nGravado)
		aRes[__P_FEITAS]++
		aRes[__P_FINAL] := nGravado
	Next nI
	aRes[__P_EMAILS] := nEmails

	fLog("INFO", cValToChar(aRes[__P_FEITAS]) + " de " + cValToChar(Len(aB71)) + " B71 verificada(s), " +;
		cValToChar(nEmails) + " e-mail(s) enviado(s)")

Return

/*/{Protheus.doc} fVerificaB71
Pipeline completo de uma B71: procedimentos de alto custo lancados na guia; com a IA ligada, verificacao
dos anexos na API e mescla dos dois resultados; se houver algum item, envia o e-mail.
@type function
@param aItem, array, item devolvido por fConsulta()
@param aMed, array, medicamentos devolvidos por fCarregaMed()
@param oCrit, object, criterio da lista (fConfigApi), com o indice montado por fCarregaMed()
@param nEmails, numeric, contador de e-mails enviados (por referencia)
@param aLista, array, {aMed, cListaId} da execucao (fEnviaLista); usada so com a IA ligada
@param lIa, logical, IA ligada na API (fConfigApi)
@return logical, .T. se a B71 pode ser dada como verificada (avancar Z_NOTIENCA)
/*/
Static Function fVerificaB71(aItem, aMed, oCrit, nEmails, aLista, lIa)

	Local aProc    := {}
	Local aIa      := {}
	Local aAchados := {}
	Local cLista   := ""
	Local cIte     := ""
	Local lOk      := .T.
	Local nI       := 0

	If aItem[__I_STATUS] == __ST_CAMPO .Or. aItem[__I_STATUS] == __ST_CPOB53
		Return .F.
	EndIf

	If aItem[__I_STATUS] != __ST_OK .And. aItem[__I_STATUS] != __ST_SEMANEXO
		Return .T.
	EndIf

	aProc := fProcAltoCusto(aItem, aMed, oCrit, @lOk)
	If !lOk
		Return .F.
	EndIf

	If lIa .And. aItem[__I_STATUS] == __ST_OK
		If !fProcessaB71(aItem, aLista)
			Return .F.
		EndIf
		aIa := fBuscaMed(aItem, aMed)
	EndIf

	aAchados := fMescla(aProc, aIa, lIa, Len(aItem[__I_TEXTOS]) > 0)
	If Len(aAchados) == 0
		fLog("INFO", "  nenhum item de alto custo na guia" + IIf(lIa, " nem nos anexos", ""))
		Return .T.
	EndIf

	cIte := fCfgProc(aItem[__I_TIPO], aItem[__I_ALIMOV])[__C_ALIAS]
	For nI := 1 To Len(aAchados)
		cLista += IIf(nI > 1, ", ", "") + aAchados[nI][__F_CODPSA] + " (" + aAchados[nI][__F_ORIGEM] +;
			IIf(aAchados[nI][__F_ORIGEM] == __O_IA, "", " " + cIte) +;
			IIf(Empty(aAchados[nI][__F_OBJETO]), "", " em " + aAchados[nI][__F_OBJETO]) + ")"
	Next nI
	fLog("INFO", "  " + cValToChar(Len(aAchados)) + " item(ns) de alto custo: " + cLista)

	If !fEnviaEmail(aItem, aAchados, lIa, oCrit)
		Return .F.
	EndIf
	nEmails++

Return .T.

/*/{Protheus.doc} fMescla
Junta os procedimentos de alto custo da guia com os achados da IA nos anexos. Cada procedimento vira
uma linha; os achados da IA do mesmo codigo o confirmam (termos e anexos juntados na linha). Achados
da IA sem procedimento correspondente entram como __O_IA, com valor na guia __VLR_NAO.
@type function
@param aProc, array, fProcAltoCusto()
@param aIa, array, fBuscaMed() (vazio com a IA desligada)
@param lIa, logical, IA ligada
@param lAnexo, logical, algum anexo foi verificado pela IA
@return array, itens no formato __F_*
/*/
Static Function fMescla(aProc, aIa, lIa, lAnexo)

	Local aRet  := {}
	Local aLin  := {}
	Local cObs  := ""
	Local nP    := 0
	Local nI    := 0

	For nP := 1 To Len(aProc)
		aLin := aClone(aProc[nP])
		cObs := ""
		For nI := 1 To Len(aIa)
			If aIa[nI][__F_CODPSA] == aLin[__F_CODPSA]
				aLin[__F_TERMO]  += IIf(Empty(aLin[__F_TERMO]), "", " / ") + aIa[nI][__F_TERMO]
				aLin[__F_OBJETO] += IIf(Empty(aLin[__F_OBJETO]), "", " / ") + aIa[nI][__F_OBJETO]
				cObs += IIf(Empty(cObs), "", " / ") + aIa[nI][__F_IAOBS]
			EndIf
		Next nI
		Do Case
		Case !Empty(aLin[__F_OBJETO])
			aLin[__F_ORIGEM] := __O_PROCIA
			aLin[__F_IAOBS]  := "confirmado pela IA: " + cObs
		Case lIa .And. lAnexo
			aLin[__F_IAOBS] := "nao citado nos anexos"
		Case lIa
			aLin[__F_IAOBS] := "sem anexo para confirmar"
		EndCase
		aAdd(aRet, aLin)
	Next nP

	For nI := 1 To Len(aIa)
		If aScan(aProc, {|x| x[__F_CODPSA] == aIa[nI][__F_CODPSA]}) == 0
			aAdd(aRet, aIa[nI])
		EndIf
	Next nI

Return aRet

/*/{Protheus.doc} fBuscaMed
Monta os medicamentos achados pela IA (na API) em cada anexo da B71 e registra os avisos no log.
@type function
@return array, itens no formato __F_* com __F_ORIGEM = __O_IA e valor na guia __VLR_NAO (fMescla troca
	pelo procedimento quando o codigo esta na guia): no maximo uma ocorrencia por medicamento em cada anexo
/*/
Static Function fBuscaMed(aItem, aMed)

	Local aAchados := {}
	Local aTexto   := {}
	Local nT       := 0

	For nT := 1 To Len(aItem[__I_TEXTOS])
		aTexto := aItem[__I_TEXTOS][nT]
		aEval(fAchadosApi(aTexto[__T_ACHADOS], aMed, aTexto[__T_OBJETO]), {|x| aAdd(aAchados, x)})
		fLogAvisos(aTexto[__T_OBJETO], aTexto[__T_AVISOS])
	Next nT

Return aAchados

/*/{Protheus.doc} fAchadosApi
Converte os achados da API de um anexo para o formato de fBuscaMed, com descricao, CODPAD e valor
de tabela da BR8/BA8. Codigo fora da lista (nao deveria acontecer) so vai para o log.
@type function
@param aApi, array, achados de fLeAchados() ou Nil
@param aMed, array, medicamentos de fCarregaMed()
@param cObjeto, character, ACB_OBJETO do anexo
@return array, achados no formato de fBuscaMed
/*/
Static Function fAchadosApi(aApi, aMed, cObjeto)

	Local aRet := {}
	Local nM   := 0
	Local nI   := 0

	If ValType(aApi) != "A"
		Return aRet
	EndIf

	For nI := 1 To Len(aApi)
		nM := aScan(aMed, {|x| x[__M_CODPSA] == aApi[nI][__V_CODIGO]})
		If nM == 0
			fLog("WARN", "  " + cObjeto + ": codigo " + aApi[nI][__V_CODIGO] + " devolvido pela API fora da lista de medicamentos")
			Loop
		EndIf
		aAdd(aRet, {aApi[nI][__V_CODIGO], aMed[nM][__M_DESCRI], aApi[nI][__V_TERMO], cObjeto,;
			aMed[nM][__M_CODPAD], aMed[nM][__M_VLRTAB], __VLR_NAO, aApi[nI][__V_OBS], __O_IA, ""})
	Next nI

Return aRet

/*/{Protheus.doc} fLogAvisos
Registra os avisos da API de um anexo: IA com confianca baixa e texto maior que o limite da IA.
@type function
@param cObjeto, character, ACB_OBJETO do anexo
@param aAvisos, array, avisos de fLeAvisos() ou Nil
/*/
Static Function fLogAvisos(cObjeto, aAvisos)

	Local cCodigo := ""
	Local nI      := 0

	If ValType(aAvisos) != "A"
		Return
	EndIf

	For nI := 1 To Len(aAvisos)
		cCodigo := aAvisos[nI][__W_CODIGO]
		Do Case
		Case aAvisos[nI][__W_TIPO] == "confianca-baixa"
			fLog("INFO", "  [IA] " + cCodigo + " em " + cObjeto + " com confianca baixa: fora do alerta")
		Case aAvisos[nI][__W_TIPO] == "texto-cortado"
			fLog("WARN", "  [IA] " + cObjeto + ": " + aAvisos[nI][__W_OBS])
		Case aAvisos[nI][__W_TIPO] == "pre-busca-limite"
			fLog("WARN", "  [pre-busca] " + cObjeto + ": " + aAvisos[nI][__W_OBS])
		EndCase
	Next nI

Return

/*/{Protheus.doc} fLimpa
Troca pontuacao, quebras de linha e simbolos por espaco e junta espacos repetidos, para que
descricoes iguais a menos de pontuacao virem um termo so. Espera texto ja normalizado por fNormaliza().
@type function
/*/
Static Function fLimpa(cTexto)

	Local aTroca := {Chr(13), Chr(10), Chr(9), ".", ",", ";", ":", "!", "?", "(", ")", "[", "]", "{", "}",;
		"/", "\", "|", "-", "_", "+", "*", "=", "<", ">", '"', "'", "`", "^", "~", "@", "#", "$", "%", "&",;
		Chr(145), Chr(146), Chr(147), Chr(148), Chr(150), Chr(151), Chr(170), Chr(176), Chr(186), Chr(167)}
	Local cRet   := cTexto
	Local nI     := 0

	For nI := 1 To Len(aTroca)
		cRet := StrTran(cRet, aTroca[nI], " ")
	Next nI

	While "  " $ cRet
		cRet := StrTran(cRet, "  ", " ")
	EndDo

Return AllTrim(cRet)

/*/{Protheus.doc} fEnviaEmail
Envia o alerta da B71 para os destinatarios de __MAIL_TO pela conta __SMTP_USER (__SMTP_HOST).
@type function
@param lIa, logical, IA ligada (inclui as colunas dos anexos)
@param oCrit, object, criterio da lista (fConfigApi)
@return logical, .T. se o e-mail foi aceito pelo servidor SMTP
/*/
Static Function fEnviaEmail(aItem, aAchados, lIa, oCrit)
Return fEnviaMsg(fMailTo(), fAssunto(aItem, aAchados), fCorpoEmail(aItem, aAchados, lIa, oCrit))

/*/{Protheus.doc} fEnviaMsg
Envia uma mensagem HTML pela conta __SMTP_USER (__SMTP_HOST). Usada pelo alerta e pelo U_mailMEDALTC.
O corpo deve ser so ASCII (texto do banco passa por fHtml), entao o charset do servidor nao importa.
@type function
@param cPara, character, destinatarios separados por ";"
@param cAssunto, character, assunto
@param cCorpo, character, HTML
@return logical, .T. se o e-mail foi aceito pelo servidor SMTP
/*/
Static Function fEnviaMsg(cPara, cAssunto, cCorpo)

	Local oServer := Nil
	Local oMsg    := Nil
	Local nErro   := 0

	If !fSmtpConecta(@oServer)
		Return .F.
	EndIf

	oMsg := TMailMessage():New()
	oMsg:Clear()
	oMsg:cFrom    := __SMTP_FROM
	oMsg:cTo      := cPara
	oMsg:cSubject := cAssunto
	oMsg:cBody    := cCorpo
	oMsg:MsgBodyType("text/html")

	nErro := oMsg:Send(oServer)
	oServer:SMTPDisconnect()

	If nErro != 0
		fLog("ERROR", "  SMTP - falha no envio para " + cPara + ": " + oServer:GetErrorString(nErro))
		Return .F.
	EndIf

	fLog("INFO", "  e-mail enviado para " + cPara)

Return .T.

/*/{Protheus.doc} mailMEDALTC
Envia um e-mail de teste pela conta do alerta (__SMTP_*), sem consultar B71 nem gravar Z_NOTIENCA.
Confere o que o U_chkMEDALTC nao cobre: aceite do remetente e dos destinatarios pelo servidor e a
chegada na caixa (spam, acentos, tabela HTML).
Uso: U_mailMEDALTC() envia para __MAIL_TO; U_mailMEDALTC("a@oestesaude.com.br;b@...") para outros
@type function
@param cPara, character, opcional; destinatarios separados por ";" (vazio = __MAIL_TO)
@return logical, .T. se o servidor SMTP aceitou a mensagem
/*/
User Function mailMEDALTC(cPara)

	Local lAbriu  := .F.
	Local lOk     := .F.
	Local cHtml   := ""
	Local bErrOld := Nil
	Local oErro   := Nil

	Default cPara := ""

	If Select("SX2") <= 0
		RpcSetType(3)
		RpcSetEnv("01", "01", , , "PLS")
		lAbriu := .T.
	EndIf

	cPara := IIf(Empty(AllTrim(cPara)), fMailTo(), AllTrim(cPara))
	fLog("INFO", "=== Teste de e-mail " + __JOB_NAME + ": " + __SMTP_USER + " (" + __SMTP_HOST + ":" +;
		cValToChar(__SMTP_PORTA) + ") -> " + cPara + " ===")

	bErrOld := ErrorBlock({|e| Break(e)})
	BEGIN SEQUENCE
		If Empty(cPara)
			fLog("ERROR", "__MAIL_TO sem destinatario.")
		Else
			// Acentos vindos do banco passam por fHtml, como no alerta
			cHtml := '<html><body style="font-family:Arial,sans-serif;font-size:13px">' +;
				"<p>Teste de envio do job " + __JOB_NAME + " (ambiente " + fHtml(AllTrim(GetEnvServer())) + ", " +;
				DToC(Date()) + " " + Time() + ").</p>" +;
				'<table border="1" cellpadding="4" cellspacing="0" style="border-collapse:collapse">' +;
				"<tr><th>Campo</th><th>Valor</th></tr>" +;
				"<tr><td>Acentos (texto do banco)</td><td>" + fHtml("Benefici" + Chr(225) + "rio Jo" + Chr(227) + "o Concei" + Chr(231) + Chr(227) + "o") + "</td></tr>" +;
				"<tr><td>Destinat&aacute;rios</td><td>" + fHtml(cPara) + "</td></tr>" +;
				"</table>" +;
				'<p style="color:#888">Mensagem autom&aacute;tica - n&atilde;o responder.</p></body></html>'
			lOk := fEnviaMsg(cPara, "[Alto custo] Teste de envio - " + AllTrim(GetEnvServer()), cHtml)
		EndIf
	RECOVER USING oErro
		fLog("ERROR", "Teste de e-mail interrompido: " + IIf(ValType(oErro) == "O", oErro:Description, "erro desconhecido"))
	END SEQUENCE
	ErrorBlock(bErrOld)

	fLog(IIf(lOk, "INFO", "ERROR"), "=== Teste de e-mail " + IIf(lOk, "OK: conferir a caixa (e o spam) de " + cPara, "COM FALHA") + " ===")

	If lAbriu
		RpcClearEnv()
	EndIf

Return lOk

/*/{Protheus.doc} fSmtpConecta
Conecta (e autentica, se __SMTP_AUTH) no SMTP do alerta (__SMTP_HOST:__SMTP_PORTA).
@type function
@param oServer, object, (por referencia) TMailManager conectado; o chamador faz SMTPDisconnect()
@return logical, .T. se conectou
/*/
Static Function fSmtpConecta(oServer)

	Local nErro := 0

	oServer := TMailManager():New()
	oServer:SetUseSSL(__SMTP_SSL)
	oServer:SetUseTLS(__SMTP_TLS)
	oServer:Init("", __SMTP_HOST, __SMTP_USER, __SMTP_SENHA, 0, __SMTP_PORTA)
	oServer:SetSMTPTimeout(60)

	nErro := oServer:SMTPConnect()
	If nErro != 0
		fLog("ERROR", "  SMTP " + __SMTP_HOST + ":" + cValToChar(__SMTP_PORTA) + " - falha na conexao: " + oServer:GetErrorString(nErro))
		Return .F.
	EndIf

	If __SMTP_AUTH
		nErro := oServer:SmtpAuth(__SMTP_USER, __SMTP_SENHA)
		If nErro != 0
			fLog("ERROR", "  SMTP - falha na autenticacao: " + oServer:GetErrorString(nErro))
			oServer:SMTPDisconnect()
			Return .F.
		EndIf
	EndIf

Return .T.

/*/{Protheus.doc} fAssunto
@type function
@return character, "[Alto custo] Guia <guia> - <n> item(ns) de alto custo"
/*/
Static Function fAssunto(aItem, aAchados)

	Local aCodigos := {}
	Local nI       := 0

	For nI := 1 To Len(aAchados)
		If aScan(aCodigos, {|x| x == aAchados[nI][__F_CODPSA]}) == 0
			aAdd(aCodigos, aAchados[nI][__F_CODPSA])
		EndIf
	Next nI

Return "[Alto custo] Guia " + aItem[__I_NUMGUI] + " - " + cValToChar(Len(aCodigos)) + " item(ns) de alto custo"

/*/{Protheus.doc} fCorpoEmail
Monta o corpo HTML do alerta. Nao inclui trechos do texto dos anexos (dados de saude).
@type function
@param lIa, logical, IA ligada: inclui termo, anexo e observacao da IA
@param oCrit, object, criterio da lista (fConfigApi), descrito no rodape
@return character, HTML
/*/
Static Function fCorpoEmail(aItem, aAchados, lIa, oCrit)

	Local cHtml := ""
	Local nI    := 0

	cHtml += '<html><body style="font-family:Arial,sans-serif;font-size:13px">'
	cHtml += "<p>O job OSMEDALTC identificou item(ns) de alto custo na guia" + IIf(lIa, " ou em seus anexos", "") + ".</p>"

	cHtml += '<table border="1" cellpadding="4" cellspacing="0" style="border-collapse:collapse">'
	cHtml += "<tr><td><b>Benefici&aacute;rio</b></td><td>" + fHtml(IIf(Empty(aItem[__I_BENEF]), __VLR_ND, aItem[__I_BENEF])) + "</td></tr>"
	cHtml += "<tr><td><b>N&uacute;mero da guia</b></td><td>" + fHtml(aItem[__I_NUMGUI]) + "</td></tr>"
	cHtml += "<tr><td><b>Tipo da guia</b></td><td>" + fHtml(fTipoExtenso(aItem[__I_TIPO])) +;
		' <span style="font-size:11px;color:#555">(B53_TIPO ' + fHtml(aItem[__I_TIPO]) +;
		", itens " + fCfgProc(aItem[__I_TIPO], aItem[__I_ALIMOV])[__C_ALIAS] + ")</span></td></tr>"
	cHtml += "<tr><td><b>Data da solicita&ccedil;&atilde;o</b></td><td>" +;
		IIf(Empty(aItem[__I_DATENT]), __VLR_ND, DToC(SToD(aItem[__I_DATENT]))) + "</td></tr>"
	cHtml += "<tr><td><b>Origem</b></td><td>" + fHtml(aItem[__I_ALIMOV]) + " (recno " + fHtml(aItem[__I_RECMOV]) + ")</td></tr>"
	cHtml += "<tr><td><b>Movimenta&ccedil;&atilde;o B71</b></td><td>" + cValToChar(aItem[__I_RECNO]) + " - " + DToC(SToD(aItem[__I_DATMOV])) + "</td></tr>"
	cHtml += "</table>"

	cHtml += "<p><b>Itens de alto custo:</b></p>"
	cHtml += '<table border="1" cellpadding="4" cellspacing="0" style="border-collapse:collapse">'
	cHtml += "<tr><th>C&oacute;digo</th><th>Descri&ccedil;&atilde;o (BR8)</th><th>Detec&ccedil;&atilde;o</th><th>Qtd</th>" +;
		"<th>Valor de tabela</th><th>Valor na guia</th>" +;
		IIf(lIa, "<th>Termo encontrado</th><th>Anexo</th><th>Observa&ccedil;&atilde;o IA</th>", "") + "</tr>"
	For nI := 1 To Len(aAchados)
		cHtml += "<tr>"
		cHtml += "<td>" + fHtml(aAchados[nI][__F_CODPSA]) + "</td>"
		cHtml += "<td>" + fHtml(aAchados[nI][__F_DESCRI]) + "</td>"
		cHtml += "<td>" + fHtml(aAchados[nI][__F_ORIGEM]) + "</td>"
		cHtml += '<td style="text-align:right">' + fHtml(aAchados[nI][__F_QTD]) + "</td>"
		cHtml += "<td>" + fVlrTabHtml(aAchados[nI][__F_VLRTAB]) + "</td>"
		cHtml += '<td style="text-align:right">' + fHtml(aAchados[nI][__F_VLRGUI]) + "</td>"
		If lIa
			cHtml += "<td>" + fHtml(aAchados[nI][__F_TERMO]) + "</td>"
			cHtml += "<td>" + fHtml(aAchados[nI][__F_OBJETO]) + "</td>"
			cHtml += "<td>" + fHtml(aAchados[nI][__F_IAOBS]) + "</td>"
		EndIf
		cHtml += "</tr>"
	Next nI
	cHtml += "</table>"
	cHtml += '<p style="font-size:11px;color:#555">Procedimento: item lan&ccedil;ado na guia com ' + fHtml(fCritTxt(oCrit)) + ' (tabela ' + fCodPadTxt() + ').' +;
		" Qtd e valor na guia: soma de quantidade solicitada x valor unit&aacute;rio dos itens da guia com o mesmo c&oacute;digo." +;
		" Valor de tabela: BD4 na vig&ecirc;ncia mais recente at&eacute; " + DToC(Date()) + "," +;
		" uma linha por tabela de pre&ccedil;o (" + __TAB_ALIAS + ") e unidade." +;
		" S&oacute; tabelas vigentes (BD4_VIGFIM vazio ou a partir de hoje). &quot;" + __VLR_ND +;
		"&quot;: valor n&atilde;o dispon&iacute;vel no dicion&aacute;rio.</p>"
	If lIa
		cHtml += '<p style="font-size:11px;color:#555">Anexo (IA): medicamento citado no anexo e n&atilde;o lan&ccedil;ado na guia' +;
			" (&quot;" + __VLR_NAO + "&quot; no valor na guia). A IA (Claude) l&ecirc; o texto do anexo e reconhece nome do cadastro," +;
			" nome comercial, princ&iacute;pio ativo, abrevia&ccedil;&atilde;o ou erro de leitura. Confira o anexo antes de agir.</p>"
	EndIf

	cHtml += '<p style="color:#888">Mensagem autom&aacute;tica - n&atilde;o responder.</p>'
	cHtml += "</body></html>"

Return cHtml

/*/{Protheus.doc} fHtml
Escapa o texto para o corpo do e-mail. Caracteres acima de 127 viram entidade numerica (&#NNN;) para
o HTML sair so em ASCII e os acentos do banco (ISO-8859-1/CP1252) aparecerem certos em qualquer
cliente, sem depender do charset declarado pelo TMailMessage. Controles C1 (128-159) viram espaco.
@type function
@return character, texto com &, <, > e nao-ASCII escapados para HTML
/*/
Static Function fHtml(cTexto)

	Local cIn  := StrTran(StrTran(StrTran(cValToChar(cTexto), "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
	Local cRet := ""
	Local nAsc := 0
	Local nI   := 0

	For nI := 1 To Len(cIn)
		nAsc := Asc(SubStr(cIn, nI, 1))
		Do Case
		Case nAsc < 128
			cRet += SubStr(cIn, nI, 1)
		Case nAsc < 160
			cRet += " "
		Otherwise
			cRet += "&#" + cValToChar(nAsc) + ";"
		EndCase
	Next nI

Return cRet

/*/{Protheus.doc} fVlrTabHtml
Celula "Valor de tabela" do e-mail: mini-tabela com uma linha por tabela de preco + unidade.
@type function
@param xVlr, array|character, __F_VLRTAB: linhas __L_* (fCarregaVlrTab) ou texto (__VLR_ND, sem valor)
@return character, HTML
/*/
Static Function fVlrTabHtml(xVlr)

	Local cHtml := ""
	Local aLin  := {}
	Local nI    := 0

	If ValType(xVlr) != "A"
		Return fHtml(xVlr)
	EndIf

	cHtml := '<table border="1" cellpadding="2" cellspacing="0" style="border-collapse:collapse;font-size:11px">' +;
		"<tr><th>Valor</th><th>Tabela</th><th>Descri&ccedil;&atilde;o</th><th>Tp.Pad</th><th>Unid.</th><th>Vig&ecirc;ncia</th></tr>"
	For nI := 1 To Len(xVlr)
		aLin := xVlr[nI]
		cHtml += "<tr>" +;
			'<td style="text-align:right;white-space:nowrap">' + fHtml(fMoeda(aLin[__L_VALOR])) + "</td>" +;
			"<td>" + fHtml(aLin[__L_CODTAB]) + "</td>" +;
			"<td>" + fHtml(aLin[__L_DESCRI]) + "</td>" +;
			"<td>" + fHtml(aLin[__L_CODPAD]) + "</td>" +;
			"<td>" + fHtml(aLin[__L_UNID]) + "</td>" +;
			'<td style="white-space:nowrap">' + StrTran(fHtml(fVigTxt(aLin[__L_VIGFIM])), " ate ", " at&eacute; ") + "</td></tr>"
	Next nI
	cHtml += "</table>"

Return cHtml

/*/{Protheus.doc} fVlrTabTxt
@type function
@param xVlr, array|character, __M_VLRTAB / __F_VLRTAB (linhas __L_* ou texto)
@return character, valor de tabela em uma linha, para o log: "R$ 700,51 (0001020 DESCRICAO VMD) / ..."
/*/
Static Function fVlrTabTxt(xVlr)

	Local cRet := ""
	Local aLin := {}
	Local nI   := 0

	If ValType(xVlr) != "A"
		Return cValToChar(xVlr)
	EndIf

	For nI := 1 To Len(xVlr)
		aLin := xVlr[nI]
		cRet += IIf(nI > 1, " / ", "") + fMoeda(aLin[__L_VALOR]) + " (" + aLin[__L_CODTAB] +;
			IIf(Empty(aLin[__L_DESCRI]), "", " " + aLin[__L_DESCRI]) + " " + aLin[__L_UNID] + ")"
	Next nI

Return cRet

/*/{Protheus.doc} fVigEncerr
@type function
@param cVigFim, character, BD4_VIGFIM (AAAAMMDD) ou vazio
@return logical, .T. se a vigencia terminou antes de hoje (mesma data de hoje de fSqlBd4Vig)
/*/
Static Function fVigEncerr(cVigFim)
Return !Empty(cVigFim) .And. cVigFim < DToS(Date())

/*/{Protheus.doc} fVigTxt
@type function
@param cVigFim, character, BD4_VIGFIM (AAAAMMDD) ou vazio
@return character, coluna Vigencia do e-mail: "Vigente (sem fim)" ou "Vigente ate DD/MM/AAAA"
	(as encerradas ja ficam fora em fCarregaVlrTab)
/*/
Static Function fVigTxt(cVigFim)

	If Empty(cVigFim)
		Return "Vigente (sem fim)"
	EndIf

Return "Vigente ate " + DToC(SToD(cVigFim))

/*/{Protheus.doc} fGravaWatermark
Grava em Z_NOTIENCA o R_E_C_N_O_ da B71 verificada. So e chamada em ordem crescente de recno.
@type function
/*/
Static Function fGravaWatermark(nRecno)

	PutMV(__PAR_WATER, cValToChar(nRecno))
	fLog("INFO", "  " + __PAR_WATER + " = " + cValToChar(nRecno))

Return

/*/{Protheus.doc} fProcessaB71
Verifica cada anexo da B71 na API e guarda o resultado em aItem[__I_TEXTOS].
Anexo com erro definitivo (nao existe no SFTP, extensao nao suportada) e descartado.
@type function
@param aLista, array, {aMed, cListaId} da execucao (fEnviaLista)
@return logical, .F. se houve falha temporaria (API/SFTP/IA fora, timeout, token); a B71
	nao deve ser dada como verificada
/*/
Static Function fProcessaB71(aItem, aLista)

	Local aRes    := {}
	Local cObjeto := ""
	Local nInicio := 0
	Local nI      := 0

	If aItem[__I_STATUS] != __ST_OK
		Return .T.
	EndIf

	If fPosOrigem(aItem[__I_ALIMOV], Val(aItem[__I_RECMOV]))
		aItem[__I_PESSOAS] := fPessoas(aItem[__I_ALIMOV])
		fLog("INFO", "  mascaramento para a IA: " + cValToChar(Len(aItem[__I_PESSOAS])) + " nome(s)/matricula da guia")
	EndIf

	For nI := 1 To Len(aItem[__I_ANEXOS])
		cObjeto := aItem[__I_ANEXOS][nI][__A_OBJETO]
		nInicio := Seconds()
		aRes    := fExtraiTexto(cObjeto, aLista, aItem[__I_PESSOAS])

		Do Case
		Case aRes[__R_OK]
			aAdd(aItem[__I_TEXTOS], {cObjeto, aRes[__R_METODO], aRes[__R_ACHADOS], aRes[__R_AVISOS]})
			fLog("INFO", "  " + cObjeto + ": texto via " + aRes[__R_METODO] + ", " + cValToChar(aRes[__R_CANDID]) +;
				" candidato(s) da pre-busca, " + IIf(aRes[__R_CANDID] > 0, "IA " + aRes[__R_MODELO], "IA nao chamada") + " em " +;
				cValToChar(Round(Seconds() - nInicio, 1)) + "s, " + cValToChar(Len(aRes[__R_ACHADOS])) + " achado(s)")
		Case aRes[__R_DEFINIT]
			fLog("WARN", "  " + cObjeto + ": descartado (" + aRes[__R_ERRO] + ")")
		Otherwise
			fLog("ERROR", "  " + cObjeto + ": " + aRes[__R_ERRO])
			Return .F.
		EndCase
	Next nI

Return .T.

/*/{Protheus.doc} fExtraiTexto
Verifica um anexo na API (fPostVerif). Envia a lista de medicamentos antes, se ainda nao foi enviada
nesta execucao, e a reenvia uma vez quando a API responde __LST_DESC (API reiniciada).
@type function
@param cArquivo, character, ACB_OBJETO (so o nome, sem pasta)
@param aLista, array, {aMed, cListaId}; cListaId e preenchido por fEnviaLista
@param aMascarar, array, opcional; nomes e matricula da guia (fPessoas) que a API mascara antes do Claude
@return array, ver fPostVerif
/*/
Static Function fExtraiTexto(cArquivo, aLista, aMascarar)

	Local aRet  := {}
	Local cErro := ""

	If Empty(aLista[__LS_ID]) .And. !fEnviaLista(aLista, @cErro)
		aRet := {.F., "", "", .F., {}, {}, "", 0}
		aRet[__R_ERRO] := "POST " + __LST_PATH + ": " + cErro
		Return aRet
	EndIf

	aRet := fPostVerif(cArquivo, aLista[__LS_ID], aMascarar)
	If !aRet[__R_OK] .And. __LST_DESC $ aRet[__R_ERRO]
		fLog("WARN", "  API sem a lista de medicamentos (reiniciada?): reenviando")
		If !fEnviaLista(aLista, @cErro)
			aRet[__R_ERRO] := "reenvio da lista (POST " + __LST_PATH + "): " + cErro
			Return aRet
		EndIf
		aRet := fPostVerif(cArquivo, aLista[__LS_ID], aMascarar)
	EndIf

Return aRet

/*/{Protheus.doc} fEnviaLista
Envia a lista completa de medicamentos a API (POST __LST_PATH, {medicamentos: fMedApi()}) e guarda o
listaId devolvido. A API monta o indice da pre-busca e guarda a lista em memoria; a mesma lista devolve
o mesmo listaId.
@type function
@param aLista, array, {aMed, cListaId}; recebe o cListaId
@param cErro, character, (por referencia) motivo da falha
@return logical, .T. se a API aceitou a lista
/*/
Static Function fEnviaLista(aLista, cErro)

	Local oRest   := Nil
	Local oBody   := JsonObject():New()
	Local oResp   := JsonObject():New()
	Local aHeader := {}
	Local cHost   := ""
	Local cPath   := ""
	Local cResp   := ""
	Local nInicio := Seconds()

	cErro := ""
	aLista[__LS_ID] := ""

	fSplitUrl(fApiBase() + __LST_PATH, @cHost, @cPath)
	oBody["medicamentos"] := fMedApi(aLista[__LS_MEDS])

	aAdd(aHeader, "Content-Type: application/json")
	aAdd(aHeader, "Authorization: Bearer " + AllTrim(__API_TOKEN))

	oRest := FWRest():New(cHost)
	oRest:SetPath(cPath)
	oRest:SetPostParams(oBody:ToJson())
	oRest:SetTimeOut(__API_TIMEOUT)
	oRest:Post(aHeader)

	cResp := oRest:GetResult()
	Do Case
	Case Empty(cResp)
		cErro := "sem resposta da API (" + AllTrim(cValToChar(oRest:GetLastError())) + ")"
	Case ValType(oResp:FromJson(cResp)) == "C"
		cErro := "resposta invalida da API: " + Left(cResp, 200)
	Case ValType(oResp["listaId"]) == "C" .And. !Empty(oResp["listaId"])
		aLista[__LS_ID] := oResp["listaId"]
	Case "Cannot POST" $ cResp
		cErro := "API sem o " + __LST_PATH + ": atualizar a API"
	Case ValType(oResp["erro"]) == "C"
		cErro := fDecUtf8(oResp["erro"])
	Case ValType(oResp["message"]) == "C"
		cErro := fDecUtf8(oResp["message"])
	Otherwise
		cErro := "resposta sem listaId: " + Left(cResp, 200)
	EndCase

	If !Empty(cErro)
		Return .F.
	EndIf

	fLog("INFO", "Lista de medicamentos enviada a API: " + cValToChar(oResp["itens"]) + " item(ns), " +;
		cValToChar(oResp["palavras"]) + " palavra(s)-chave da pre-busca em " + cValToChar(Round(Seconds() - nInicio, 1)) + "s")
	If ValType(oResp["semPalavra"]) == "N" .And. oResp["semPalavra"] > 0
		fLog("WARN", "  " + cValToChar(oResp["semPalavra"]) + " medicamento(s) sem palavra-chave (descricao so com unidade/forma):" +;
			" a pre-busca nao os acha nos anexos, ficam so pelos procedimentos da guia")
	EndIf

Return .T.

/*/{Protheus.doc} fPostVerif
Pede a API a verificacao de um anexo: POST em __API_URL com {arquivo: ACB_OBJETO, ambiente: GetEnvServer(),
listaId, mascarar}. A API baixa o arquivo do SFTP do ambiente (prod ou dev), extrai o texto, faz a
pre-busca da lista no texto e pede ao Claude os candidatos citados. O texto nao volta para o Protheus.
Devolve {ok, metodo, modelo, candidatos, achados, avisos} ou {ok:false, erro} (inclusive "IA indisponivel: ...").
@type function
@param cArquivo, character, ACB_OBJETO (so o nome, sem pasta)
@param cListaId, character, listaId devolvido por fEnviaLista
@param aMascarar, array, opcional; nomes e matricula da guia (fPessoas) que a API mascara antes do Claude
@return array, {lOk, cMetodo, cErro, lDefinitivo, aAchados, aAvisos, cModelo, nCandidatos}. lDefinitivo indica
	erro que nao muda numa nova tentativa (arquivo inexistente, extensao/nome invalidos); aAchados
	(fLeAchados) e aAvisos (fLeAvisos)
/*/
Static Function fPostVerif(cArquivo, cListaId, aMascarar)

	Local aRet    := {.F., "", "", .F., {}, {}, "", 0}
	Local oRest   := Nil
	Local oBody   := JsonObject():New()
	Local oResp   := JsonObject():New()
	Local aHeader := {}
	Local aPessoa := {}
	Local cHost   := ""
	Local cPath   := ""
	Local cResp   := ""
	Local cErro   := ""
	Local xErro   := Nil

	Default aMascarar := {}

	fSplitUrl(__API_URL, @cHost, @cPath)

	oBody["arquivo"]  := EncodeUTF8(cArquivo)
	oBody["ambiente"] := AllTrim(GetEnvServer())
	oBody["listaId"]  := cListaId
	If Len(aMascarar) > 0
		aEval(aMascarar, {|x| aAdd(aPessoa, EncodeUTF8(x))})
		oBody["mascarar"] := aPessoa
	EndIf

	aAdd(aHeader, "Content-Type: application/json")
	aAdd(aHeader, "Authorization: Bearer " + AllTrim(__API_TOKEN))

	oRest := FWRest():New(cHost)
	oRest:SetPath(cPath)
	oRest:SetPostParams(oBody:ToJson())
	oRest:SetTimeOut(__API_TIMEOUT)
	oRest:Post(aHeader)

	cResp := oRest:GetResult()
	If Empty(cResp)
		aRet[__R_ERRO] := "sem resposta da API (" + AllTrim(cValToChar(oRest:GetLastError())) + ")"
		Return aRet
	EndIf

	If ValType(oResp:FromJson(cResp)) == "C"
		aRet[__R_ERRO] := "resposta invalida da API: " + Left(cResp, 200)
		Return aRet
	EndIf

	If ValType(oResp["ok"]) == "L" .And. oResp["ok"]
		aRet[__R_OK]      := .T.
		aRet[__R_METODO]  := cValToChar(oResp["metodo"])
		aRet[__R_MODELO]  := cValToChar(oResp["modelo"])
		aRet[__R_CANDID]  := IIf(ValType(oResp["candidatos"]) == "N", oResp["candidatos"], 0)
		aRet[__R_ACHADOS] := fLeAchados(oResp["achados"])
		aRet[__R_AVISOS]  := fLeAvisos(oResp["avisos"])
		Return aRet
	EndIf

	cErro := IIf(ValType(oResp["erro"]) == "C", oResp["erro"], Left(cResp, 200))
	xErro := DecodeUTF8(cErro)
	aRet[__R_ERRO]    := IIf(ValType(xErro) == "C", xErro, cErro)
	aRet[__R_DEFINIT] := "encontrado no SFTP" $ cErro .Or.;
		"suportada" $ cErro .Or.;
		"nome de arquivo inv" $ cErro

Return aRet

/*/{Protheus.doc} fSplitUrl
Separa "http://host:porta/caminho" em host ("http://host:porta") e caminho ("/caminho"),
como o FWRest espera.
@type function
/*/
Static Function fSplitUrl(cUrl, cHost, cPath)

	Local nIni   := At("//", cUrl)
	Local nBarra := At("/", SubStr(cUrl, nIni + 2))

	If nBarra == 0
		cHost := cUrl
		cPath := "/"
	Else
		cHost := Left(cUrl, nIni + nBarra)
		cPath := SubStr(cUrl, nIni + nBarra + 1)
	EndIf

Return

/*/{Protheus.doc} fLeAchados
Converte o campo "achados" da resposta da API: [{codigo, termo, origem: ia, observacao}].
@type function
@param aLista, array, oResp["achados"] ou Nil
@return array, { {cCodigo, cTermo, cObs}, ... }
/*/
Static Function fLeAchados(aLista)

	Local aRet := {}
	Local nI   := 0

	If ValType(aLista) != "A"
		Return aRet
	EndIf

	For nI := 1 To Len(aLista)
		If ValType(aLista[nI]) == "J" .And. ValType(aLista[nI]["codigo"]) == "C"
			aAdd(aRet, {AllTrim(aLista[nI]["codigo"]), fDecUtf8(aLista[nI]["termo"]), fDecUtf8(aLista[nI]["observacao"])})
		EndIf
	Next nI

Return aRet

/*/{Protheus.doc} fLeAvisos
Converte o campo "avisos" da resposta da API: [{tipo: confianca-baixa|texto-cortado, codigo, observacao}].
@type function
@param aLista, array, oResp["avisos"] ou Nil
@return array, { {cTipo, cCodigo, cObs}, ... }
/*/
Static Function fLeAvisos(aLista)

	Local aRet := {}
	Local nI   := 0

	If ValType(aLista) != "A"
		Return aRet
	EndIf

	For nI := 1 To Len(aLista)
		If ValType(aLista[nI]) == "J" .And. ValType(aLista[nI]["codigo"]) == "C"
			aAdd(aRet, {AllTrim(cValToChar(aLista[nI]["tipo"])), AllTrim(aLista[nI]["codigo"]), fDecUtf8(aLista[nI]["observacao"])})
		EndIf
	Next nI

Return aRet

/*/{Protheus.doc} fMedApi
Monta a lista de medicamentos enviada a API no POST __LST_PATH (fEnviaLista), base da pre-busca nos anexos.
@type function
@param aMed, array, medicamentos de fCarregaMed()
@return array, { JsonObject {codigo, descricao, termos[]}, ... }; termos ja normalizados (fAddTermo)
/*/
Static Function fMedApi(aMed)

	Local aLista  := {}
	Local aTermos := {}
	Local oMed    := Nil
	Local nI      := 0
	Local nK      := 0

	For nI := 1 To Len(aMed)
		aTermos := {}
		For nK := 1 To Len(aMed[nI][__M_TERMOS])
			aAdd(aTermos, EncodeUTF8(aMed[nI][__M_TERMOS][nK]))
		Next nK
		oMed := JsonObject():New()
		oMed["codigo"]    := EncodeUTF8(aMed[nI][__M_CODPSA])
		oMed["descricao"] := EncodeUTF8(aMed[nI][__M_DESCRI])
		oMed["termos"]    := aTermos
		aAdd(aLista, oMed)
	Next nI

Return aLista

/*/{Protheus.doc} fDecUtf8
@type function
@return character, texto UTF-8 da API convertido; o original se a conversao falhar
/*/
Static Function fDecUtf8(xTexto)

	Local cTexto := IIf(ValType(xTexto) == "C", xTexto, "")
	Local xDec   := DecodeUTF8(cTexto)

Return IIf(ValType(xDec) == "C", xDec, cTexto)

/*/{Protheus.doc} fCarregaMed
Carrega os medicamentos de alto custo: BR8 LEFT JOIN BA8, BR8_CODPAD em __CODPAD_BR8 e o filtro do
criterio (fSqlFiltroBr8): BR8_ALTCUS = '1' ou valor de tabela BD4 vigente > valor minimo.
Itens so na BR8, sem BA8, entram so com o termo da BR8_DESCRI (e ficam sem valor de tabela); no criterio
VALOR eles nao entram (sem BA8 nao ha BD4).
Monta tambem oCrit["idx"]: CODPAD + "|" + CODPSA -> posicao em aMed, consultado por fProcAltoCusto() sem
nova query nem aScan por item da guia.
@type function
@param oCrit, object, criterio da lista (fConfigApi); recebe oCrit["idx"]
@return array, { {cCodPsa, cDescri, aTermos, cCodPad, cVlrTab}, ... }. aTermos tem as descricoes
	normalizadas (BR8_DESCRI, BA8_DESCRI, BA8_DPRINC), sem repeticao. cVlrTab vem de fCarregaVlrTab().
/*/
Static Function fCarregaMed(oCrit)

	Local aMed    := {}
	Local oIdx    := JsonObject():New()
	Local cFiltro := ""
	Local cFalta  := ""
	Local cQuery  := ""
	Local cAlias  := ""
	Local cCod    := ""
	Local oErro   := Nil
	Local nPos    := 0

	oCrit["idx"] := oIdx

	If oCrit["criterio"] == __CRIT_VLR .And. !fCamposValorOk(@cFalta)
		fLog("ERROR", "Criterio " + __CRIT_VLR + " indisponivel: " + cFalta + " nao existe no dicionario")
		Return aMed
	EndIf
	cFiltro := fSqlFiltroBr8(oCrit)

	cQuery := "SELECT DISTINCT BR8.BR8_CODPAD, BR8.BR8_CODPSA, BR8.BR8_DESCRI," +;
		" COALESCE(BA8.BA8_DESCRI, ' ') AS BA8DESC, COALESCE(BA8.BA8_DPRINC, ' ') AS BA8DPRINC" +;
		" FROM " + RetSqlName("BR8") + " BR8" +;
		" LEFT JOIN " + RetSqlName("BA8") + " BA8" +;
		" ON BA8.BA8_FILIAL = '" + xFilial("BA8") + "'" +;
		" AND BA8.BA8_CDPADP = BR8.BR8_CODPAD" +;
		" AND BA8.BA8_CODPRO = BR8.BR8_CODPSA" +;
		" AND BA8.D_E_L_E_T_ = ' '" +;
		" WHERE BR8.BR8_FILIAL = '" + xFilial("BR8") + "'" +;
		cFiltro +;
		" AND BR8.BR8_CODPAD IN " + fSqlIn(__CODPAD_BR8) +;
		" AND BR8.D_E_L_E_T_ = ' '" +;
		" ORDER BY BR8.BR8_CODPSA"

	cAlias := MPSysOpenQuery(ChangeQuery(cQuery))

	While !(cAlias)->(Eof())
		cCod := AllTrim((cAlias)->BR8_CODPSA)
		nPos := Len(aMed)
		If nPos == 0 .Or. aMed[nPos][__M_CODPSA] != cCod
			aAdd(aMed, {cCod, AllTrim((cAlias)->BR8_DESCRI), {}, AllTrim((cAlias)->BR8_CODPAD), __VLR_ND})
			nPos := Len(aMed)
		EndIf
		// Mesmo CODPSA em outro CODPAD aponta para o mesmo item da lista
		oIdx[AllTrim((cAlias)->BR8_CODPAD) + "|" + cCod] := nPos
		fAddTermo(aMed[nPos][__M_TERMOS], (cAlias)->BR8_DESCRI)
		fAddTermo(aMed[nPos][__M_TERMOS], (cAlias)->BA8DESC)
		fAddTermo(aMed[nPos][__M_TERMOS], (cAlias)->BA8DPRINC)
		(cAlias)->(DbSkip())
	EndDo

	(cAlias)->(DbCloseArea())

	If Len(aMed) > 0
		BEGIN SEQUENCE
			fCarregaVlrTab(aMed, cFiltro)
		RECOVER USING oErro
			fLog("WARN", "Valor de tabela nao apurado: " + IIf(ValType(oErro) == "O", oErro:Description, "erro desconhecido"))
			aEval(aMed, {|x| x[__M_VLRTAB] := IIf(Empty(x[__M_VLRTAB]), __VLR_ND, x[__M_VLRTAB])})
		END SEQUENCE
	EndIf

Return aMed

/*/{Protheus.doc} fCarregaVlrTab
Preenche o valor de tabela de cada medicamento: BA8 (BA8_CODTAB) -> BD4 na vigencia mais recente,
isto e, o maior BD4_VIGINI <= hoje para cada tabela + unidade (BD4_CODIGO); vigencias futuras ficam de
fora. Linhas com BD4_VIGFIM antes de hoje (encerradas) nao entram no valor de tabela.
Um medicamento pode ter mais de uma tabela/unidade: uma linha por tabela + unidade, com a descricao e o
Tp.Pad.Saude do cadastro de tabelas (__TAB_ALIAS), mostradas no e-mail em uma mini-tabela (fVlrTabHtml).
Sem os campos do valor no dicionario, o valor fica __VLR_ND e o job segue; sem os do cadastro de tabelas,
as linhas saem so com o codigo.
@type function
@param aMed, array, medicamentos de fCarregaMed() (alterado por referencia): __M_VLRTAB recebe
	{ {nValor, cCodTab, cDescri, cCodPad, cUnid, cVigFim}, ... } (posicoes __L_*) ou "sem valor em tabela vigente"
@param cFiltro, character, filtro do criterio na BR8 (fSqlFiltroBr8), o mesmo de fCarregaMed()
/*/
Static Function fCarregaVlrTab(aMed, cFiltro)

	Local aTab    := __TAB_CPOS
	Local cFalta  := ""
	Local cQuery  := ""
	Local cAlias  := ""
	Local cTabSel := " ' ' AS TABDESC, ' ' AS TABPAD"
	Local cTabJoi := ""
	Local cVigSel := ", ' ' AS VIGFIM"
	Local xVigFim := Nil
	Local cVigFim := ""
	Local oPos    := JsonObject():New()
	Local nPos    := 0
	Local nI      := 0

	If !fCamposValorOk(@cFalta)
		fLog("WARN", "Valor de tabela indisponivel: " + cFalta + " nao existe no dicionario. E-mail sai com '" + __VLR_ND + "'.")
		Return
	EndIf

	If fCamposOk(__TAB_ALIAS, aTab, @cFalta)
		cTabSel := " COALESCE(TAB." + aTab[3] + ", ' ') AS TABDESC, COALESCE(TAB." + aTab[4] + ", ' ') AS TABPAD"
		cTabJoi := " LEFT JOIN " + RetSqlName(__TAB_ALIAS) + " TAB" +;
			" ON TAB." + __TAB_ALIAS + "_FILIAL = '" + xFilial(__TAB_ALIAS) + "'" +;
			" AND TAB." + aTab[1] + " + TAB." + aTab[2] + " = BD4.BD4_CODTAB" +;
			" AND TAB.D_E_L_E_T_ = ' '"
	Else
		fLog("WARN", "Descricao das tabelas de preco indisponivel: " + cFalta + " nao existe no dicionario. E-mail sai so com o codigo.")
	EndIf

	// Coluna Vigencia do e-mail e filtro das encerradas (fVigEncerr); a escolha da linha (fSqlBd4Vig) e o criterio nao usam o BD4_VIGFIM
	If fCamposOk("BD4", {"BD4_VIGFIM"}, @cFalta)
		cVigSel := ", BD4.BD4_VIGFIM AS VIGFIM"
	EndIf

	// CODPSA -> posicao em aMed: no criterio VALOR a lista pode ter milhares de itens
	For nI := 1 To Len(aMed)
		aMed[nI][__M_VLRTAB] := {}
		oPos[aMed[nI][__M_CODPSA]] := nI
	Next nI

	cQuery := "SELECT DISTINCT BR8.BR8_CODPSA, BD4.BD4_CODTAB, BD4.BD4_CODIGO, BD4.BD4_VALREF," + cTabSel + cVigSel +;
		" FROM " + RetSqlName("BR8") + " BR8" +;
		" INNER JOIN " + RetSqlName("BA8") + " BA8" +;
		" ON BA8.BA8_FILIAL = '" + xFilial("BA8") + "'" +;
		" AND BA8.BA8_CDPADP = BR8.BR8_CODPAD" +;
		" AND BA8.BA8_CODPRO = BR8.BR8_CODPSA" +;
		" AND BA8.D_E_L_E_T_ = ' '" +;
		" INNER JOIN " + RetSqlName("BD4") + " BD4" +;
		" ON BD4.BD4_FILIAL = '" + xFilial("BD4") + "'" +;
		" AND BD4.BD4_CODTAB = BA8.BA8_CODTAB" +;
		" AND BD4.BD4_CDPADP = BA8.BA8_CDPADP" +;
		" AND BD4.BD4_CODPRO = BA8.BA8_CODPRO" +;
		" AND BD4.BD4_VALREF > 0" +;
		fSqlBd4Vig("BD4") +;
		cTabJoi +;
		" WHERE BR8.BR8_FILIAL = '" + xFilial("BR8") + "'" +;
		cFiltro +;
		" AND BR8.BR8_CODPAD IN " + fSqlIn(__CODPAD_BR8) +;
		" AND BR8.D_E_L_E_T_ = ' '" +;
		" ORDER BY BR8.BR8_CODPSA, BD4.BD4_CODTAB, BD4.BD4_CODIGO"

	cAlias := MPSysOpenQuery(ChangeQuery(cQuery))

	While !(cAlias)->(Eof())
		nPos := oPos[AllTrim((cAlias)->BR8_CODPSA)]
		If ValType(nPos) == "N"
			xVigFim := (cAlias)->VIGFIM
			cVigFim := IIf(ValType(xVigFim) == "D", DToS(xVigFim), AllTrim(cValToChar(xVigFim)))
			// So tabelas vigentes no e-mail e no log
			If !fVigEncerr(cVigFim)
				aAdd(aMed[nPos][__M_VLRTAB], {(cAlias)->BD4_VALREF, AllTrim((cAlias)->BD4_CODTAB), AllTrim((cAlias)->TABDESC),;
					AllTrim((cAlias)->TABPAD), AllTrim((cAlias)->BD4_CODIGO), cVigFim})
			EndIf
		EndIf
		(cAlias)->(DbSkip())
	EndDo

	(cAlias)->(DbCloseArea())

	For nI := 1 To Len(aMed)
		If Empty(aMed[nI][__M_VLRTAB])
			aMed[nI][__M_VLRTAB] := "sem valor em tabela vigente"
		EndIf
	Next nI

Return

/*/{Protheus.doc} fProcAltoCusto
Procedimentos de alto custo lancados na guia: itens da tabela escolhida por fCfgProc() (B53_TIPO e
B71_ALIMOV), pela chave do B53_NUMGUI, cujo CODPAD + CODPRO esta na lista de fCarregaMed() (indice
oCrit["idx"]): o criterio (ALTCUS ou VALOR) ja foi aplicado na lista, sem consulta extra por guia.
Todos os procedimentos da guia vao para o log (com a tabela e a marca ALTO CUSTO); so os de alto
custo sao devolvidos.
Valor na guia = soma de quantidade solicitada x valor unitario (quantidade zerada conta como 1).
Tabela ou campo ausente no dicionario so vai para o log (nova tentativa nao resolveria).
@type function
@param aItem, array, B71 com __I_ALIMOV, __I_TIPO e __I_B53GUI (fMontaB71)
@param aMed, array, medicamentos de fCarregaMed() (descricao e valor de tabela)
@param oCrit, object, criterio da lista (fConfigApi), com o indice montado por fCarregaMed()
@param lOk, logical, (por referencia) .F. se a consulta falhou (falha temporaria: a B71 nao avanca)
@return array, itens no formato __F_*, com __F_ORIGEM = __O_PROC
/*/
Static Function fProcAltoCusto(aItem, aMed, oCrit, lOk)

	Local aCfg    := fCfgProc(aItem[__I_TIPO], aItem[__I_ALIMOV])
	Local cIte    := aCfg[__C_ALIAS]
	Local lBea    := cIte == "BE2" .And. !Empty(aItem[__I_CHVBEA])
	Local cNumGui := IIf(lBea, aItem[__I_CHVBEA], aItem[__I_B53GUI])
	Local cOrigem := IIf(lBea, "chave da BEA recno " + aItem[__I_RECMOV], "B53_NUMGUI")
	Local aPartes := __NUMGUI_PT
	Local aCampos := {aCfg[__C_CODPAD], aCfg[__C_CODPRO], aCfg[__C_QTD], aCfg[__C_VALOR]}
	Local aProc   := {}
	Local aLinhas := {}
	Local cFalta  := ""
	Local cQtd    := ""
	Local cQuery  := ""
	Local cAlias  := ""
	Local cCod    := ""
	Local cDescri := ""
	Local cCodPad := ""
	Local cChave  := ""
	Local cValor  := ""
	Local lAltCus := .F.
	Local lAltBr8 := .F.
	Local lCritAl := oCrit["criterio"] == __CRIT_ALT
	Local oIdx    := oCrit["idx"]
	Local oErro   := Nil
	Local nIni    := 1
	Local nTotal  := 0
	Local nM      := 0
	Local nI      := 0

	lOk := .T.

	aEval(aPartes, {|x| nTotal += x})
	If Len(cNumGui) != nTotal .Or. !fSoDigitos(cNumGui)
		fLog("WARN", "  procedimentos nao verificados: " + cOrigem + " '" + cNumGui + "' fora do formato OPEMOV+ANOAUT+MESAUT+NUMAUT")
		Return aProc
	EndIf

	aEval(aCfg[__C_CHAVE], {|x| aAdd(aCampos, x)})
	If !fCamposOk(cIte, aCampos, @cFalta)
		fLog("ERROR", "  procedimentos nao verificados: " + cFalta + " nao existe no dicionario (itens " + cIte + ")")
		Return aProc
	EndIf

	cQtd := "(CASE WHEN IT." + aCfg[__C_QTD] + " > 0 THEN IT." + aCfg[__C_QTD] + " ELSE 1 END)"
	cQuery := "SELECT IT." + aCfg[__C_CODPAD] + " AS CODPAD, IT." + aCfg[__C_CODPRO] + " AS CODPRO," +;
		" BR8.BR8_CODPSA AS BR8COD, BR8.BR8_DESCRI, BR8.BR8_ALTCUS," +;
		" SUM(" + cQtd + ") AS QTD, SUM(" + cQtd + " * IT." + aCfg[__C_VALOR] + ") AS VALOR" +;
		" FROM " + RetSqlName(cIte) + " IT" +;
		" LEFT JOIN " + RetSqlName("BR8") + " BR8" +;
		" ON BR8.BR8_FILIAL = '" + xFilial("BR8") + "'" +;
		" AND BR8.BR8_CODPAD = IT." + aCfg[__C_CODPAD] +;
		" AND BR8.BR8_CODPSA = IT." + aCfg[__C_CODPRO] +;
		" AND BR8.D_E_L_E_T_ = ' '" +;
		" WHERE IT." + cIte + "_FILIAL = '" + xFilial(cIte) + "'"
	For nI := 1 To Len(aCfg[__C_CHAVE])
		cQuery += " AND IT." + aCfg[__C_CHAVE][nI] + " = '" + SubStr(cNumGui, nIni, aPartes[nI]) + "'"
		cChave += IIf(nI > 1, "+", "") + aCfg[__C_CHAVE][nI]
		cValor += IIf(nI > 1, " ", "") + SubStr(cNumGui, nIni, aPartes[nI])
		nIni += aPartes[nI]
	Next nI
	cQuery += " AND IT.D_E_L_E_T_ = ' '" +;
		" GROUP BY IT." + aCfg[__C_CODPAD] + ", IT." + aCfg[__C_CODPRO] + ", BR8.BR8_CODPSA, BR8.BR8_DESCRI, BR8.BR8_ALTCUS" +;
		" ORDER BY IT." + aCfg[__C_CODPRO]

	BEGIN SEQUENCE
		cAlias := MPSysOpenQuery(ChangeQuery(cQuery))
		While !(cAlias)->(Eof())
			cCod    := AllTrim((cAlias)->CODPRO)
			cCodPad := AllTrim((cAlias)->CODPAD)
			cDescri := IIf(Empty((cAlias)->BR8COD), "(nao cadastrado na BR8)", AllTrim((cAlias)->BR8_DESCRI))
			nM      := oIdx[cCodPad + "|" + cCod]
			lAltCus := ValType(nM) == "N"
			// BR8_ALTCUS so explica no log por que um item marcado ficou de fora (CODPAD fora de __CODPAD_BR8)
			lAltBr8 := lCritAl .And. AllTrim((cAlias)->BR8_ALTCUS) == "1"
			aAdd(aLinhas, "    [" + cIte + "] " + cCodPad + " " + cCod + " - " + cDescri +;
				" | qtd " + fQtd((cAlias)->QTD) + " | " + fMoeda((cAlias)->VALOR) +;
				IIf(lAltCus, " | ALTO CUSTO" + IIf(lCritAl, "", " (" + fCritTxt(oCrit) + ")"),;
					IIf(lAltBr8, " | alto custo na BR8, CODPAD fora de " + fCodPadTxt() + " (ignorado)", "")))
			If lAltCus
				aAdd(aProc, {cCod, cDescri, "", "", cCodPad,;
					aMed[nM][__M_VLRTAB], fMoeda((cAlias)->VALOR), "", __O_PROC, fQtd((cAlias)->QTD)})
			EndIf
			(cAlias)->(DbSkip())
		EndDo
		(cAlias)->(DbCloseArea())
	RECOVER USING oErro
		lOk := .F.
	END SEQUENCE

	If !lOk
		If !Empty(cAlias) .And. Select(cAlias) > 0
			(cAlias)->(DbCloseArea())
		EndIf
		fLog("ERROR", "  procedimentos da guia (itens " + cIte + "): " + IIf(ValType(oErro) == "O", oErro:Description, "erro desconhecido"))
		Return {}
	EndIf

	If Len(aLinhas) == 0
		fLog("INFO", "  itens " + cIte + " da guia (" + cOrigem + ": " + cChave + " = " + cValor + "): nenhum procedimento lancado")
	Else
		fLog("INFO", "  itens " + cIte + " da guia (" + cOrigem + ": " + cChave + " = " + cValor + "): " + cValToChar(Len(aLinhas)) +;
			" procedimento(s), " + cValToChar(Len(aProc)) + " de alto custo")
		aEval(aLinhas, {|x| fLog("INFO", x)})
	EndIf

Return aProc

/*/{Protheus.doc} fCfgProc
Tabela de itens da guia pelo tipo da guia na B53. A chave dos itens e o B53_NUMGUI dividido em
__NUMGUI_PT (OPEMOV + ANOAUT + MESAUT + NUMAUT); na BE2 de uma B71 da BEA, a chave da propria BEA
(fChaveBea). Confirmar com levantamento/07-b53-tipgui-itens.sql.
@type function
@param cTipo, character, B53_TIPO
@param cAliMov, character, B71_ALIMOV (tabela origem da movimentacao)
@return array, {cAliIte, {aCamposChave}, cCpoCodPad, cCpoCodPro, cCpoQtd, cCpoVlrUnit} (posicoes __C_*)
/*/
Static Function fCfgProc(cTipo, cAliMov)

	Local nTip := Val(AllTrim(cTipo))

	Do Case
	Case aScan(__TIP_BE2, nTip) > 0
		Return {"BE2", {"BE2_OPEMOV", "BE2_ANOAUT", "BE2_MESAUT", "BE2_NUMAUT"}, "BE2_CODPAD", "BE2_CODPRO", "BE2_QTDSOL", "BE2_VLRAPR"}
	Case nTip == __TIP_BQV .And. AllTrim(cAliMov) == "B4Q"
		Return {"BQV", {"BQV_CODOPE", "BQV_ANOINT", "BQV_MESINT", "BQV_NUMINT"}, "BQV_CODPAD", "BQV_CODPRO", "BQV_QTDSOL", "BQV_VLRAPR"}
	EndCase

Return {"B4C", {"B4C_OPEMOV", "B4C_ANOAUT", "B4C_MESAUT", "B4C_NUMAUT"}, "B4C_CODPAD", "B4C_CODPRO", "B4C_QTDSOL", "B4C_VLRUNT"}

/*/{Protheus.doc} fQtd
@type function
@return character, quantidade sem casas decimais quando inteira, senao com 2 casas (virgula)
/*/
Static Function fQtd(nQtd)
Return AllTrim(Transform(nQtd, IIf(nQtd == Int(nQtd), "@E 999,999,999", "@E 999,999,999.99")))

/*/{Protheus.doc} fCamposOk
@type function
@param cFalta, character, (por referencia) tabela ou campo que falta
@return logical, .T. se a tabela e todos os campos existem no dicionario
/*/
Static Function fCamposOk(cAlias, aCampos, cFalta)

	Local nI := 0

	If !AliasInDic(cAlias)
		cFalta := "tabela " + cAlias
		Return .F.
	EndIf

	DbSelectArea(cAlias)
	For nI := 1 To Len(aCampos)
		If (cAlias)->(FieldPos(aCampos[nI])) == 0
			cFalta := aCampos[nI]
			Return .F.
		EndIf
	Next nI

Return .T.

/*/{Protheus.doc} fSqlStr
@type function
@return character, valor de campo pronto para literal SQL (datas em AAAAMMDD, aspas duplicadas)
/*/
Static Function fSqlStr(xValor)

	Local cRet := IIf(ValType(xValor) == "D", DToS(xValor), cValToChar(xValor))

Return StrTran(cRet, "'", "''")

/*/{Protheus.doc} fSqlIn
@type function
@return character, lista para o IN do SQL, ex.: "('00', '20')"
/*/
Static Function fSqlIn(aValores)

	Local cRet := ""

	aEval(aValores, {|x| cRet += IIf(Empty(cRet), "", ", ") + "'" + fSqlStr(x) + "'"})

Return "(" + cRet + ")"

/*/{Protheus.doc} fCodPadTxt
@type function
@return character, CODPADs de __CODPAD_BR8 separados por "/" (ex.: "00/20"), para log e e-mail
/*/
Static Function fCodPadTxt()
Return fListaCpo(__CODPAD_BR8)

/*/{Protheus.doc} fCritTxt
@type function
@param oCrit, object, criterio da lista (fConfigApi)
@return character, criterio para log e e-mail: "BR8_ALTCUS = '1'" ou "valor de tabela BD4 > R$ 1.500,00"
/*/
Static Function fCritTxt(oCrit)

	If oCrit["criterio"] == __CRIT_VLR
		Return "valor de tabela BD4 > " + fMoeda(oCrit["vlrmin"])
	EndIf

Return "BR8_ALTCUS = '1'"

/*/{Protheus.doc} fSqlFiltroBr8
Filtro do criterio na BR8 (alias BR8), usado por fCarregaMed() e fCarregaVlrTab() para que as duas
consultas tragam os mesmos itens. No criterio VALOR, o EXISTS parte da chave da BR8 e para no primeiro
BD4 vigente acima do minimo: os termos continuam vindo de todas as linhas da BA8 do item.
@type function
@param oCrit, object, criterio da lista (fConfigApi)
@return character, " AND ..." para o WHERE da BR8
/*/
Static Function fSqlFiltroBr8(oCrit)

	If oCrit["criterio"] != __CRIT_VLR
		Return " AND BR8.BR8_ALTCUS = '1'"
	EndIf

Return " AND EXISTS (SELECT 1 FROM " + RetSqlName("BA8") + " BA8V" +;
		" INNER JOIN " + RetSqlName("BD4") + " BD4V" +;
		" ON BD4V.BD4_FILIAL = '" + xFilial("BD4") + "'" +;
		" AND BD4V.BD4_CODTAB = BA8V.BA8_CODTAB" +;
		" AND BD4V.BD4_CDPADP = BA8V.BA8_CDPADP" +;
		" AND BD4V.BD4_CODPRO = BA8V.BA8_CODPRO" +;
		" AND BD4V.BD4_VALREF > " + AllTrim(Str(oCrit["vlrmin"], 18, 2)) +;
		fSqlBd4Vig("BD4V") +;
		" WHERE BA8V.BA8_FILIAL = '" + xFilial("BA8") + "'" +;
		" AND BA8V.BA8_CDPADP = BR8.BR8_CODPAD" +;
		" AND BA8V.BA8_CODPRO = BR8.BR8_CODPSA" +;
		" AND BA8V.D_E_L_E_T_ = ' ')"

/*/{Protheus.doc} fSqlBd4Vig
Restringe a BD4 do alias a vigencia mais recente ate hoje: o maior BD4_VIGINI <= hoje para cada
tabela + CDPADP + CODPRO + unidade (BD4_CODIGO). BD4_VIGFIM nao e considerado e vigencias futuras ficam de
fora. O NOT EXISTS usa a chave do indice da BD4 (FILIAL + CODTAB + CDPADP + CODPRO + CODIGO + VIGINI).
@type function
@param cAli, character, alias da BD4 na consulta
@return character, " AND ..." para o ON/WHERE da BD4
/*/
Static Function fSqlBd4Vig(cAli)

	Local cHoje := DToS(Date())
	Local cNov  := cAli + "N"

Return " AND " + cAli + ".BD4_VIGINI <= '" + cHoje + "'" +;
		" AND " + cAli + ".D_E_L_E_T_ = ' '" +;
		" AND NOT EXISTS (SELECT 1 FROM " + RetSqlName("BD4") + " " + cNov +;
			" WHERE " + cNov + ".BD4_FILIAL = " + cAli + ".BD4_FILIAL" +;
			" AND " + cNov + ".BD4_CODTAB = " + cAli + ".BD4_CODTAB" +;
			" AND " + cNov + ".BD4_CDPADP = " + cAli + ".BD4_CDPADP" +;
			" AND " + cNov + ".BD4_CODPRO = " + cAli + ".BD4_CODPRO" +;
			" AND " + cNov + ".BD4_CODIGO = " + cAli + ".BD4_CODIGO" +;
			" AND " + cNov + ".BD4_VIGINI > " + cAli + ".BD4_VIGINI" +;
			" AND " + cNov + ".BD4_VIGINI <= '" + cHoje + "'" +;
			" AND " + cNov + ".D_E_L_E_T_ = ' ')"

/*/{Protheus.doc} fCamposValorOk
@type function
@param cFalta, character, (por referencia) tabela ou campo que falta
@return logical, .T. se a BA8 e a BD4 tem os campos do valor de tabela (fCarregaVlrTab e criterio VALOR)
/*/
Static Function fCamposValorOk(cFalta)
Return fCamposOk("BA8", {"BA8_CODTAB"}, @cFalta) .And.;
	fCamposOk("BD4", {"BD4_CODTAB", "BD4_CDPADP", "BD4_CODPRO", "BD4_CODIGO", "BD4_VALREF", "BD4_VIGINI"}, @cFalta)

/*/{Protheus.doc} fFiltroDep
@type function
@return character, filtro " AND B71.B71_CODDEP IN (...)" com os departamentos de __CODDEP, ou ""
	(todos os departamentos) se __CODDEP estiver vazio
/*/
Static Function fFiltroDep()

	Local aDep := __CODDEP

	If Len(aDep) == 0
		Return ""
	EndIf

Return " AND B71.B71_CODDEP IN " + fSqlIn(aDep)

/*/{Protheus.doc} fDepTxt
@type function
@return character, departamentos de __CODDEP separados por "/" (ex.: "012/015"), ou "todos", para log
/*/
Static Function fDepTxt()

	Local aDep := __CODDEP

Return IIf(Len(aDep) == 0, "todos", fListaCpo(aDep))

/*/{Protheus.doc} fMoeda
@type function
@return character, "R$ 1.234,56"
/*/
Static Function fMoeda(nValor)
Return "R$ " + AllTrim(Transform(nValor, "@E 999,999,999,999.99"))

/*/{Protheus.doc} fAddTermo
Adiciona a descricao normalizada (fNormaliza + fLimpa) em aTermos, se tiver pelo menos
__MIN_TERMO caracteres e ainda nao estiver presente.
@type function
/*/
Static Function fAddTermo(aTermos, cTexto)

	Local cTermo := fLimpa(fNormaliza(cTexto))

	If Len(cTermo) >= __MIN_TERMO .And. aScan(aTermos, {|x| x == cTermo}) == 0
		aAdd(aTermos, cTermo)
	EndIf

Return

/*/{Protheus.doc} fNormaliza
@type function
@return character, texto sem acento, em maiusculas e sem espacos nas pontas
/*/
Static Function fNormaliza(cTexto)
Return Upper(FwNoAccent(AllTrim(cTexto)))

/*/{Protheus.doc} fConsulta
Busca as B71 novas (R_E_C_N_O_ > nUltimo, DATMOV = fDataMov(cData), CODDEP em __CODDEP) e, para cada uma,
resolve a guia na tabela origem e os anexos B53 -> AC9 -> ACB.
Todas as B71 da janela voltam, inclusive sem anexo ou com alias desconhecido, para que o
watermark possa avancar sobre elas.
@type function
@param nUltimo, numeric, valor atual de Z_NOTIENCA
@param cData, character, opcional; B71_DATMOV informado manualmente (AAAAMMDD); "" = hoje
@return array, itens {nRecno, cAliMov, cRecMov, cNumGui, aAnexos, cStatus, aTextos, cDatMov} em ordem de R_E_C_N_O_
/*/
Static Function fConsulta(nUltimo, cData)

	Local aB71   := {}
	Local cQuery := ""
	Local cAlias := ""

	Default cData := ""

	cQuery := "SELECT B71.R_E_C_N_O_ AS B71REC, B71.B71_ALIMOV, B71.B71_RECMOV, B71.B71_DATMOV" +;
		" FROM " + RetSqlName("B71") + " B71" +;
		" WHERE B71.B71_FILIAL = '" + xFilial("B71") + "'" +;
		fFiltroDep() +;
		" AND B71.B71_DATMOV = '" + fDataMov(cData) + "'" +;
		" AND B71.R_E_C_N_O_ > " + cValToChar(nUltimo) +;
		" AND B71.D_E_L_E_T_ = ' '" +;
		" ORDER BY B71.R_E_C_N_O_"

	cAlias := MPSysOpenQuery(ChangeQuery(cQuery))

	While !(cAlias)->(Eof())
		aAdd(aB71, fMontaB71((cAlias)->B71REC, AllTrim((cAlias)->B71_ALIMOV), AllTrim((cAlias)->B71_RECMOV),;
			IIf(ValType((cAlias)->B71_DATMOV) == "D", DToS((cAlias)->B71_DATMOV), AllTrim((cAlias)->B71_DATMOV))))
		(cAlias)->(DbSkip())
	EndDo

	(cAlias)->(DbCloseArea())

Return aB71

/*/{Protheus.doc} fAvisaAtrasadas
Avisa no log sobre B71 de dias anteriores acima do watermark. O job so verifica o dia corrente, e
essas B71 (job parado ou com falha na virada do dia) ficam para tras assim que o watermark
avancar sobre a primeira B71 do dia. Nao altera o processamento.
@type function
@param nUltimo, numeric, valor atual de Z_NOTIENCA
@param cData, character, opcional; B71_DATMOV informado manualmente (AAAAMMDD); "" = hoje
/*/
Static Function fAvisaAtrasadas(nUltimo, cData)

	Local cQuery := ""
	Local cAlias := ""

	Default cData := ""

	cQuery := "SELECT COUNT(*) AS QTD, MIN(B71.R_E_C_N_O_) AS PRIREC, MIN(B71.B71_DATMOV) AS PRIDAT" +;
		" FROM " + RetSqlName("B71") + " B71" +;
		" WHERE B71.B71_FILIAL = '" + xFilial("B71") + "'" +;
		fFiltroDep() +;
		" AND B71.B71_DATMOV < '" + fDataMov(cData) + "'" +;
		" AND B71.R_E_C_N_O_ > " + cValToChar(nUltimo) +;
		" AND B71.D_E_L_E_T_ = ' '"

	cAlias := MPSysOpenQuery(ChangeQuery(cQuery))

	If !(cAlias)->(Eof()) .And. (cAlias)->QTD > 0
		fLog("WARN", cValToChar((cAlias)->QTD) + " B71 de dia(s) anterior(es) ficaram sem verificacao (a partir do recno " +;
			cValToChar((cAlias)->PRIREC) + ", DATMOV " + AllTrim((cAlias)->PRIDAT) + "). O job so verifica o dia corrente;" +;
			" conferir esses anexos manualmente se necessario.")
	EndIf

	(cAlias)->(DbCloseArea())

Return

/*/{Protheus.doc} fMontaB71
Resolve guia, B53 (tipo da guia) e anexos de uma B71.
B71 da BEA: guarda a chave da BEA do registro do B71_RECMOV (itens da BE2) e, com o BEA_GUIORI vazio,
usa essa chave como numero da guia.
@type function
@return array, item {nRecno, cAliMov, cRecMov, cNumGui, aAnexos, cStatus, aTextos, cDatMov, aPessoas,
	cTipo, cB53Gui, cChvBea, cBenef, cDatEnt}
/*/
Static Function fMontaB71(nRecno, cAliMov, cRecMov, cDatMov)

	Local aItem   := Array(__I_TAM)
	Local cCampo  := fCampoGuia(cAliMov)
	Local nRecOri := Val(cRecMov)
	Local nPosCpo := 0
	Local cGuia   := ""
	Local cFalta  := ""
	Local aB53    := {}

	aItem[__I_RECNO]  := nRecno
	aItem[__I_ALIMOV] := cAliMov
	aItem[__I_RECMOV] := cRecMov
	aItem[__I_NUMGUI] := ""
	aItem[__I_ANEXOS] := {}
	aItem[__I_TEXTOS] := {}
	aItem[__I_DATMOV] := cDatMov
	aItem[__I_PESSOAS] := {}
	aItem[__I_TIPO]   := ""
	aItem[__I_B53GUI] := ""
	aItem[__I_CHVBEA] := ""
	aItem[__I_BENEF]  := ""
	aItem[__I_DATENT] := ""

	If Empty(cCampo)
		aItem[__I_STATUS] := __ST_ALIAS
		Return aItem
	EndIf

	If nRecOri <= 0 .Or. !fPosOrigem(cAliMov, nRecOri)
		aItem[__I_STATUS] := __ST_ORIGEM
		Return aItem
	EndIf

	// Para o e-mail, com ou sem anexo e com a IA ligada ou nao
	aItem[__I_BENEF]  := fNomeBenef(cAliMov)
	aItem[__I_DATENT] := fDataEntrada(cAliMov)

	nPosCpo := (cAliMov)->(FieldPos(cCampo))
	If nPosCpo == 0
		aItem[__I_STATUS] := __ST_CAMPO
		Return aItem
	EndIf

	If cAliMov == "BEA"
		aItem[__I_CHVBEA] := fChaveBea()
	EndIf

	cGuia := AllTrim((cAliMov)->(FieldGet(nPosCpo)))
	If Empty(cGuia)
		cGuia := aItem[__I_CHVBEA]
	EndIf
	If Empty(cGuia)
		aItem[__I_STATUS] := __ST_SEMGUIA
		Return aItem
	EndIf

	aItem[__I_NUMGUI] := cGuia

	If !fCamposOk("B53", __CPO_B53, @cFalta)
		aItem[__I_STATUS] := __ST_CPOB53
		Return aItem
	EndIf

	aB53 := fLeB53(cGuia)
	If Len(aB53) == 0
		aItem[__I_STATUS] := __ST_SEMB53
		Return aItem
	EndIf
	aItem[__I_TIPO]   := aB53[1]
	aItem[__I_B53GUI] := aB53[2]

	aItem[__I_ANEXOS] := fBuscaAnexos(cGuia)
	aItem[__I_STATUS] := IIf(Len(aItem[__I_ANEXOS]) > 0, __ST_OK, __ST_SEMANEXO)

Return aItem

/*/{Protheus.doc} fChaveBea
Chave da BEA posicionada (fPosOrigem): OPEMOV + ANOAUT + MESAUT + NUMAUT, sem AllTrim para manter
o tamanho de cada parte (__NUMGUI_PT).
@type function
@return character, chave de 18 posicoes, ou "" se algum campo nao existir no dicionario ou estiver vazio
/*/
Static Function fChaveBea()

	Local aCampos := __CPO_CHVBEA
	Local cChave  := ""
	Local cFalta  := ""
	Local cParte  := ""
	Local nI      := 0

	If !fCamposOk("BEA", aCampos, @cFalta)
		fLog("WARN", "  chave da BEA indisponivel: " + cFalta + " nao existe no dicionario")
		Return ""
	EndIf

	For nI := 1 To Len(aCampos)
		cParte := BEA->(FieldGet(FieldPos(aCampos[nI])))
		If Empty(cParte)
			Return ""
		EndIf
		cChave += cParte
	Next nI

Return cChave

/*/{Protheus.doc} fLeB53
Guia na auditoria (B53) pelo numero da guia. Com mais de uma B53 para a guia (origens diferentes),
usa a mais recente.
@type function
@param cGuia, character, numero da guia original/referencia (sem espacos)
@return array, {cTipo, cNumGui} da B53, ou {} se a guia nao estiver na B53
/*/
Static Function fLeB53(cGuia)

	Local aRet    := {}
	Local nTam    := TamSX3("B53_NUMGUI")[1]
	Local cNumGui := StrTran(Left(cGuia, nTam), "'", "''")
	Local cQuery  := ""
	Local cAlias  := ""

	cQuery := "SELECT B53.B53_TIPO, B53.B53_NUMGUI" +;
		" FROM " + RetSqlName("B53") + " B53" +;
		" WHERE B53.B53_FILIAL = '" + xFilial("B53") + "'" +;
		" AND B53.B53_NUMGUI = '" + PadR(cNumGui, nTam) + "'" +;
		" AND B53.D_E_L_E_T_ = ' '" +;
		" ORDER BY B53.R_E_C_N_O_ DESC"

	cAlias := MPSysOpenQuery(ChangeQuery(cQuery))

	If !(cAlias)->(Eof())
		aRet := {AllTrim(cValToChar((cAlias)->B53_TIPO)), AllTrim((cAlias)->B53_NUMGUI)}
	EndIf

	(cAlias)->(DbCloseArea())

Return aRet

/*/{Protheus.doc} fPessoas
Dados pessoais da guia que a API mascara antes de enviar o texto ao Claude: nomes da tabela origem
(__CPO_NOMES), matricula do beneficiario (__CPO_MATRIC) e, sem nome do beneficiario na origem, o
BA1_NOMUSR da matricula. Campo ausente no dicionario e ignorado. Nao vai para o log; o nome do
beneficiario vai no e-mail por fNomeBenef().
@type function
@param cAliMov, character, tabela origem, ja posicionada por fPosOrigem()
@return array, { cNomeOuMatricula, ... }
/*/
Static Function fPessoas(cAliMov)

	Local aRet     := {}
	Local aNomes   := __CPO_NOMES
	Local aPartes  := {}
	Local cValor   := ""
	Local lNomUsr  := .F.
	Local nPos     := 0
	Local nI       := 0

	For nI := 1 To Len(aNomes)
		nPos := (cAliMov)->(FieldPos(cAliMov + aNomes[nI]))
		If nPos > 0
			cValor := AllTrim(cValToChar((cAliMov)->(FieldGet(nPos))))
			If !Empty(cValor)
				aAdd(aRet, cValor)
				lNomUsr := lNomUsr .Or. aNomes[nI] == "_NOMUSR"
			EndIf
		EndIf
	Next nI

	aPartes := fMatricula(cAliMov)
	If Len(aPartes) == 0
		Return aRet
	EndIf
	cValor := ""
	aEval(aPartes, {|x| cValor += x})
	aAdd(aRet, cValor)

	If !lNomUsr
		cValor := fNomeBa1(aPartes)
		If !Empty(cValor)
			aAdd(aRet, cValor)
		EndIf
	EndIf

Return aRet

/*/{Protheus.doc} fMatricula
Matricula do beneficiario na tabela origem (__CPO_MATRIC), na ordem da chave da BA1.
@type function
@param cAliMov, character, tabela origem, ja posicionada por fPosOrigem()
@return array, { cOpeUsr, cCodEmp, cMatric, cTipReg, cDigito }, ou {} se faltar campo no dicionario
	ou a matricula nao tiver ao menos 8 digitos
/*/
Static Function fMatricula(cAliMov)

	Local aMatric := __CPO_MATRIC
	Local aPartes := {}
	Local cValor  := ""
	Local nPos    := 0
	Local nI      := 0

	For nI := 1 To Len(aMatric)
		nPos := (cAliMov)->(FieldPos(cAliMov + aMatric[nI]))
		If nPos == 0
			Return {}
		EndIf
		aAdd(aPartes, AllTrim(cValToChar((cAliMov)->(FieldGet(nPos)))))
	Next nI

	aEval(aPartes, {|x| cValor += x})
	If Len(cValor) < 8 .Or. !fSoDigitos(cValor)
		Return {}
	EndIf

Return aPartes

/*/{Protheus.doc} fNomeBa1
@type function
@param aPartes, array, matricula de fMatricula()
@return character, BA1_NOMUSR da matricula, ou "" se nao encontrado ou BA1 sem os campos no dicionario
/*/
Static Function fNomeBa1(aPartes)

	Local cNome  := ""
	Local cQuery := ""
	Local cAlias := ""
	Local cFalta := ""
	Local oErro  := Nil

	If Len(aPartes) != Len(__CPO_MATRIC) .Or.;
		!fCamposOk("BA1", {"BA1_CODINT", "BA1_CODEMP", "BA1_MATRIC", "BA1_TIPREG", "BA1_DIGITO", "BA1_NOMUSR"}, @cFalta)
		Return ""
	EndIf

	BEGIN SEQUENCE
		cQuery := "SELECT BA1_NOMUSR FROM " + RetSqlName("BA1") +;
			" WHERE BA1_FILIAL = '" + xFilial("BA1") + "'" +;
			" AND BA1_CODINT = '" + fSqlStr(aPartes[1]) + "'" +;
			" AND BA1_CODEMP = '" + fSqlStr(aPartes[2]) + "'" +;
			" AND BA1_MATRIC = '" + fSqlStr(aPartes[3]) + "'" +;
			" AND BA1_TIPREG = '" + fSqlStr(aPartes[4]) + "'" +;
			" AND BA1_DIGITO = '" + fSqlStr(aPartes[5]) + "'" +;
			" AND D_E_L_E_T_ = ' '"
		cAlias := MPSysOpenQuery(ChangeQuery(cQuery))
		If !(cAlias)->(Eof())
			cNome := AllTrim((cAlias)->BA1_NOMUSR)
		EndIf
		(cAlias)->(DbCloseArea())
	RECOVER USING oErro
		fLog("WARN", "  nome do beneficiario (BA1) nao apurado: " +;
			IIf(ValType(oErro) == "O", oErro:Description, "erro desconhecido"))
	END SEQUENCE

Return cNome

/*/{Protheus.doc} fNomeBenef
Nome do beneficiario para o e-mail: <alias>_NOMUSR da tabela origem ou, vazio/sem o campo, o
BA1_NOMUSR da matricula. Nao vai para o log.
@type function
@param cAliMov, character, tabela origem, ja posicionada por fPosOrigem()
@return character, nome, ou "" se nao apurado
/*/
Static Function fNomeBenef(cAliMov)

	Local nPos  := (cAliMov)->(FieldPos(cAliMov + "_NOMUSR"))
	Local cNome := ""

	If nPos > 0
		cNome := AllTrim(cValToChar((cAliMov)->(FieldGet(nPos))))
	EndIf

	If Empty(cNome)
		cNome := fNomeBa1(fMatricula(cAliMov))
	EndIf

Return cNome

/*/{Protheus.doc} fDataEntrada
Data em que a guia entrou no sistema: primeiro campo de __CPO_DATENT (prefixo = alias) que existir
na tabela origem e estiver preenchido.
@type function
@param cAliMov, character, tabela origem, ja posicionada por fPosOrigem()
@return character, AAAAMMDD, ou "" se nenhum campo existir ou estiver preenchido
/*/
Static Function fDataEntrada(cAliMov)

	Local aCampos := __CPO_DATENT
	Local xValor  := Nil
	Local cData   := ""
	Local nPos    := 0
	Local nI      := 0

	For nI := 1 To Len(aCampos)
		nPos := (cAliMov)->(FieldPos(cAliMov + aCampos[nI]))
		If nPos > 0
			xValor := (cAliMov)->(FieldGet(nPos))
			cData  := AllTrim(IIf(ValType(xValor) == "D", DToS(xValor), cValToChar(xValor)))
			If Len(cData) == 8 .And. fSoDigitos(cData)
				Return cData
			EndIf
		EndIf
	Next nI

Return ""

/*/{Protheus.doc} fTipoExtenso
Descricao do B53_TIPO pelo combo do dicionario (X3_CBOX no formato "1=Consulta;2=SADT;...").
@type function
@param cTipo, character, B53_TIPO
@return character, descricao, ou o proprio codigo sem combo, com combo por funcao (#) ou codigo fora dele
/*/
Static Function fTipoExtenso(cTipo)

	Local xCbox := GetSX3Cache("B53_TIPO", "X3_CBOX")
	Local aOpc  := {}
	Local nPos  := 0
	Local nI    := 0

	If ValType(xCbox) != "C" .Or. Empty(xCbox) .Or. Left(AllTrim(xCbox), 1) == "#"
		Return cTipo
	EndIf

	aOpc := StrTokArr(AllTrim(xCbox), ";")
	For nI := 1 To Len(aOpc)
		nPos := At("=", aOpc[nI])
		If nPos > 0 .And. AllTrim(Left(aOpc[nI], nPos - 1)) == AllTrim(cTipo) .And. !Empty(SubStr(aOpc[nI], nPos + 1))
			Return AllTrim(SubStr(aOpc[nI], nPos + 1))
		EndIf
	Next nI

Return cTipo

/*/{Protheus.doc} fCampoGuia
@type function
@return character, campo da guia na tabela origem, ou "" se o alias nao for tratado
/*/
Static Function fCampoGuia(cAliMov)

	Local aMapa := {;
		{"BEA", "BEA_GUIORI"},;
		{"BE4", "BE4_GUIORI"},;
		{"B44", "B44_GUIORI"},;
		{"B4Q", "B4Q_GUIREF"},;
		{"B4A", "B4A_GUIREF"}}
	Local nPos := aScan(aMapa, {|x| x[1] == cAliMov})

Return IIf(nPos > 0, aMapa[nPos][2], "")

/*/{Protheus.doc} fPosOrigem
Posiciona a tabela origem no R_E_C_N_O_ apontado por B71_RECMOV.
@type function
@return logical, .T. se o registro existe e nao esta deletado
/*/
Static Function fPosOrigem(cAliMov, nRecOri)

	DbSelectArea(cAliMov)
	(cAliMov)->(DbGoTo(nRecOri))

Return !(cAliMov)->(Eof()) .And. !(cAliMov)->(Deleted())

/*/{Protheus.doc} fBuscaAnexos
Anexos da guia no banco de conhecimento: B53 (B53_NUMGUI) -> AC9 (AC9_CODENT contem a guia) -> ACB.
@type function
@param cGuia, character, numero da guia original/referencia (sem espacos)
@return array, { {cCodObj, cObjeto}, ... }
/*/
Static Function fBuscaAnexos(cGuia)

	Local aAnexos := {}
	Local nTam    := TamSX3("B53_NUMGUI")[1]
	Local cNumGui := StrTran(Left(cGuia, nTam), "'", "''")
	Local cQuery  := ""
	Local cAlias  := ""

	cQuery := "SELECT DISTINCT ACB.ACB_CODOBJ, ACB.ACB_OBJETO" +;
		" FROM " + RetSqlName("B53") + " B53" +;
		" INNER JOIN " + RetSqlName("AC9") + " AC9" +;
		" ON AC9.AC9_FILIAL = '" + xFilial("AC9") + "'" +;
		" AND AC9.AC9_CODENT LIKE '%" + AllTrim(cNumGui) + "%'" +;
		" AND AC9.D_E_L_E_T_ = ' '" +;
		" INNER JOIN " + RetSqlName("ACB") + " ACB" +;
		" ON ACB.ACB_FILIAL = '" + xFilial("ACB") + "'" +;
		" AND ACB.ACB_CODOBJ = AC9.AC9_CODOBJ" +;
		" AND ACB.ACB_OBJETO <> ' '" +;
		" AND ACB.D_E_L_E_T_ = ' '" +;
		" WHERE B53.B53_FILIAL = '" + xFilial("B53") + "'" +;
		" AND B53.B53_NUMGUI = '" + PadR(cNumGui, nTam) + "'" +;
		" AND B53.D_E_L_E_T_ = ' '"

	If !Empty(__CODOBJ)
		cQuery += " AND ACB.ACB_CODOBJ = '" + __CODOBJ + "'"
	EndIf

	cQuery += " ORDER BY ACB.ACB_CODOBJ"

	cAlias := MPSysOpenQuery(ChangeQuery(cQuery))

	While !(cAlias)->(Eof())
		aAdd(aAnexos, {AllTrim((cAlias)->ACB_CODOBJ), AllTrim((cAlias)->ACB_OBJETO)})
		(cAlias)->(DbSkip())
	EndDo

	(cAlias)->(DbCloseArea())

Return aAnexos

/*/{Protheus.doc} fLogB71
Registra no log o resultado da resolucao de uma B71.
@type function
/*/
Static Function fLogB71(aItem)

	Local cMsg   := "B71 " + cValToChar(aItem[__I_RECNO]) + " (" + aItem[__I_ALIMOV] + " " + aItem[__I_RECMOV] + "): "
	Local cNivel := "INFO"
	Local nI     := 0

	Do Case
	Case aItem[__I_STATUS] == __ST_OK
		cMsg += "guia " + aItem[__I_NUMGUI] + fDescTipo(aItem) + ", " + cValToChar(Len(aItem[__I_ANEXOS])) + " anexo(s):"
		For nI := 1 To Len(aItem[__I_ANEXOS])
			cMsg += " [" + aItem[__I_ANEXOS][nI][__A_CODOBJ] + "] " + aItem[__I_ANEXOS][nI][__A_OBJETO]
		Next nI
	Case aItem[__I_STATUS] == __ST_SEMANEXO
		cMsg += "guia " + aItem[__I_NUMGUI] + fDescTipo(aItem) + ", sem anexo no banco de conhecimento"
	Case aItem[__I_STATUS] == __ST_SEMB53
		cMsg += "guia " + aItem[__I_NUMGUI] + fGuiaBea(aItem) + " nao encontrada na B53; nada a verificar"
	Case aItem[__I_STATUS] == __ST_CPOB53
		cNivel := "ERROR"
		cMsg   += "campo " + fListaCpo(__CPO_B53) + " nao existe no dicionario da B53"
	Case aItem[__I_STATUS] == __ST_SEMGUIA
		cMsg += "campo da guia vazio na tabela origem" + IIf(aItem[__I_ALIMOV] == "BEA", " e chave da BEA indisponivel", "")
	Case aItem[__I_STATUS] == __ST_ORIGEM
		cNivel := "WARN"
		cMsg   += "registro origem nao encontrado ou deletado"
	Case aItem[__I_STATUS] == __ST_ALIAS
		cNivel := "WARN"
		cMsg   += "alias de origem nao tratado; registro sera descartado"
	Case aItem[__I_STATUS] == __ST_CAMPO
		cNivel := "ERROR"
		cMsg   += "campo " + fCampoGuia(aItem[__I_ALIMOV]) + " nao existe no dicionario"
	EndCase

	fLog(cNivel, cMsg)

Return

/*/{Protheus.doc} fDescTipo
@type function
@return character, " (B53_TIPO x - descricao, itens z, entrada DD/MM/AAAA)" para o log
/*/
Static Function fDescTipo(aItem)

	Local cExt := fTipoExtenso(aItem[__I_TIPO])

Return fGuiaBea(aItem) + " (B53_TIPO " + aItem[__I_TIPO] + IIf(cExt == aItem[__I_TIPO], "", " - " + cExt) +;
	", itens " + fCfgProc(aItem[__I_TIPO], aItem[__I_ALIMOV])[__C_ALIAS] +;
	", entrada " + IIf(Empty(aItem[__I_DATENT]), __VLR_ND, DToC(SToD(aItem[__I_DATENT]))) + ")"

/*/{Protheus.doc} fGuiaBea
@type function
@return character, " pela chave da BEA" quando o numero da guia veio da BEA (BEA_GUIORI vazio), senao ""
/*/
Static Function fGuiaBea(aItem)
Return IIf(!Empty(aItem[__I_CHVBEA]) .And. aItem[__I_NUMGUI] == aItem[__I_CHVBEA], " pela chave da BEA", "")

/*/{Protheus.doc} fListaCpo
@type function
@return character, campos separados por "/"
/*/
Static Function fListaCpo(aCampos)

	Local cRet := ""

	aEval(aCampos, {|x| cRet += IIf(Empty(cRet), "", "/") + x})

Return cRet

/*/{Protheus.doc} fLeWatermark
Le o ultimo R_E_C_N_O_ da B71 ja verificado (SX6 Z_NOTIENCA).
Usa GetMV e nao SuperGetMV: o cache do SuperGetMV devolveria o valor antigo quando o job roda
mais de uma vez na mesma thread (U_tstMEDALTC, SmartClient) e a B71 seria reprocessada.
@type function
@return numeric, recno do watermark, ou -1 se o parametro nao existir / for invalido
/*/
Static Function fLeWatermark()

	Local xValor := Nil
	Local nValor := -1

	If !GetMV(__PAR_WATER, .T.)
		fLog("ERROR", "Parametro " + __PAR_WATER + " nao cadastrado na SX6. Execute U_OSCRIAZNOT.")
		Return nValor
	EndIf
	xValor := GetMV(__PAR_WATER)

	Do Case
	Case ValType(xValor) == "N"
		nValor := xValor
	Case ValType(xValor) == "C" .And. fSoDigitos(AllTrim(xValor))
		nValor := Val(AllTrim(xValor))
	Otherwise
		fLog("ERROR", "Parametro " + __PAR_WATER + " com conteudo invalido: '" + cValToChar(xValor) + "'")
	EndCase

Return nValor

/*/{Protheus.doc} fValidaCfg
Confere se as configuracoes obrigatorias estao preenchidas.
O token da API vem da SX6 para nao ficar no fonte.
@type function
@return logical, .T. se pode prosseguir
/*/
Static Function fValidaCfg()

	If Empty(__API_TOKEN)
		fLog("ERROR", "Parametro SX6 Z_MEDAPIT (token da API) nao preenchido.")
		Return .F.
	EndIf

	If Empty(fMailTo())
		fLog("ERROR", "__MAIL_TO sem destinatario.")
		Return .F.
	EndIf

	fLog("INFO", "Config: ambiente " + AllTrim(GetEnvServer()) + " | API " + __API_URL + " | e-mail " + fMailTo() +;
		IIf(Empty(__CODOBJ), "", " | filtro ACB_CODOBJ = " + __CODOBJ))

	If !Empty(__DATA_DBG)
		fLog("WARN", "__DATA_DBG ativo: B71_DATMOV = " + __DATA_DBG + ' em vez de hoje. Voltar para "" antes de produzir.')
	EndIf

Return .T.

/*/{Protheus.doc} fMailTo
@type function
@return character, e-mails de __MAIL_TO separados por ";" (sem vazios nem repetidos), ou "" se nenhum
/*/
Static Function fMailTo()

	Local aLista  := __MAIL_TO
	Local aVistos := {}
	Local cRet    := ""
	Local cMail   := ""
	Local nI      := 0

	For nI := 1 To Len(aLista)
		cMail := AllTrim(aLista[nI])
		If Empty(cMail) .Or. aScan(aVistos, {|x| Lower(x) == Lower(cMail)}) > 0
			Loop
		EndIf
		aAdd(aVistos, cMail)
		cRet += IIf(Empty(cRet), "", ";") + cMail
	Next nI

Return cRet

/*/{Protheus.doc} fApiBase
@type function
@return character, URL base da API: __URL_PROD quando o ambiente e __ENV_PROD, senao __URL_DEV
/*/
Static Function fApiBase()
Return IIf(Upper(AllTrim(GetEnvServer())) == __ENV_PROD, __URL_PROD, __URL_DEV)

/*/{Protheus.doc} fApiUrl
@type function
@return character, URL do POST __API_PATH
/*/
Static Function fApiUrl()
Return fApiBase() + __API_PATH

/*/{Protheus.doc} fConfigApi
Pergunta a API se a IA esta ligada e qual o criterio dos medicamentos (GET __CFG_PATH; IA_HABILITADA,
MEDICAMENTO_CRITERIO e MEDICAMENTO_VALOR_MIN no .env da API). API sem "criterio" (versao anterior):
__CRIT_PAD.
@type function
@param lIa, logical, (por referencia) .T. se a IA esta ligada
@param cModelo, character, (por referencia) modelo da IA, quando ligada
@param oCrit, object, (por referencia) JsonObject {criterio: __CRIT_ALT | __CRIT_VLR, vlrmin: numerico};
	sempre preenchido (__CRIT_PAD em caso de falha), para o U_chkMEDALTC seguir
@param cErro, character, (por referencia) motivo da falha
@return logical, .F. se a API nao respondeu o flag ou o criterio veio invalido (falha temporaria: a execucao
	nao avanca o watermark)
/*/
Static Function fConfigApi(lIa, cModelo, oCrit, cErro)

	Local oRest   := Nil
	Local oResp   := JsonObject():New()
	Local aHeader := {}
	Local cHost   := ""
	Local cPath   := ""
	Local cResp   := ""
	Local cCrit   := ""

	lIa     := .F.
	cModelo := ""
	cErro   := ""
	oCrit   := JsonObject():New()
	oCrit["criterio"] := __CRIT_PAD
	oCrit["vlrmin"]   := 0

	fSplitUrl(fApiBase() + __CFG_PATH, @cHost, @cPath)
	aAdd(aHeader, "Authorization: Bearer " + AllTrim(__API_TOKEN))

	oRest := FWRest():New(cHost)
	oRest:SetPath(cPath)
	oRest:SetTimeOut(60)
	oRest:Get(aHeader)

	cResp := oRest:GetResult()
	If Empty(cResp)
		cErro := "sem resposta da API (" + AllTrim(cValToChar(oRest:GetLastError())) + ")"
		Return .F.
	EndIf

	If ValType(oResp:FromJson(cResp)) == "C" .Or. ValType(oResp["ia"]) != "L"
		Do Case
		Case "Cannot GET" $ cResp
			cErro := "API sem o " + __CFG_PATH + ": atualizar a API"
		Case ValType(oResp["erro"]) == "C"
			cErro := fDecUtf8(oResp["erro"])
		Otherwise
			cErro := "resposta invalida da API: " + Left(cResp, 200)
		EndCase
		Return .F.
	EndIf

	lIa     := oResp["ia"]
	cModelo := IIf(ValType(oResp["modelo"]) == "C", oResp["modelo"], "")

	If ValType(oResp["criterio"]) != "C"
		fLog("INFO", "API sem o criterio dos medicamentos (versao anterior): usando " + __CRIT_PAD)
		Return .T.
	EndIf

	cCrit := Upper(AllTrim(oResp["criterio"]))
	Do Case
	Case cCrit == __CRIT_ALT
		oCrit["criterio"] := __CRIT_ALT
	Case cCrit == __CRIT_VLR .And. ValType(oResp["valorMin"]) == "N" .And. oResp["valorMin"] > 0
		oCrit["criterio"] := __CRIT_VLR
		oCrit["vlrmin"]   := oResp["valorMin"]
	Case cCrit == __CRIT_VLR
		cErro := "criterio " + __CRIT_VLR + " sem valorMin maior que zero: conferir MEDICAMENTO_VALOR_MIN no .env da API"
		Return .F.
	Otherwise
		cErro := "criterio de medicamentos desconhecido: '" + cCrit + "' (esperado altcus ou valor)"
		Return .F.
	EndCase

Return .T.

/*/{Protheus.doc} fDataMov
@type function
@param cData, character, opcional; data informada em U_dataMEDALTC (AAAAMMDD)
@return character, B71_DATMOV consultado (AAAAMMDD): cData se informado, senao __DATA_DBG se
	preenchido, senao hoje
/*/
Static Function fDataMov(cData)

	Default cData := ""

	If !Empty(cData)
		Return cData
	EndIf

Return IIf(Empty(__DATA_DBG), DToS(Date()), __DATA_DBG)

/*/{Protheus.doc} fSoDigitos
@type function
@return logical, .T. se cTexto nao for vazio e tiver apenas digitos
/*/
Static Function fSoDigitos(cTexto)

	Local nI := 0

	If Empty(cTexto)
		Return .F.
	EndIf

	For nI := 1 To Len(cTexto)
		If !IsDigit(SubStr(cTexto, nI, 1))
			Return .F.
		EndIf
	Next nI

Return .T.

/*/{Protheus.doc} fLog
Registra a mensagem no console do AppServer, no log do framework e no arquivo do dia
(PlsPtuLog, ou fLogArq se a funcao nao estiver no RPO).
@type function
@param cNivel, character, INFO | WARN | ERROR
@param cMsg, character, mensagem
/*/
Static Function fLog(cNivel, cMsg)

	Local cLinha := "[" + __JOB_NAME + "][" + cNivel + "][" + DToC(Date()) + " " + Time() + "] " + cMsg

	ConOut(cLinha)
	FwLogMsg(cNivel, __JOB_NAME, __JOB_NAME, "", "", "", cMsg, 0, 0)
	If FindFunction("PlsPtuLog")
		PlsPtuLog(cLinha, __LOG_ARQ + "_" + DToS(Date()) + ".log")
	Else
		fLogArq(cLinha)
	EndIf

Return

/*/{Protheus.doc} fLogArq
Fallback do PlsPtuLog: so e usado quando a funcao nao existe no RPO.
Acrescenta a linha em __LOG_DIR + __LOG_ARQ + "_AAAAMMDD.log". Abre e fecha a cada linha, para nada
ficar em buffer se a thread cair e para o arquivo poder ser lido com o job rodando.
Falha de gravacao so vai para o console: nunca interrompe o job e nao chama fLog (recursao).
@type function
@param cLinha, character, linha ja formatada por fLog
/*/
Static Function fLogArq(cLinha)

	Local cArq := __LOG_DIR + __LOG_ARQ + "_" + DToS(Date()) + ".log"
	Local nHdl := -1

	If !ExistDir(__LOG_DIR)
		MakeDir(__LOG_DIR)
	EndIf

	If File(cArq)
		nHdl := FOpen(cArq, FO_READWRITE + FO_SHARED)
		If nHdl >= 0
			FSeek(nHdl, 0, FS_END)
		EndIf
	Else
		nHdl := FCreate(cArq)
	EndIf

	If nHdl < 0
		ConOut("[" + __JOB_NAME + "][WARN] nao foi possivel gravar " + cArq + " (FError " + cValToChar(FError()) + ")")
		Return
	EndIf

	FWrite(nHdl, cLinha + CRLF)
	FClose(nHdl)

Return
