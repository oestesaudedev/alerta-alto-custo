#INCLUDE "TOTVS.CH"
#INCLUDE "PROTHEUS.CH"

#DEFINE __TST_NAME   "TSTMEDALTC"
#DEFINE __PAR_WATER  "Z_NOTIENCA"

// Mesmas posicoes do resumo devolvido por U_OSMEDALTC (__P_* em OS_MEDALTC.tlpp)
#DEFINE __P_TOTAL    1
#DEFINE __P_FEITAS   2
#DEFINE __P_EMAILS   3
#DEFINE __P_INICIO   4
#DEFINE __P_FINAL    5

/*/{Protheus.doc} tstMEDALTC
Teste integrado do OSMEDALTC (etapa 10): roda o job duas vezes seguidas na mesma thread e confere
que a segunda execucao parte do Z_NOTIENCA gravado pela primeira, sem reprocessar B71 nem reenviar e-mail.

Com cRecnoIni, grava esse valor em Z_NOTIENCA antes da 1a execucao, para reprocessar B71 conhecidas
(ex.: recno da B71 de teste menos 1). Sem ele, parte do valor atual.

Uso (ambiente de teste): U_tstMEDALTC() ou U_tstMEDALTC("123455")
Nao compilar no RPO de producao.
@type function
@author Michel Ramos
@since 28/09/2026
@param cRecnoIni, character, opcional; valor gravado em Z_NOTIENCA antes da 1a execucao
@return logical, .T. se todas as verificacoes passaram
/*/
User Function tstMEDALTC(cRecnoIni)

	Local lAbriu := .F.
	Local lOk    := .T.
	Local aR1    := {}
	Local aR2    := {}
	Local nW1    := 0

	Default cRecnoIni := ""

	If Select("SX2") <= 0
		RpcSetType(3)
		RpcSetEnv("01", "01", , , "PLS")
		lAbriu := .T.
	EndIf

	If !Empty(cRecnoIni)
		If !GetMV(__PAR_WATER, .T.)
			fLog("ERROR", __PAR_WATER + " nao cadastrado na SX6. Execute U_OSCRIAZNOT antes.")
			If lAbriu
				RpcClearEnv()
			EndIf
			Return .F.
		EndIf
		fLog("INFO", __PAR_WATER + " reposicionado: " + cValToChar(fWater()) + " -> " + AllTrim(cRecnoIni))
		PutMV(__PAR_WATER, AllTrim(cRecnoIni))
	EndIf

	fLog("INFO", "Watermark inicial: " + cValToChar(fWater()))

	fLog("INFO", "--- 1a execucao ---")
	aR1 := U_OSMEDALTC({cEmpAnt, cFilAnt})
	nW1 := fWater()
	fResumo("1a", aR1, nW1)

	fLog("INFO", "--- 2a execucao ---")
	aR2 := U_OSMEDALTC({cEmpAnt, cFilAnt})
	fResumo("2a", aR2, fWater())

	fLog("INFO", "--- Verificacoes ---")
	lOk := fChk("1a execucao leu o " + __PAR_WATER, aR1[__P_INICIO] >= 0,;
		"se falhou: lock ativo, Z_MEDAPIT vazio ou Z_NOTIENCA invalido (ver log)") .And. lOk
	lOk := fChk(__PAR_WATER + " gravado = ultima B71 verificada na 1a (" + cValToChar(aR1[__P_FINAL]) + ")",;
		nW1 == aR1[__P_FINAL], "gravado: " + cValToChar(nW1)) .And. lOk
	lOk := fChk("2a execucao partiu do " + __PAR_WATER + " da 1a (" + cValToChar(nW1) + ")",;
		aR2[__P_INICIO] == nW1, "partiu de: " + cValToChar(aR2[__P_INICIO])) .And. lOk

	Do Case
	Case aR1[__P_FEITAS] < aR1[__P_TOTAL]
		fLog("WARN", "A 1a execucao parou em falha temporaria (" + cValToChar(aR1[__P_FEITAS]) + " de " +;
			cValToChar(aR1[__P_TOTAL]) + " B71); a 2a retomou a B71 pendente, como previsto. Corrigir a causa no log e repetir.")
	Case aR2[__P_TOTAL] == 0
		lOk := fChk("2a execucao sem B71 para processar e sem e-mail", aR2[__P_EMAILS] == 0, "") .And. lOk
	Otherwise
		fLog("INFO", "A 2a execucao achou " + cValToChar(aR2[__P_TOTAL]) + " B71 com R_E_C_N_O_ > " + cValToChar(nW1) +;
			", gravada(s) depois da 1a; nenhuma B71 da 1a foi reprocessada.")
	EndCase

	If aR1[__P_TOTAL] == 0
		fLog("WARN", "A 1a execucao nao tinha B71 na janela: o teste nao exercitou o pipeline." +;
			' Repetir com U_tstMEDALTC("<recno da B71 de teste - 1>").')
	EndIf

	fLog(IIf(lOk, "INFO", "ERROR"), "=== Teste integrado " + IIf(lOk, "OK", "FALHOU") + " ===")

	If lAbriu
		RpcClearEnv()
	EndIf

Return lOk

/*/{Protheus.doc} fResumo
@type function
/*/
Static Function fResumo(cExec, aRes, nWater)

	fLog("INFO", cExec + " execucao: " + cValToChar(aRes[__P_TOTAL]) + " B71 na janela, " +;
		cValToChar(aRes[__P_FEITAS]) + " verificada(s), " + cValToChar(aRes[__P_EMAILS]) + " e-mail(s); " +;
		__PAR_WATER + " " + cValToChar(aRes[__P_INICIO]) + " -> " + cValToChar(nWater))

Return

/*/{Protheus.doc} fWater
Le Z_NOTIENCA sem o cache do SuperGetMV.
@type function
@return numeric, valor atual, ou -1 se nao existir
/*/
Static Function fWater()

	If !GetMV(__PAR_WATER, .T.)
		Return -1
	EndIf

Return Val(AllTrim(cValToChar(GetMV(__PAR_WATER))))

/*/{Protheus.doc} fChk
@type function
@return logical, lPassou (registra "[OK]" ou "[FALHA]" no log)
/*/
Static Function fChk(cItem, lPassou, cDetalhe)

	fLog(IIf(lPassou, "INFO", "ERROR"), IIf(lPassou, "[OK] ", "[FALHA] ") + cItem + IIf(lPassou .Or. Empty(cDetalhe), "", " - " + cDetalhe))

Return lPassou

/*/{Protheus.doc} fLog
@type function
/*/
Static Function fLog(cNivel, cMsg)

	ConOut("[" + __TST_NAME + "][" + cNivel + "][" + DToC(Date()) + " " + Time() + "] " + cMsg)
	FwLogMsg(cNivel, __TST_NAME, __TST_NAME, "", "", "", cMsg, 0, 0)

Return
