# Copie para .env (obrigatório também para o docker compose).
# API_TOKEN obrigatório: aleatório, com 32+ caracteres (a API não sobe sem ele).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORT=3010
API_TOKEN=
OCR_TMP_DIR=./ocr-tmp
PDF_MIN_TEXT_CHARS=40
PDF_MAX_PAGINAS=30
EXTRACAO_CONCORRENCIA=2
# POST /extrair (Base64) só para testes; o job usa o /extrair-sftp
EXTRAIR_BASE64=false
BODY_LIMIT=25mb
# SFTP escolhido pelo "ambiente" enviado pelo Protheus (GetEnvServer)
# *_HOSTKEY: impressões digitais do servidor (ssh-keyscan -p PORTA HOST | ssh-keygen -lf -), separadas por vírgula
SFTP_AMBIENTE_PROD=CYWSXT_PROD
SFTP_PROD_HOST=oestesaude169995.protheus.cloudtotvs.com.br
SFTP_PROD_PORT=2323
SFTP_PROD_USER=ftp_CYWSXT_prod
SFTP_PROD_PASSWORD=
SFTP_PROD_HOSTKEY=SHA256:ocHwC1nv6iAvEkC5Hec/pYGLDwdbf0xgxcy8jweLM/w
SFTP_DEV_HOST=oestesaude175831.protheus.cloudtotvs.com.br
SFTP_DEV_PORT=1151
SFTP_DEV_USER=ftp_CYWSXT_dev
SFTP_DEV_PASSWORD=
SFTP_DEV_HOSTKEY=SHA256:XHWsPidf0pfcge1n79ovLaa3ofym7dFEiIEa/Iqa9qM,SHA256:X+YSdQ1oB3uSzcVCI46HJBLxnK5BarIhNWWT5/Ueinw,SHA256:OYlLkpG6bRKBHF/kH4rDLybjakEuulUHEB3TQqmsOZo
SFTP_DIR=/dirdoc/co01/shared/
# Claude (Anthropic): é a verificação dos medicamentos no /verificar-sftp. Em produção, IA_HABILITADA=true e
# ANTHROPIC_API_KEY (obrigatória com a IA ligada); a máquina da API precisa de saída HTTPS (443) para api.anthropic.com.
# Com a IA desligada, o /verificar-sftp responde "IA indisponivel" e o job não verifica nenhum anexo.
IA_HABILITADA=false
IA_PROVEDOR=anthropic
ANTHROPIC_API_KEY=
IA_MODELO=claude-sonnet-5-5
IA_TIMEOUT_MS=60000
IA_MAX_CHARS=100000
