#INCLUDE "TOTVS.CH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "FILEIO.CH"

#DEFINE __JOB_NAME   "OSMEDALTC"

// Log em arquivo, um por dia: __LOG_DIR + __LOG_ARQ + "_AAAAMMDD.log" (relativo ao RootPath).
// Gravado pelo PlsPtuLog (padrao PLS, grava em \logpls\); __LOG_DIR so vale no fallback fLogArq
#DEFINE __LOG_DIR    "\logpls\"
#DEFINE __LOG_ARQ    "alto_custo"

#DEFINE __MAIL_TO    "michel.ramos@oestesaude.com.br"

// URL da API: __URL_PROD no ambiente __ENV_PROD, __URL_DEV em qualquer outro (ver fApiUrl)
#DEFINE __ENV_PROD   "CYWSXT_PROD"
#DEFINE __URL_PROD   "http://10.1.5.14:6177"
#DEFINE __URL_DEV    "https://easily-honest-pamula.ngrok-free.dev"
#DEFINE __API_PATH   "/verificar-sftp"
#DEFINE __API_URL    fApiUrl()
#DEFINE __API_TOKEN  SuperGetMV("Z_MEDAPIT", .F., "")

#DEFINE __CODDEP     "012"
#DEFINE __CODOBJ     ""

// Debug: B71_DATMOV fixo (AAAAMMDD) no lugar da data de hoje. Deixar "" em producao
#DEFINE __DATA_DBG   ""

#DEFINE __PAR_WATER  "Z_NOTIENCA"

// Posicoes do resumo devolvido por U_OSMEDALTC / fProcessa()
#DEFINE __P_TOTAL    1
#DEFINE __P_FEITAS   2
#DEFINE __P_EMAILS   3
#DEFINE __P_INICIO   4
#DEFINE __P_FINAL    5

// Posicoes do item de B71 devolvido por fConsulta()
#DEFINE __I_RECNO    1
#DEFINE __I_ALIMOV   2
#DEFINE __I_RECMOV   3
#DEFINE __I_NUMGUI   4
#DEFINE __I_ANEXOS   5
#DEFINE __I_STATUS   6
#DEFINE __I_TEXTOS   7
#DEFINE __I_DATMOV   8
#DEFINE __I_PESSOAS  9
#DEFINE __I_TAM      9

// Campos de nome lidos na tabela origem da guia (prefixo = alias), se existirem no dicionario
#DEFINE __CPO_NOMES  {"_NOMUSR", "_NOMSOL"}
// Campos da matricula do beneficiario na tabela origem, na ordem da chave da BA1
#DEFINE __CPO_MATRIC {"_OPEUSR", "_CODEMP", "_MATRIC", "_TIPREG", "_DIGITO"}

// Posicoes de cada anexo em __I_ANEXOS
#DEFINE __A_CODOBJ   1
#DEFINE __A_OBJETO   2

// Posicoes de cada anexo verificado em __I_TEXTOS (preenchido por fProcessaB71)
#DEFINE __T_OBJETO   1
#DEFINE __T_METODO   2
#DEFINE __T_ACHADOS  3
#DEFINE __T_AVISOS   4

// Posicoes do retorno de fExtraiTexto()
#DEFINE __R_OK       1
#DEFINE __R_METODO   2
#DEFINE __R_ERRO     3
#DEFINE __R_DEFINIT  4
#DEFINE __R_ACHADOS  5
#DEFINE __R_AVISOS   6
#DEFINE __R_MODELO   7

// Posicoes de cada achado da API em __R_ACHADOS / __T_ACHADOS
#DEFINE __V_CODIGO   1
#DEFINE __V_TERMO    2
#DEFINE __V_OBS      3

// Posicoes de cada aviso da API em __R_AVISOS / __T_AVISOS
#DEFINE __W_TIPO     1
#DEFINE __W_CODIGO   2
#DEFINE __W_OBS      3

// Segundos por anexo. A API limita o OCR de PDF a PDF_MAX_PAGINAS paginas para caber aqui
#DEFINE __API_TIMEOUT 300

// Termos com menos letras que isso nao vao para a IA (a descricao da BR8 sempre vai)
#DEFINE __MIN_TERMO  4

// Posicoes de cada medicamento encontrado por fBuscaMed()
#DEFINE __F_CODPSA   1
#DEFINE __F_DESCRI   2
#DEFINE __F_TERMO    3
#DEFINE __F_OBJETO   4
#DEFINE __F_CODPAD   5
#DEFINE __F_VLRTAB   6
#DEFINE __F_VLRGUI   7
#DEFINE __F_IAOBS    8

// Posicoes do item de medicamento devolvido por fCarregaMed()
#DEFINE __M_CODPSA   1
#DEFINE __M_DESCRI   2
#DEFINE __M_TERMOS   3
#DEFINE __M_CODPAD   4
#DEFINE __M_VLRTAB   5

// Texto mostrado no e-mail quando a tabela/campo de valor nao existe no dicionario
#DEFINE __VLR_ND     "n/d"

// Status de cada B71 resolvida por fMontaB71()
#DEFINE __ST_OK        "OK"
#DEFINE __ST_SEMANEXO  "SEM_ANEXO"
#DEFINE __ST_SEMGUIA   "SEM_GUIA"
#DEFINE __ST_ORIGEM    "ORIGEM_NAO_ENCONTRADA"
#DEFINE __ST_ALIAS     "ALIAS_DESCONHECIDO"
#DEFINE __ST_CAMPO     "CAMPO_GUIA_INEXISTENTE"

/*/{Protheus.doc} OSMEDALTC
Job de deteccao de medicamentos de alto custo em anexos de guias.

Fluxo: B71 (R_E_C_N_O_ > Z_NOTIENCA, DATMOV = hoje, CODDEP = __CODDEP)
  -> tabela origem (BEA | BE4 | B44 | B4Q | B4A) -> B53 -> AC9 -> ACB
  -> API (__API_URL) com o ACB_OBJETO, os medicamentos BR8/BA8 (BR8_ALTCUS = '1') e os nomes da guia
     a mascarar: a API baixa o arquivo do SFTP, extrai o texto e pede ao Claude os medicamentos da
     lista citados (nome exato, comercial, principio ativo, abreviacao, erro de OCR)
  -> valor na guia -> e-mail para __MAIL_TO.

A IA e a unica verificacao: achados com confianca alta ou media entram no alerta, baixa so no log.
Sem a IA (desligada na API, sem chave, fora do ar) a API devolve erro e a B71 fica para a proxima
rodada, como em qualquer falha temporaria da API.

As credenciais do SFTP ficam no .env da API, nao no Protheus. O job envia o ambiente
(GetEnvServer) no POST e a API usa o SFTP de producao quando ele e CYWSXT_PROD, senao o de dev.

URL da API por ambiente (GetEnvServer): CYWSXT_PROD -> __URL_PROD + __API_PATH;
qualquer outro -> __URL_DEV + __API_PATH.

Parametros SX6:
  Z_NOTIENCA - ultimo R_E_C_N_O_ da B71 ja verificado (criar com U_OSCRIAZNOT)
  Z_MEDAPIT  - token Bearer da API de extracao
  MV_RELSERV, MV_RELACNT, MV_RELPSW, MV_RELAUTH, MV_RELSSL, MV_RELTLS, MV_RELFROM - SMTP padrao do Protheus

Z_NOTIENCA avanca apos cada B71 concluida (com ou sem anexo/medicamento/e-mail). Falha de API,
SFTP ou SMTP interrompe a execucao sem avancar, e a B71 e retomada na proxima rodada.

Agendamento (Scheduler / CFGX032):
  Rotina....: U_OSMEDALTC
  Parametros: {'01','01'} (empresa, filial)
  Recorrencia: a cada 15 minutos
  Execucao concorrente bloqueada por LockByName.

Log: \logpls\alto_custo_AAAAMMDD.log no RootPath (um arquivo por dia, gravado pelo PlsPtuLog),
alem do console do AppServer.

Teste: U_chkMEDALTC([cArquivo]) confere configuracao, API/SFTP e SMTP sem gravar nada;
U_dbgMEDALTC roda o job; U_dataMEDALTC("AAAAMMDD") roda o job para as B71 de outra data;
U_tstMEDALTC (teste-integrado/OS_TSTMEDALTC.tlpp) roda duas vezes
e confere que nao ha reprocessamento.

@type function
@author Michel Ramos
@since 28/09/2026
@param aJob, array, {cEmpresa, cFilial} enviado pelo Scheduler
@return array, resumo {nTotalB71, nVerificadas, nEmails, nWaterInicial, nWaterFinal};
	watermark -1 quando a execucao nao chegou a ler o Z_NOTIENCA
/*/
User Function OSMEDALTC(aJob)
Return fExecuta(aJob, Nil)

/*/{Protheus.doc} fExecuta
Execucao do job: abre o ambiente, trava o lock e roda fProcessa. Compartilhada por U_OSMEDALTC
(data de hoje) e U_dataMEDALTC (data informada). A data nao vem no aJob porque o Scheduler pode
mandar outros elementos alem de empresa e filial.
@type function
@param aJob, array, {cEmpresa, cFilial}
@param xData, character, Nil = hoje; senao data informada (AAAAMMDD ou DD/MM/AAAA), validada aqui
@return array, resumo {nTotalB71, nVerificadas, nEmails, nWaterInicial, nWaterFinal}
/*/
Static Function fExecuta(aJob, xData)

	Local cEmp    := "01"
	Local cFil    := "01"
	Local cData   := ""
	Local lAbriu  := .F.
	Local bErrOld := Nil
	Local oErro   := Nil
	Local aRes    := {0, 0, 0, -1, -1}

	Default aJob := {}

	If ValType(aJob) == "A" .And. Len(aJob) >= 2
		cEmp := aJob[1]
		cFil := aJob[2]
	EndIf

	If Select("SX2") <= 0
		RpcSetType(3)
		RpcSetEnv(cEmp, cFil, , , "PLS")
		lAbriu := .T.
	EndIf

	If ValType(xData) != "U"
		cData := fDataParam(xData)
		If Empty(cData)
			fLog("ERROR", "Data invalida ou futura: '" + cValToChar(xData) + "'. Use AAAAMMDD ou DD/MM/AAAA.")
			If lAbriu
				RpcClearEnv()
			EndIf
			Return aRes
		EndIf
	EndIf

	If !LockByName(__JOB_NAME, .T., .F.)
		fLog("WARN", "Ja existe uma execucao em andamento (lock ativo). Encerrando.")
		If lAbriu
			RpcClearEnv()
		EndIf
		Return aRes
	EndIf

	fLog("INFO", "Inicio da execucao (empresa " + cEmp + ", filial " + cFil + ")" +;
		IIf(Empty(cData), "", " - data informada manualmente: " + DToC(SToD(cData))))

	bErrOld := ErrorBlock({|e| Break(e)})
	BEGIN SEQUENCE
		fProcessa(aRes, cData)
	RECOVER USING oErro
		fLog("ERROR", "Execucao interrompida: " + IIf(ValType(oErro) == "O", oErro:Description, "erro desconhecido"))
	END SEQUENCE
	ErrorBlock(bErrOld)

	fLog("INFO", "Fim da execucao")

	UnLockByName(__JOB_NAME, .T., .F.)

	If lAbriu
		RpcClearEnv()
	EndIf

Return aRes

/*/{Protheus.doc} dbgMEDALTC
Executa o job manualmente para depuracao.
@type function
@return array, resumo de U_OSMEDALTC
/*/
User Function dbgMEDALTC()
Return U_OSMEDALTC({'01','01'})

/*/{Protheus.doc} dataMEDALTC
Executa o job manualmente verificando as B71 de uma data (B71_DATMOV) no lugar de hoje, com o
fluxo normal: B71 com R_E_C_N_O_ > Z_NOTIENCA, extracao, e-mail e avanco do Z_NOTIENCA.
B71 dessa data com recno <= Z_NOTIENCA nao sao vistas; para inclui-las, baixar antes o
Z_NOTIENCA (U_OSCRIAZNOT("<recno - 1>")), com o agendamento pausado.
Uso: U_dataMEDALTC("20260925") ou U_dataMEDALTC("25/09/2026")
@type function
@param cData, character, data da movimentacao: AAAAMMDD ou DD/MM/AAAA
@return array, resumo como o de U_OSMEDALTC ({0,0,0,-1,-1} se a data for invalida)
/*/
User Function dataMEDALTC(cData)

	Default cData := ""

Return fExecuta({'01', '01'}, cData)

/*/{Protheus.doc} fDataParam
Converte a data informada em U_dataMEDALTC sem depender do SET DATE do ambiente.
@type function
@param xData, character|date, AAAAMMDD, DD/MM/AAAA ou tipo Data
@return character, AAAAMMDD, ou "" se vazia, inexistente (ex.: 31/02) ou futura
/*/
Static Function fDataParam(xData)

	Local cData := ""

	Do Case
	Case ValType(xData) == "D"
		cData := DToS(xData)
	Case ValType(xData) == "C" .And. Len(AllTrim(xData)) == 10 .And. SubStr(AllTrim(xData), 3, 1) == "/"
		cData := AllTrim(xData)
		cData := Right(cData, 4) + SubStr(cData, 4, 2) + Left(cData, 2)
	Case ValType(xData) == "C"
		cData := AllTrim(xData)
	EndCase

	// SToD nao recusa data inexistente; a volta por DToS precisa dar o mesmo texto
	If Len(cData) != 8 .Or. !fSoDigitos(cData) .Or. DToS(SToD(cData)) != cData .Or. SToD(cData) > Date()
		cData := ""
	EndIf

Return cData

/*/{Protheus.doc} chkMEDALTC
Diagnostico do teste integrado: confere cada peca sem gravar Z_NOTIENCA e sem enviar e-mail
(configuracao, watermark, medicamentos, B71 da janela, API + token + SFTP e conexao SMTP).
Com cArquivo (um ACB_OBJETO real), verifica o anexo na API (extracao + IA) e lista os medicamentos
que entrariam no alerta e os avisos. Sem cArquivo, a IA nao e chamada.
Uso: U_chkMEDALTC() ou U_chkMEDALTC("arquivo.pdf")
@type function
@param cArquivo, character, opcional; nome do arquivo no SFTP (sem pasta)
@return logical, .T. se todas as verificacoes passaram
/*/
User Function chkMEDALTC(cArquivo)

	Local lAbriu  := .F.
	Local lOk     := .F.
	Local bErrOld := Nil
	Local oErro   := Nil

	Default cArquivo := ""

	If Select("SX2") <= 0
		RpcSetType(3)
		RpcSetEnv("01", "01", , , "PLS")
		lAbriu := .T.
	EndIf

	fLog("INFO", "=== Diagnostico " + __JOB_NAME + " (nao grava " + __PAR_WATER + " e nao envia e-mail) ===")

	bErrOld := ErrorBlock({|e| Break(e)})
	BEGIN SEQUENCE
		lOk := fDiagnostico(AllTrim(cArquivo))
	RECOVER USING oErro
		fLog("ERROR", "Diagnostico interrompido: " + IIf(ValType(oErro) == "O", oErro:Description, "erro desconhecido"))
	END SEQUENCE
	ErrorBlock(bErrOld)

	fLog(IIf(lOk, "INFO", "ERROR"), "=== Diagnostico " + IIf(lOk, "OK", "COM FALHAS") + " ===")

	If lAbriu
		RpcClearEnv()
	EndIf

Return lOk

/*/{Protheus.doc} fDiagnostico
@type function
@param cArquivo, character, ACB_OBJETO real para extrair, ou "" para so testar API/token/SFTP
@return logical, .T. se todas as verificacoes passaram
/*/
Static Function fDiagnostico(cArquivo)

	Local lOk      := .T.
	Local lSmtp    := .F.
	Local nUltimo  := -1
	Local nCampo   := 0
	Local nInicio  := 0
	Local aMed     := {}
	Local aB71     := {}
	Local aRes     := {}
	Local aItem    := {}
	Local aAchados := {}
	Local aMedApi  := {}
	Local oServer  := Nil
	Local nI       := 0

	lOk := fChk("Token Z_MEDAPIT", fValidaCfg(), "") .And. lOk

	nUltimo := fLeWatermark()
	lOk := fChk("Watermark " + __PAR_WATER, nUltimo >= 0, cValToChar(nUltimo)) .And. lOk

	aMed := fCarregaMed()
	lOk := fChk("Medicamentos de alto custo (BR8_ALTCUS = '1' com BA8)", Len(aMed) > 0, cValToChar(Len(aMed)) + " item(ns)") .And. lOk
	For nI := 1 To Min(Len(aMed), 5)
		fLog("INFO", "  " + aMed[nI][__M_CODPSA] + " " + aMed[nI][__M_DESCRI] + " | " + cValToChar(Len(aMed[nI][__M_TERMOS])) +;
			" termo(s) | valor de tabela: " + aMed[nI][__M_VLRTAB])
	Next nI

	If nUltimo >= 0
		aB71 := fConsulta(nUltimo)
		For nI := 1 To Len(aB71)
			fLogB71(aB71[nI])
			If aB71[nI][__I_STATUS] == __ST_CAMPO
				nCampo++
			EndIf
		Next nI
		lOk := fChk("B71 na janela (R_E_C_N_O_ > " + cValToChar(nUltimo) + ", DATMOV = " + fDataMov() + ", CODDEP = " + __CODDEP + ")",;
			nCampo == 0, cValToChar(Len(aB71)) + " registro(s)" +;
			IIf(nCampo > 0, "; " + cValToChar(nCampo) + " com campo de guia inexistente (bloqueia o watermark)", "")) .And. lOk
	EndIf

	// A API exige a lista de medicamentos mesmo no teste de conexao
	aMedApi := fMedApi(aMed)
	nInicio := Seconds()
	If Empty(cArquivo)
		aRes := fExtraiTexto("chk_medaltc_inexistente.pdf", aMedApi)
		lOk := fChk("API + token + SFTP (" + __API_URL + ")", aRes[__R_DEFINIT] .And. "encontrado no SFTP" $ aRes[__R_ERRO],;
			IIf(aRes[__R_DEFINIT], "API respondeu e consultou o SFTP",;
				IIf("Cannot POST" $ aRes[__R_ERRO], "API sem o " + __API_PATH + ": atualizar a API antes do patch", aRes[__R_ERRO]))) .And. lOk
		fLog("INFO", "  Para testar a extracao e a IA, informe um arquivo: U_chkMEDALTC(" + '"arquivo.pdf"' + ")")
	Else
		aRes := fExtraiTexto(cArquivo, aMedApi)
		lOk := fChk("Verificacao de " + cArquivo + " (extracao + IA)", aRes[__R_OK] .And. !Empty(aRes[__R_MODELO]),;
			IIf(!aRes[__R_OK], aRes[__R_ERRO],;
				IIf(Empty(aRes[__R_MODELO]), "API sem a IA obrigatoria (versao anterior): atualizar a API",;
					"via " + aRes[__R_METODO] + " e " + aRes[__R_MODELO] + " em " + cValToChar(Round(Seconds() - nInicio, 1)) + "s"))) .And. lOk
		If aRes[__R_OK]
			aItem := Array(__I_TAM)
			aItem[__I_TEXTOS] := {{cArquivo, aRes[__R_METODO], aRes[__R_ACHADOS], aRes[__R_AVISOS]}}
			aAchados := fBuscaMed(aItem, aMed)
			fLog("INFO", "  " + cValToChar(Len(aAchados)) + " medicamento(s) de alto custo entraria(m) no alerta")
			For nI := 1 To Len(aAchados)
				fLog("INFO", "  " + aAchados[nI][__F_CODPSA] + " " + aAchados[nI][__F_DESCRI] + " | termo: " + aAchados[nI][__F_TERMO] +;
					" | " + aAchados[nI][__F_IAOBS])
			Next nI
		EndIf
	EndIf

	lSmtp := fSmtpConecta(@oServer)
	If lSmtp
		oServer:SMTPDisconnect()
	EndIf
	lOk := fChk("SMTP (MV_RELSERV)", lSmtp, IIf(lSmtp, "conexao" + IIf(fMvLogico("MV_RELAUTH"), " e autenticacao", "") + " OK", "")) .And. lOk

Return lOk

/*/{Protheus.doc} fChk
@type function
@return logical, lPassou (registra "[OK]" ou "[FALHA]" no log)
/*/
Static Function fChk(cItem, lPassou, cDetalhe)

	fLog(IIf(lPassou, "INFO", "ERROR"), IIf(lPassou, "[OK] ", "[FALHA] ") + cItem + IIf(Empty(cDetalhe), "", " - " + cDetalhe))

Return lPassou

/*/{Protheus.doc} fProcessa
Processamento principal do job.
@type function
@param aRes, array, resumo da execucao (preenchido por referencia; posicoes __P_*)
@param cData, character, B71_DATMOV (AAAAMMDD) informado manualmente; "" = hoje
/*/
Static Function fProcessa(aRes, cData)

	Local nUltimo  := 0
	Local nGravado := 0
	Local aMed     := {}
	Local aMedApi  := {}
	Local aB71     := {}
	Local nEmails  := 0
	Local nI       := 0

	Default cData := ""

	If !fValidaCfg()
		Return
	EndIf

	nUltimo := fLeWatermark()
	If nUltimo < 0
		Return
	EndIf
	aRes[__P_INICIO] := nUltimo
	aRes[__P_FINAL]  := nUltimo

	aMed := fCarregaMed()
	fLog("INFO", cValToChar(Len(aMed)) + " medicamento(s) de alto custo carregado(s) (BR8_ALTCUS = '1' com BA8)")
	If Len(aMed) == 0
		fLog("WARN", "Nenhum medicamento de alto custo na BR8/BA8; nada a comparar. Encerrando sem avancar " + __PAR_WATER + ".")
		Return
	EndIf

	aMedApi := fMedApi(aMed)

	fLog("INFO", "Watermark " + __PAR_WATER + " = " + cValToChar(nUltimo) +;
		"; buscando B71 com R_E_C_N_O_ > " + cValToChar(nUltimo) +;
		", CODDEP = " + __CODDEP + ", DATMOV = " + fDataMov(cData))

	fAvisaAtrasadas(nUltimo, cData)

	aB71 := fConsulta(nUltimo, cData)
	aRes[__P_TOTAL] := Len(aB71)
	If Len(aB71) == 0
		fLog("INFO", "Nenhuma B71 nova.")
		Return
	EndIf

	nGravado := nUltimo
	For nI := 1 To Len(aB71)
		fLogB71(aB71[nI])
		If !fVerificaB71(aB71[nI], aMed, @nEmails, aMedApi)
			fLog("WARN", "B71 " + cValToChar(aB71[nI][__I_RECNO]) + " nao concluida; ela e as seguintes" +;
				" serao retomadas na proxima execucao. " + __PAR_WATER + " permanece em " + cValToChar(nGravado) + ".")
			Exit
		EndIf
		nGravado := aB71[nI][__I_RECNO]
		fGravaWatermark(nGravado)
		aRes[__P_FEITAS]++
		aRes[__P_FINAL] := nGravado
	Next nI
	aRes[__P_EMAILS] := nEmails

	fLog("INFO", cValToChar(aRes[__P_FEITAS]) + " de " + cValToChar(Len(aB71)) + " B71 verificada(s), " +;
		cValToChar(nEmails) + " e-mail(s) enviado(s)")

Return

/*/{Protheus.doc} fVerificaB71
Pipeline completo de uma B71: verifica os anexos na API, monta os medicamentos achados e,
se houver, envia o e-mail.
@type function
@param aItem, array, item devolvido por fConsulta()
@param aMed, array, medicamentos devolvidos por fCarregaMed()
@param nEmails, numeric, contador de e-mails enviados (por referencia)
@param aMedApi, array, lista de medicamentos enviada a API (fMedApi)
@return logical, .T. se a B71 pode ser dada como verificada (avancar Z_NOTIENCA)
/*/
Static Function fVerificaB71(aItem, aMed, nEmails, aMedApi)

	Local aAchados := {}
	Local cLista   := ""
	Local oErro    := Nil
	Local nI       := 0

	If aItem[__I_STATUS] == __ST_CAMPO
		Return .F.
	EndIf

	If !fProcessaB71(aItem, aMedApi)
		Return .F.
	EndIf

	If Len(aItem[__I_TEXTOS]) == 0
		Return .T.
	EndIf

	aAchados := fBuscaMed(aItem, aMed)
	If Len(aAchados) == 0
		fLog("INFO", "  nenhum medicamento de alto custo nos anexos")
		Return .T.
	EndIf

	For nI := 1 To Len(aAchados)
		cLista += IIf(nI > 1, ", ", "") + aAchados[nI][__F_CODPSA] + " (" + aAchados[nI][__F_TERMO] + " em " + aAchados[nI][__F_OBJETO] + ")"
	Next nI
	fLog("INFO", "  " + cValToChar(Len(aAchados)) + " ocorrencia(s) de alto custo: " + cLista)

	BEGIN SEQUENCE
		fValorGuia(aItem, aAchados)
	RECOVER USING oErro
		fLog("WARN", "  valor na guia nao apurado: " + IIf(ValType(oErro) == "O", oErro:Description, "erro desconhecido"))
	END SEQUENCE

	If !fEnviaEmail(aItem, aAchados)
		Return .F.
	EndIf
	nEmails++

Return .T.

/*/{Protheus.doc} fBuscaMed
Monta os medicamentos achados pela IA (na API) em cada anexo da B71 e registra os avisos no log.
@type function
@return array, { {cCodPsa, cDescri, cTermo, cObjeto, cCodPad, cVlrTab, cVlrGui, cIaObs}, ... }: no maximo
	uma ocorrencia por medicamento em cada anexo. cVlrGui e preenchido depois por fValorGuia()
/*/
Static Function fBuscaMed(aItem, aMed)

	Local aAchados := {}
	Local aTexto   := {}
	Local nT       := 0

	For nT := 1 To Len(aItem[__I_TEXTOS])
		aTexto := aItem[__I_TEXTOS][nT]
		aEval(fAchadosApi(aTexto[__T_ACHADOS], aMed, aTexto[__T_OBJETO]), {|x| aAdd(aAchados, x)})
		fLogAvisos(aTexto[__T_OBJETO], aTexto[__T_AVISOS])
	Next nT

Return aAchados

/*/{Protheus.doc} fAchadosApi
Converte os achados da API de um anexo para o formato de fBuscaMed, com descricao, CODPAD e valor
de tabela da BR8/BA8. Codigo fora da lista (nao deveria acontecer) so vai para o log.
@type function
@param aApi, array, achados de fLeAchados() ou Nil
@param aMed, array, medicamentos de fCarregaMed()
@param cObjeto, character, ACB_OBJETO do anexo
@return array, achados no formato de fBuscaMed
/*/
Static Function fAchadosApi(aApi, aMed, cObjeto)

	Local aRet := {}
	Local nM   := 0
	Local nI   := 0

	If ValType(aApi) != "A"
		Return aRet
	EndIf

	For nI := 1 To Len(aApi)
		nM := aScan(aMed, {|x| x[__M_CODPSA] == aApi[nI][__V_CODIGO]})
		If nM == 0
			fLog("WARN", "  " + cObjeto + ": codigo " + aApi[nI][__V_CODIGO] + " devolvido pela API fora da lista de medicamentos")
			Loop
		EndIf
		aAdd(aRet, {aApi[nI][__V_CODIGO], aMed[nM][__M_DESCRI], aApi[nI][__V_TERMO], cObjeto,;
			aMed[nM][__M_CODPAD], aMed[nM][__M_VLRTAB], __VLR_ND, aApi[nI][__V_OBS]})
	Next nI

Return aRet

/*/{Protheus.doc} fLogAvisos
Registra os avisos da API de um anexo: IA com confianca baixa e texto maior que o limite da IA.
@type function
@param cObjeto, character, ACB_OBJETO do anexo
@param aAvisos, array, avisos de fLeAvisos() ou Nil
/*/
Static Function fLogAvisos(cObjeto, aAvisos)

	Local cCodigo := ""
	Local nI      := 0

	If ValType(aAvisos) != "A"
		Return
	EndIf

	For nI := 1 To Len(aAvisos)
		cCodigo := aAvisos[nI][__W_CODIGO]
		Do Case
		Case aAvisos[nI][__W_TIPO] == "confianca-baixa"
			fLog("INFO", "  [IA] " + cCodigo + " em " + cObjeto + " com confianca baixa: fora do alerta")
		Case aAvisos[nI][__W_TIPO] == "texto-cortado"
			fLog("WARN", "  [IA] " + cObjeto + ": " + aAvisos[nI][__W_OBS])
		EndCase
	Next nI

Return

/*/{Protheus.doc} fLimpa
Troca pontuacao, quebras de linha e simbolos por espaco e junta espacos repetidos, para que
descricoes iguais a menos de pontuacao virem um termo so. Espera texto ja normalizado por fNormaliza().
@type function
/*/
Static Function fLimpa(cTexto)

	Local aTroca := {Chr(13), Chr(10), Chr(9), ".", ",", ";", ":", "!", "?", "(", ")", "[", "]", "{", "}",;
		"/", "\", "|", "-", "_", "+", "*", "=", "<", ">", '"', "'", "`", "^", "~", "@", "#", "$", "%", "&",;
		Chr(145), Chr(146), Chr(147), Chr(148), Chr(150), Chr(151), Chr(170), Chr(176), Chr(186), Chr(167)}
	Local cRet   := cTexto
	Local nI     := 0

	For nI := 1 To Len(aTroca)
		cRet := StrTran(cRet, aTroca[nI], " ")
	Next nI

	While "  " $ cRet
		cRet := StrTran(cRet, "  ", " ")
	EndDo

Return AllTrim(cRet)

/*/{Protheus.doc} fEnviaEmail
Envia o alerta da B71 para __MAIL_TO pelo SMTP configurado no Protheus
(MV_RELSERV, MV_RELACNT, MV_RELPSW, MV_RELAUTH, MV_RELSSL, MV_RELTLS, MV_RELFROM).
@type function
@return logical, .T. se o e-mail foi aceito pelo servidor SMTP
/*/
Static Function fEnviaEmail(aItem, aAchados)

	Local cFrom   := AllTrim(SuperGetMV("MV_RELFROM", .F., ""))
	Local oServer := Nil
	Local oMsg    := Nil
	Local nErro   := 0

	If !fSmtpConecta(@oServer)
		Return .F.
	EndIf

	If Empty(cFrom)
		cFrom := AllTrim(SuperGetMV("MV_RELACNT", .F., ""))
	EndIf

	oMsg := TMailMessage():New()
	oMsg:Clear()
	oMsg:cFrom    := cFrom
	oMsg:cTo      := __MAIL_TO
	oMsg:cSubject := fAssunto(aItem, aAchados)
	oMsg:cBody    := fCorpoEmail(aItem, aAchados)

	nErro := oMsg:Send(oServer)
	oServer:SMTPDisconnect()

	If nErro != 0
		fLog("ERROR", "  SMTP - falha no envio: " + oServer:GetErrorString(nErro))
		Return .F.
	EndIf

	fLog("INFO", "  e-mail enviado para " + __MAIL_TO)

Return .T.

/*/{Protheus.doc} fSmtpConecta
Conecta (e autentica, se MV_RELAUTH) no SMTP padrao do Protheus.
@type function
@param oServer, object, (por referencia) TMailManager conectado; o chamador faz SMTPDisconnect()
@return logical, .T. se conectou
/*/
Static Function fSmtpConecta(oServer)

	Local cServer := AllTrim(SuperGetMV("MV_RELSERV", .F., ""))
	Local cConta  := AllTrim(SuperGetMV("MV_RELACNT", .F., ""))
	Local cSenha  := AllTrim(SuperGetMV("MV_RELPSW", .F., ""))
	Local nPorta  := 25
	Local nErro   := 0

	If Empty(cServer)
		fLog("ERROR", "  MV_RELSERV (servidor SMTP) nao configurado; e-mail nao enviado")
		Return .F.
	EndIf

	If ":" $ cServer
		nPorta  := Val(SubStr(cServer, At(":", cServer) + 1))
		cServer := Left(cServer, At(":", cServer) - 1)
	EndIf

	oServer := TMailManager():New()
	oServer:SetUseSSL(fMvLogico("MV_RELSSL"))
	oServer:SetUseTLS(fMvLogico("MV_RELTLS"))
	oServer:Init("", cServer, cConta, cSenha, 0, nPorta)
	oServer:SetSMTPTimeout(60)

	nErro := oServer:SMTPConnect()
	If nErro != 0
		fLog("ERROR", "  SMTP " + cServer + ":" + cValToChar(nPorta) + " - falha na conexao: " + oServer:GetErrorString(nErro))
		Return .F.
	EndIf

	If fMvLogico("MV_RELAUTH")
		nErro := oServer:SmtpAuth(cConta, cSenha)
		If nErro != 0
			fLog("ERROR", "  SMTP - falha na autenticacao: " + oServer:GetErrorString(nErro))
			oServer:SMTPDisconnect()
			Return .F.
		EndIf
	EndIf

Return .T.

/*/{Protheus.doc} fAssunto
@type function
@return character, "[Alto custo] Guia <guia> - <n> medicamento(s) identificado(s)"
/*/
Static Function fAssunto(aItem, aAchados)

	Local aCodigos := {}
	Local nI       := 0

	For nI := 1 To Len(aAchados)
		If aScan(aCodigos, {|x| x == aAchados[nI][__F_CODPSA]}) == 0
			aAdd(aCodigos, aAchados[nI][__F_CODPSA])
		EndIf
	Next nI

Return "[Alto custo] Guia " + aItem[__I_NUMGUI] + " - " + cValToChar(Len(aCodigos)) + " medicamento(s) identificado(s)"

/*/{Protheus.doc} fCorpoEmail
Monta o corpo HTML do alerta. Nao inclui trechos do texto dos anexos (dados de saude).
@type function
@return character, HTML
/*/
Static Function fCorpoEmail(aItem, aAchados)

	Local cHtml := ""
	Local nI    := 0

	cHtml += '<html><body style="font-family:Arial,sans-serif;font-size:13px">'
	cHtml += "<p>O job OSMEDALTC identificou medicamento(s) de alto custo em anexo(s) de guia.</p>"

	cHtml += '<table border="1" cellpadding="4" cellspacing="0" style="border-collapse:collapse">'
	cHtml += "<tr><td><b>Guia</b></td><td>" + fHtml(aItem[__I_NUMGUI]) + "</td></tr>"
	cHtml += "<tr><td><b>Origem</b></td><td>" + fHtml(aItem[__I_ALIMOV]) + " (recno " + fHtml(aItem[__I_RECMOV]) + ")</td></tr>"
	cHtml += "<tr><td><b>Movimenta&ccedil;&atilde;o B71</b></td><td>" + cValToChar(aItem[__I_RECNO]) + " - " + DToC(SToD(aItem[__I_DATMOV])) + "</td></tr>"
	cHtml += "</table>"

	cHtml += "<p><b>Medicamentos encontrados:</b></p>"
	cHtml += '<table border="1" cellpadding="4" cellspacing="0" style="border-collapse:collapse">'
	cHtml += "<tr><th>C&oacute;digo</th><th>Descri&ccedil;&atilde;o (BR8)</th><th>Valor de tabela</th>" +;
		"<th>Valor na guia</th><th>Termo encontrado</th><th>Anexo</th><th>Observa&ccedil;&atilde;o IA</th></tr>"
	For nI := 1 To Len(aAchados)
		cHtml += "<tr>"
		cHtml += "<td>" + fHtml(aAchados[nI][__F_CODPSA]) + "</td>"
		cHtml += "<td>" + fHtml(aAchados[nI][__F_DESCRI]) + "</td>"
		cHtml += '<td style="text-align:right">' + fHtml(aAchados[nI][__F_VLRTAB]) + "</td>"
		cHtml += '<td style="text-align:right">' + fHtml(aAchados[nI][__F_VLRGUI]) + "</td>"
		cHtml += "<td>" + fHtml(aAchados[nI][__F_TERMO]) + "</td>"
		cHtml += "<td>" + fHtml(aAchados[nI][__F_OBJETO]) + "</td>"
		cHtml += "<td>" + fHtml(aAchados[nI][__F_IAOBS]) + "</td>"
		cHtml += "</tr>"
	Next nI
	cHtml += "</table>"
	cHtml += '<p style="font-size:11px;color:#555">Valor de tabela: BD4 na vig&ecirc;ncia mais recente at&eacute; ' + DToC(Date()) +;
		". Valor na guia: soma dos itens da guia com o mesmo c&oacute;digo; &quot;nao consta&quot; quando o medicamento" +;
		" aparece s&oacute; no anexo. &quot;" + __VLR_ND + "&quot;: valor n&atilde;o dispon&iacute;vel no dicion&aacute;rio.</p>"
	cHtml += '<p style="font-size:11px;color:#555">Identifica&ccedil;&atilde;o feita pela IA (Claude) sobre o texto do anexo:' +;
		" nome do cadastro, nome comercial, princ&iacute;pio ativo, abrevia&ccedil;&atilde;o ou erro de leitura." +;
		" Confira o anexo antes de agir.</p>"

	cHtml += '<p style="color:#888">Mensagem autom&aacute;tica - n&atilde;o responder.</p>'
	cHtml += "</body></html>"

Return cHtml

/*/{Protheus.doc} fHtml
@type function
@return character, texto com &, < e > escapados para HTML
/*/
Static Function fHtml(cTexto)
Return StrTran(StrTran(StrTran(cValToChar(cTexto), "&", "&amp;"), "<", "&lt;"), ">", "&gt;")

/*/{Protheus.doc} fMvLogico
@type function
@return logical, valor do parametro SX6 logico (.F. se nao existir)
/*/
Static Function fMvLogico(cPar)

	Local xValor := SuperGetMV(cPar, .F., .F.)

Return ValType(xValor) == "L" .And. xValor

/*/{Protheus.doc} fGravaWatermark
Grava em Z_NOTIENCA o R_E_C_N_O_ da B71 verificada. So e chamada em ordem crescente de recno.
@type function
/*/
Static Function fGravaWatermark(nRecno)

	PutMV(__PAR_WATER, cValToChar(nRecno))
	fLog("INFO", "  " + __PAR_WATER + " = " + cValToChar(nRecno))

Return

/*/{Protheus.doc} fProcessaB71
Verifica cada anexo da B71 na API e guarda o resultado em aItem[__I_TEXTOS].
Anexo com erro definitivo (nao existe no SFTP, extensao nao suportada) e descartado.
@type function
@param aMedApi, array, lista de medicamentos enviada a API (fMedApi)
@return logical, .F. se houve falha temporaria (API/SFTP/IA fora, timeout, token); a B71
	nao deve ser dada como verificada
/*/
Static Function fProcessaB71(aItem, aMedApi)

	Local aRes    := {}
	Local cObjeto := ""
	Local nInicio := 0
	Local nI      := 0

	If aItem[__I_STATUS] != __ST_OK
		Return .T.
	EndIf

	If fPosOrigem(aItem[__I_ALIMOV], Val(aItem[__I_RECMOV]))
		aItem[__I_PESSOAS] := fPessoas(aItem[__I_ALIMOV])
		fLog("INFO", "  mascaramento para a IA: " + cValToChar(Len(aItem[__I_PESSOAS])) + " nome(s)/matricula da guia")
	EndIf

	For nI := 1 To Len(aItem[__I_ANEXOS])
		cObjeto := aItem[__I_ANEXOS][nI][__A_OBJETO]
		nInicio := Seconds()
		aRes    := fExtraiTexto(cObjeto, aMedApi, aItem[__I_PESSOAS])

		Do Case
		Case aRes[__R_OK]
			aAdd(aItem[__I_TEXTOS], {cObjeto, aRes[__R_METODO], aRes[__R_ACHADOS], aRes[__R_AVISOS]})
			fLog("INFO", "  " + cObjeto + ": texto via " + aRes[__R_METODO] + ", IA " + aRes[__R_MODELO] + " em " +;
				cValToChar(Round(Seconds() - nInicio, 1)) + "s, " + cValToChar(Len(aRes[__R_ACHADOS])) + " achado(s)")
		Case aRes[__R_DEFINIT]
			fLog("WARN", "  " + cObjeto + ": descartado (" + aRes[__R_ERRO] + ")")
		Otherwise
			fLog("ERROR", "  " + cObjeto + ": " + aRes[__R_ERRO])
			Return .F.
		EndCase
	Next nI

Return .T.

/*/{Protheus.doc} fExtraiTexto
Pede a API a verificacao de um anexo: POST em __API_URL com {arquivo: ACB_OBJETO, ambiente: GetEnvServer(),
medicamentos, mascarar}. A API baixa o arquivo do SFTP do ambiente (prod ou dev), extrai o texto e
pede ao Claude os medicamentos da lista citados. O texto nao volta para o Protheus.
Devolve {ok, metodo, modelo, achados, avisos} ou {ok:false, erro} (inclusive "IA indisponivel: ...").
@type function
@param cArquivo, character, ACB_OBJETO (so o nome, sem pasta)
@param aMedApi, array, lista de medicamentos (fMedApi); a API recusa lista vazia
@param aMascarar, array, opcional; nomes e matricula da guia (fPessoas) que a API mascara antes do Claude
@return array, {lOk, cMetodo, cErro, lDefinitivo, aAchados, aAvisos, cModelo}. lDefinitivo indica
	erro que nao muda numa nova tentativa (arquivo inexistente, extensao/nome invalidos); aAchados
	(fLeAchados) e aAvisos (fLeAvisos)
/*/
Static Function fExtraiTexto(cArquivo, aMedApi, aMascarar)

	Local aRet    := {.F., "", "", .F., {}, {}, ""}
	Local oRest   := Nil
	Local oBody   := JsonObject():New()
	Local oResp   := JsonObject():New()
	Local aHeader := {}
	Local aPessoa := {}
	Local cHost   := ""
	Local cPath   := ""
	Local cResp   := ""
	Local cErro   := ""
	Local xErro   := Nil

	Default aMedApi   := {}
	Default aMascarar := {}

	fSplitUrl(__API_URL, @cHost, @cPath)

	oBody["arquivo"]      := EncodeUTF8(cArquivo)
	oBody["ambiente"]     := AllTrim(GetEnvServer())
	oBody["medicamentos"] := aMedApi
	If Len(aMascarar) > 0
		aEval(aMascarar, {|x| aAdd(aPessoa, EncodeUTF8(x))})
		oBody["mascarar"] := aPessoa
	EndIf

	aAdd(aHeader, "Content-Type: application/json")
	aAdd(aHeader, "Authorization: Bearer " + AllTrim(__API_TOKEN))

	oRest := FWRest():New(cHost)
	oRest:SetPath(cPath)
	oRest:SetPostParams(oBody:ToJson())
	oRest:SetTimeOut(__API_TIMEOUT)
	oRest:Post(aHeader)

	cResp := oRest:GetResult()
	If Empty(cResp)
		aRet[__R_ERRO] := "sem resposta da API (" + AllTrim(cValToChar(oRest:GetLastError())) + ")"
		Return aRet
	EndIf

	If ValType(oResp:FromJson(cResp)) == "C"
		aRet[__R_ERRO] := "resposta invalida da API: " + Left(cResp, 200)
		Return aRet
	EndIf

	If ValType(oResp["ok"]) == "L" .And. oResp["ok"]
		aRet[__R_OK]      := .T.
		aRet[__R_METODO]  := cValToChar(oResp["metodo"])
		aRet[__R_MODELO]  := cValToChar(oResp["modelo"])
		aRet[__R_ACHADOS] := fLeAchados(oResp["achados"])
		aRet[__R_AVISOS]  := fLeAvisos(oResp["avisos"])
		Return aRet
	EndIf

	cErro := IIf(ValType(oResp["erro"]) == "C", oResp["erro"], Left(cResp, 200))
	xErro := DecodeUTF8(cErro)
	aRet[__R_ERRO]    := IIf(ValType(xErro) == "C", xErro, cErro)
	aRet[__R_DEFINIT] := "encontrado no SFTP" $ cErro .Or.;
		"suportada" $ cErro .Or.;
		"nome de arquivo inv" $ cErro

Return aRet

/*/{Protheus.doc} fSplitUrl
Separa "http://host:porta/caminho" em host ("http://host:porta") e caminho ("/caminho"),
como o FWRest espera.
@type function
/*/
Static Function fSplitUrl(cUrl, cHost, cPath)

	Local nIni   := At("//", cUrl)
	Local nBarra := At("/", SubStr(cUrl, nIni + 2))

	If nBarra == 0
		cHost := cUrl
		cPath := "/"
	Else
		cHost := Left(cUrl, nIni + nBarra)
		cPath := SubStr(cUrl, nIni + nBarra + 1)
	EndIf

Return

/*/{Protheus.doc} fLeAchados
Converte o campo "achados" da resposta da API: [{codigo, termo, origem: ia, observacao}].
@type function
@param aLista, array, oResp["achados"] ou Nil
@return array, { {cCodigo, cTermo, cObs}, ... }
/*/
Static Function fLeAchados(aLista)

	Local aRet := {}
	Local nI   := 0

	If ValType(aLista) != "A"
		Return aRet
	EndIf

	For nI := 1 To Len(aLista)
		If ValType(aLista[nI]) == "J" .And. ValType(aLista[nI]["codigo"]) == "C"
			aAdd(aRet, {AllTrim(aLista[nI]["codigo"]), fDecUtf8(aLista[nI]["termo"]), fDecUtf8(aLista[nI]["observacao"])})
		EndIf
	Next nI

Return aRet

/*/{Protheus.doc} fLeAvisos
Converte o campo "avisos" da resposta da API: [{tipo: confianca-baixa|texto-cortado, codigo, observacao}].
@type function
@param aLista, array, oResp["avisos"] ou Nil
@return array, { {cTipo, cCodigo, cObs}, ... }
/*/
Static Function fLeAvisos(aLista)

	Local aRet := {}
	Local nI   := 0

	If ValType(aLista) != "A"
		Return aRet
	EndIf

	For nI := 1 To Len(aLista)
		If ValType(aLista[nI]) == "J" .And. ValType(aLista[nI]["codigo"]) == "C"
			aAdd(aRet, {AllTrim(cValToChar(aLista[nI]["tipo"])), AllTrim(aLista[nI]["codigo"]), fDecUtf8(aLista[nI]["observacao"])})
		EndIf
	Next nI

Return aRet

/*/{Protheus.doc} fMedApi
Monta, uma vez por execucao, a lista de medicamentos enviada a API (LISTA do prompt da IA).
@type function
@param aMed, array, medicamentos de fCarregaMed()
@return array, { JsonObject {codigo, descricao, termos[]}, ... }; termos ja normalizados (fAddTermo)
/*/
Static Function fMedApi(aMed)

	Local aLista  := {}
	Local aTermos := {}
	Local oMed    := Nil
	Local nI      := 0
	Local nK      := 0

	For nI := 1 To Len(aMed)
		aTermos := {}
		For nK := 1 To Len(aMed[nI][__M_TERMOS])
			aAdd(aTermos, EncodeUTF8(aMed[nI][__M_TERMOS][nK]))
		Next nK
		oMed := JsonObject():New()
		oMed["codigo"]    := EncodeUTF8(aMed[nI][__M_CODPSA])
		oMed["descricao"] := EncodeUTF8(aMed[nI][__M_DESCRI])
		oMed["termos"]    := aTermos
		aAdd(aLista, oMed)
	Next nI

Return aLista

/*/{Protheus.doc} fDecUtf8
@type function
@return character, texto UTF-8 da API convertido; o original se a conversao falhar
/*/
Static Function fDecUtf8(xTexto)

	Local cTexto := IIf(ValType(xTexto) == "C", xTexto, "")
	Local xDec   := DecodeUTF8(cTexto)

Return IIf(ValType(xDec) == "C", xDec, cTexto)

/*/{Protheus.doc} fCarregaMed
Carrega os medicamentos de alto custo: BR8 INNER JOIN BA8, BR8_ALTCUS = '1'.
Itens so na BR8, sem BA8, ficam de fora.
@type function
@return array, { {cCodPsa, cDescri, aTermos, cCodPad, cVlrTab}, ... }. aTermos tem as descricoes
	normalizadas (BR8_DESCRI, BA8_DESCRI, BA8_DPRINC), sem repeticao. cVlrTab vem de fCarregaVlrTab().
/*/
Static Function fCarregaMed()

	Local aMed   := {}
	Local cQuery := ""
	Local cAlias := ""
	Local cCod   := ""
	Local oErro  := Nil
	Local nPos   := 0

	cQuery := "SELECT BR8.BR8_CODPAD, BR8.BR8_CODPSA, BR8.BR8_DESCRI, BA8.BA8_DESCRI AS BA8DESC, BA8.BA8_DPRINC" +;
		" FROM " + RetSqlName("BR8") + " BR8" +;
		" INNER JOIN " + RetSqlName("BA8") + " BA8" +;
		" ON BA8.BA8_FILIAL = '" + xFilial("BA8") + "'" +;
		" AND BA8.BA8_CDPADP = BR8.BR8_CODPAD" +;
		" AND BA8.BA8_CODPRO = BR8.BR8_CODPSA" +;
		" AND BA8.D_E_L_E_T_ = ' '" +;
		" WHERE BR8.BR8_FILIAL = '" + xFilial("BR8") + "'" +;
		" AND BR8.BR8_ALTCUS = '1'" +;
		" AND BR8.D_E_L_E_T_ = ' '" +;
		" ORDER BY BR8.BR8_CODPSA"

	cAlias := MPSysOpenQuery(ChangeQuery(cQuery))

	While !(cAlias)->(Eof())
		cCod := AllTrim((cAlias)->BR8_CODPSA)
		nPos := Len(aMed)
		If nPos == 0 .Or. aMed[nPos][__M_CODPSA] != cCod
			aAdd(aMed, {cCod, AllTrim((cAlias)->BR8_DESCRI), {}, AllTrim((cAlias)->BR8_CODPAD), __VLR_ND})
			nPos := Len(aMed)
		EndIf
		fAddTermo(aMed[nPos][__M_TERMOS], (cAlias)->BR8_DESCRI)
		fAddTermo(aMed[nPos][__M_TERMOS], (cAlias)->BA8DESC)
		fAddTermo(aMed[nPos][__M_TERMOS], (cAlias)->BA8_DPRINC)
		(cAlias)->(DbSkip())
	EndDo

	(cAlias)->(DbCloseArea())

	If Len(aMed) > 0
		BEGIN SEQUENCE
			fCarregaVlrTab(aMed)
		RECOVER USING oErro
			fLog("WARN", "Valor de tabela nao apurado: " + IIf(ValType(oErro) == "O", oErro:Description, "erro desconhecido"))
			aEval(aMed, {|x| x[__M_VLRTAB] := IIf(Empty(x[__M_VLRTAB]), __VLR_ND, x[__M_VLRTAB])})
		END SEQUENCE
	EndIf

Return aMed

/*/{Protheus.doc} fCarregaVlrTab
Preenche o valor de tabela de cada medicamento: BA8 (BA8_CODTAB) -> BD4 na vigencia mais recente,
isto e, o maior BD4_VIGINI <= hoje para cada tabela + unidade (BD4_CODIGO). BD4_VIGFIM nao e considerado
e vigencias futuras ficam de fora.
Um medicamento pode ter mais de uma tabela/unidade; os valores sao listados separados por " / ".
Sem os campos no dicionario, o valor fica __VLR_ND e o job segue.
@type function
@param aMed, array, medicamentos de fCarregaMed() (alterado por referencia)
/*/
Static Function fCarregaVlrTab(aMed)

	Local cHoje  := DToS(Date())
	Local cFalta := ""
	Local cQuery := ""
	Local cAlias := ""
	Local cValor := ""
	Local nPos   := 0
	Local nI     := 0

	If !fCamposOk("BA8", {"BA8_CODTAB"}, @cFalta) .Or.;
		!fCamposOk("BD4", {"BD4_CODTAB", "BD4_CDPADP", "BD4_CODPRO", "BD4_CODIGO", "BD4_VALREF", "BD4_VIGINI"}, @cFalta)
		fLog("WARN", "Valor de tabela indisponivel: " + cFalta + " nao existe no dicionario. E-mail sai com '" + __VLR_ND + "'.")
		Return
	EndIf

	For nI := 1 To Len(aMed)
		aMed[nI][__M_VLRTAB] := ""
	Next nI

	cQuery := "SELECT DISTINCT BR8.BR8_CODPSA, BD4.BD4_CODTAB, BD4.BD4_CODIGO, BD4.BD4_VALREF" +;
		" FROM " + RetSqlName("BR8") + " BR8" +;
		" INNER JOIN " + RetSqlName("BA8") + " BA8" +;
		" ON BA8.BA8_FILIAL = '" + xFilial("BA8") + "'" +;
		" AND BA8.BA8_CDPADP = BR8.BR8_CODPAD" +;
		" AND BA8.BA8_CODPRO = BR8.BR8_CODPSA" +;
		" AND BA8.D_E_L_E_T_ = ' '" +;
		" INNER JOIN " + RetSqlName("BD4") + " BD4" +;
		" ON BD4.BD4_FILIAL = '" + xFilial("BD4") + "'" +;
		" AND BD4.BD4_CODTAB = BA8.BA8_CODTAB" +;
		" AND BD4.BD4_CDPADP = BA8.BA8_CDPADP" +;
		" AND BD4.BD4_CODPRO = BA8.BA8_CODPRO" +;
		" AND BD4.BD4_VIGINI <= '" + cHoje + "'" +;
		" AND BD4.BD4_VALREF > 0" +;
		" AND BD4.D_E_L_E_T_ = ' '" +;
		" AND NOT EXISTS (SELECT 1 FROM " + RetSqlName("BD4") + " BD4N" +;
			" WHERE BD4N.BD4_FILIAL = BD4.BD4_FILIAL" +;
			" AND BD4N.BD4_CODTAB = BD4.BD4_CODTAB" +;
			" AND BD4N.BD4_CDPADP = BD4.BD4_CDPADP" +;
			" AND BD4N.BD4_CODPRO = BD4.BD4_CODPRO" +;
			" AND BD4N.BD4_CODIGO = BD4.BD4_CODIGO" +;
			" AND BD4N.BD4_VIGINI > BD4.BD4_VIGINI" +;
			" AND BD4N.BD4_VIGINI <= '" + cHoje + "'" +;
			" AND BD4N.D_E_L_E_T_ = ' ')" +;
		" WHERE BR8.BR8_FILIAL = '" + xFilial("BR8") + "'" +;
		" AND BR8.BR8_ALTCUS = '1'" +;
		" AND BR8.D_E_L_E_T_ = ' '" +;
		" ORDER BY BR8.BR8_CODPSA, BD4.BD4_CODTAB, BD4.BD4_CODIGO"

	cAlias := MPSysOpenQuery(ChangeQuery(cQuery))

	While !(cAlias)->(Eof())
		nPos := aScan(aMed, {|x| x[__M_CODPSA] == AllTrim((cAlias)->BR8_CODPSA)})
		If nPos > 0
			cValor := fMoeda((cAlias)->BD4_VALREF) + " (tab " + AllTrim((cAlias)->BD4_CODTAB) + " " + AllTrim((cAlias)->BD4_CODIGO) + ")"
			aMed[nPos][__M_VLRTAB] += IIf(Empty(aMed[nPos][__M_VLRTAB]), "", " / ") + cValor
		EndIf
		(cAlias)->(DbSkip())
	EndDo

	(cAlias)->(DbCloseArea())

	For nI := 1 To Len(aMed)
		If Empty(aMed[nI][__M_VLRTAB])
			aMed[nI][__M_VLRTAB] := "sem valor na tabela"
		EndIf
	Next nI

Return

/*/{Protheus.doc} fValorGuia
Preenche __F_VLRGUI de cada medicamento encontrado com a soma do valor dos itens da guia
de origem que tem o mesmo CODPAD + CODPRO. Tabelas de itens e campos em fCfgItens().
@type function
@param aItem, array, B71 (origem em __I_ALIMOV / __I_RECMOV)
@param aAchados, array, retorno de fBuscaMed() (alterado por referencia)
/*/
Static Function fValorGuia(aItem, aAchados)

	Local cAliMov := aItem[__I_ALIMOV]
	Local aCfg    := fCfgItens(cAliMov)
	Local aCampos := {}
	Local cFalta  := ""
	Local cQuery  := ""
	Local cAlias  := ""
	Local cIte    := ""
	Local aItens  := {}
	Local nPos    := 0
	Local nI      := 0

	If Len(aCfg) == 0
		fLog("WARN", "  valor na guia: tabela de itens de " + cAliMov + " nao mapeada em fCfgItens()")
		Return
	EndIf

	cIte := aCfg[2]
	For nI := 1 To Len(aCfg[3])
		aAdd(aCampos, aCfg[3][nI][1])
	Next nI
	If !fCamposOk(cAliMov, aCampos, @cFalta)
		fLog("WARN", "  valor na guia indisponivel: " + cFalta + " nao existe no dicionario")
		Return
	EndIf

	aCampos := {aCfg[4], aCfg[5], aCfg[6]}
	For nI := 1 To Len(aCfg[3])
		aAdd(aCampos, aCfg[3][nI][2])
	Next nI
	If !fCamposOk(cIte, aCampos, @cFalta)
		fLog("WARN", "  valor na guia indisponivel: " + cFalta + " nao existe no dicionario")
		Return
	EndIf

	If !fPosOrigem(cAliMov, Val(aItem[__I_RECMOV]))
		fLog("WARN", "  valor na guia: registro origem " + cAliMov + " " + aItem[__I_RECMOV] + " nao encontrado")
		Return
	EndIf

	cQuery := "SELECT " + aCfg[4] + " AS CODPAD, " + aCfg[5] + " AS CODPRO, SUM(" + aCfg[6] + ") AS VALOR" +;
		" FROM " + RetSqlName(cIte) +;
		" WHERE " + cIte + "_FILIAL = '" + xFilial(cIte) + "'"
	For nI := 1 To Len(aCfg[3])
		cQuery += " AND " + aCfg[3][nI][2] + " = '" + fSqlStr((cAliMov)->(FieldGet(FieldPos(aCfg[3][nI][1])))) + "'"
	Next nI
	cQuery += " AND D_E_L_E_T_ = ' '" +;
		" GROUP BY " + aCfg[4] + ", " + aCfg[5]

	cAlias := MPSysOpenQuery(ChangeQuery(cQuery))

	While !(cAlias)->(Eof())
		aAdd(aItens, {AllTrim((cAlias)->CODPAD), AllTrim((cAlias)->CODPRO), (cAlias)->VALOR})
		(cAlias)->(DbSkip())
	EndDo

	(cAlias)->(DbCloseArea())

	For nI := 1 To Len(aAchados)
		nPos := aScan(aItens, {|x| x[1] == aAchados[nI][__F_CODPAD] .And. x[2] == aAchados[nI][__F_CODPSA]})
		aAchados[nI][__F_VLRGUI] := IIf(nPos > 0, fMoeda(aItens[nPos][3]), "nao consta")
	Next nI

Return

/*/{Protheus.doc} fCfgItens
Mapa tabela origem -> tabela de itens da guia. Confirmar os campos no SX3 da base com
levantamento/05-campos-valor.sql; campo inexistente so deixa a coluna "Valor na guia" como n/d.
@type function
@return array, {cAliOri, cAliIte, {{cCampoOri, cCampoIte}, ...}, cCpoCodPad, cCpoCodPro, cCpoValor}
	ou {} se o alias nao estiver mapeado
/*/
Static Function fCfgItens(cAliMov)

	Local aMapa := {;
		{"BEA", "BE2", {{"BEA_OPEMOV", "BE2_OPEMOV"}, {"BEA_ANOAUT", "BE2_ANOAUT"}, {"BEA_MESAUT", "BE2_MESAUT"}, {"BEA_NUMAUT", "BE2_NUMAUT"}},;
			"BE2_CODPAD", "BE2_CODPRO", "BE2_VLRAPR"},;
		{"BE4", "BEJ", {{"BE4_CODOPE", "BEJ_CODOPE"}, {"BE4_ANOINT", "BEJ_ANOINT"}, {"BE4_MESINT", "BEJ_MESINT"}, {"BE4_NUMINT", "BEJ_NUMINT"}},;
			"BEJ_CODPAD", "BEJ_CODPRO", "BEJ_VLRAPR"},;
		{"B44", "B45", {{"B44_OPEMOV", "B45_OPEMOV"}, {"B44_ANOAUT", "B45_ANOAUT"}, {"B44_MESAUT", "B45_MESAUT"}, {"B44_NUMAUT", "B45_NUMAUT"}},;
			"B45_CODPAD", "B45_CODPRO", "B45_VLRAPR"},;
		{"B4Q", "BQV", {{"B4Q_OPEMOV", "BQV_OPEMOV"}, {"B4Q_ANOAUT", "BQV_ANOAUT"}, {"B4Q_MESAUT", "BQV_MESAUT"}, {"B4Q_NUMAUT", "BQV_NUMAUT"}},;
			"BQV_CODPAD", "BQV_CODPRO", "BQV_VLRAPR"},;
		{"B4A", "B4C", {{"B4A_OPEMOV", "B4C_OPEMOV"}, {"B4A_ANOAUT", "B4C_ANOAUT"}, {"B4A_MESAUT", "B4C_MESAUT"}, {"B4A_NUMAUT", "B4C_NUMAUT"}},;
			"B4C_CODPAD", "B4C_CODPRO", "B4C_VLRAPR"}}
	Local nPos := aScan(aMapa, {|x| x[1] == cAliMov})

Return IIf(nPos > 0, aMapa[nPos], {})

/*/{Protheus.doc} fCamposOk
@type function
@param cFalta, character, (por referencia) tabela ou campo que falta
@return logical, .T. se a tabela e todos os campos existem no dicionario
/*/
Static Function fCamposOk(cAlias, aCampos, cFalta)

	Local nI := 0

	If !AliasInDic(cAlias)
		cFalta := "tabela " + cAlias
		Return .F.
	EndIf

	DbSelectArea(cAlias)
	For nI := 1 To Len(aCampos)
		If (cAlias)->(FieldPos(aCampos[nI])) == 0
			cFalta := aCampos[nI]
			Return .F.
		EndIf
	Next nI

Return .T.

/*/{Protheus.doc} fSqlStr
@type function
@return character, valor de campo pronto para literal SQL (datas em AAAAMMDD, aspas duplicadas)
/*/
Static Function fSqlStr(xValor)

	Local cRet := IIf(ValType(xValor) == "D", DToS(xValor), cValToChar(xValor))

Return StrTran(cRet, "'", "''")

/*/{Protheus.doc} fMoeda
@type function
@return character, "R$ 1.234,56"
/*/
Static Function fMoeda(nValor)
Return "R$ " + AllTrim(Transform(nValor, "@E 999,999,999,999.99"))

/*/{Protheus.doc} fAddTermo
Adiciona a descricao normalizada (fNormaliza + fLimpa) em aTermos, se tiver pelo menos
__MIN_TERMO caracteres e ainda nao estiver presente.
@type function
/*/
Static Function fAddTermo(aTermos, cTexto)

	Local cTermo := fLimpa(fNormaliza(cTexto))

	If Len(cTermo) >= __MIN_TERMO .And. aScan(aTermos, {|x| x == cTermo}) == 0
		aAdd(aTermos, cTermo)
	EndIf

Return

/*/{Protheus.doc} fNormaliza
@type function
@return character, texto sem acento, em maiusculas e sem espacos nas pontas
/*/
Static Function fNormaliza(cTexto)
Return Upper(FwNoAccent(AllTrim(cTexto)))

/*/{Protheus.doc} fConsulta
Busca as B71 novas (R_E_C_N_O_ > nUltimo, DATMOV = fDataMov(cData), CODDEP = __CODDEP) e, para cada uma,
resolve a guia na tabela origem e os anexos B53 -> AC9 -> ACB.
Todas as B71 da janela voltam, inclusive sem anexo ou com alias desconhecido, para que o
watermark possa avancar sobre elas.
@type function
@param nUltimo, numeric, valor atual de Z_NOTIENCA
@param cData, character, opcional; B71_DATMOV informado manualmente (AAAAMMDD); "" = hoje
@return array, itens {nRecno, cAliMov, cRecMov, cNumGui, aAnexos, cStatus, aTextos, cDatMov} em ordem de R_E_C_N_O_
/*/
Static Function fConsulta(nUltimo, cData)

	Local aB71   := {}
	Local cQuery := ""
	Local cAlias := ""

	Default cData := ""

	cQuery := "SELECT B71.R_E_C_N_O_ AS B71REC, B71.B71_ALIMOV, B71.B71_RECMOV, B71.B71_DATMOV" +;
		" FROM " + RetSqlName("B71") + " B71" +;
		" WHERE B71.B71_FILIAL = '" + xFilial("B71") + "'" +;
		" AND B71.B71_CODDEP = '" + __CODDEP + "'" +;
		" AND B71.B71_DATMOV = '" + fDataMov(cData) + "'" +;
		" AND B71.R_E_C_N_O_ > " + cValToChar(nUltimo) +;
		" AND B71.D_E_L_E_T_ = ' '" +;
		" ORDER BY B71.R_E_C_N_O_"

	cAlias := MPSysOpenQuery(ChangeQuery(cQuery))

	While !(cAlias)->(Eof())
		aAdd(aB71, fMontaB71((cAlias)->B71REC, AllTrim((cAlias)->B71_ALIMOV), AllTrim((cAlias)->B71_RECMOV),;
			IIf(ValType((cAlias)->B71_DATMOV) == "D", DToS((cAlias)->B71_DATMOV), AllTrim((cAlias)->B71_DATMOV))))
		(cAlias)->(DbSkip())
	EndDo

	(cAlias)->(DbCloseArea())

Return aB71

/*/{Protheus.doc} fAvisaAtrasadas
Avisa no log sobre B71 de dias anteriores acima do watermark. O job so verifica o dia corrente, e
essas B71 (job parado ou com falha na virada do dia) ficam para tras assim que o watermark
avancar sobre a primeira B71 do dia. Nao altera o processamento.
@type function
@param nUltimo, numeric, valor atual de Z_NOTIENCA
@param cData, character, opcional; B71_DATMOV informado manualmente (AAAAMMDD); "" = hoje
/*/
Static Function fAvisaAtrasadas(nUltimo, cData)

	Local cQuery := ""
	Local cAlias := ""

	Default cData := ""

	cQuery := "SELECT COUNT(*) AS QTD, MIN(B71.R_E_C_N_O_) AS PRIREC, MIN(B71.B71_DATMOV) AS PRIDAT" +;
		" FROM " + RetSqlName("B71") + " B71" +;
		" WHERE B71.B71_FILIAL = '" + xFilial("B71") + "'" +;
		" AND B71.B71_CODDEP = '" + __CODDEP + "'" +;
		" AND B71.B71_DATMOV < '" + fDataMov(cData) + "'" +;
		" AND B71.R_E_C_N_O_ > " + cValToChar(nUltimo) +;
		" AND B71.D_E_L_E_T_ = ' '"

	cAlias := MPSysOpenQuery(ChangeQuery(cQuery))

	If !(cAlias)->(Eof()) .And. (cAlias)->QTD > 0
		fLog("WARN", cValToChar((cAlias)->QTD) + " B71 de dia(s) anterior(es) ficaram sem verificacao (a partir do recno " +;
			cValToChar((cAlias)->PRIREC) + ", DATMOV " + AllTrim((cAlias)->PRIDAT) + "). O job so verifica o dia corrente;" +;
			" conferir esses anexos manualmente se necessario.")
	EndIf

	(cAlias)->(DbCloseArea())

Return

/*/{Protheus.doc} fMontaB71
Resolve guia e anexos de uma B71.
@type function
@return array, item {nRecno, cAliMov, cRecMov, cNumGui, aAnexos, cStatus, aTextos, cDatMov, aPessoas}
/*/
Static Function fMontaB71(nRecno, cAliMov, cRecMov, cDatMov)

	Local aItem   := Array(__I_TAM)
	Local cCampo  := fCampoGuia(cAliMov)
	Local nRecOri := Val(cRecMov)
	Local nPosCpo := 0
	Local cGuia   := ""

	aItem[__I_RECNO]  := nRecno
	aItem[__I_ALIMOV] := cAliMov
	aItem[__I_RECMOV] := cRecMov
	aItem[__I_NUMGUI] := ""
	aItem[__I_ANEXOS] := {}
	aItem[__I_TEXTOS] := {}
	aItem[__I_DATMOV] := cDatMov
	aItem[__I_PESSOAS] := {}

	If Empty(cCampo)
		aItem[__I_STATUS] := __ST_ALIAS
		Return aItem
	EndIf

	If nRecOri <= 0 .Or. !fPosOrigem(cAliMov, nRecOri)
		aItem[__I_STATUS] := __ST_ORIGEM
		Return aItem
	EndIf

	nPosCpo := (cAliMov)->(FieldPos(cCampo))
	If nPosCpo == 0
		aItem[__I_STATUS] := __ST_CAMPO
		Return aItem
	EndIf

	cGuia := AllTrim((cAliMov)->(FieldGet(nPosCpo)))
	If Empty(cGuia)
		aItem[__I_STATUS] := __ST_SEMGUIA
		Return aItem
	EndIf

	aItem[__I_NUMGUI] := cGuia
	aItem[__I_ANEXOS] := fBuscaAnexos(cGuia)
	aItem[__I_STATUS] := IIf(Len(aItem[__I_ANEXOS]) > 0, __ST_OK, __ST_SEMANEXO)

Return aItem

/*/{Protheus.doc} fPessoas
Dados pessoais da guia que a API mascara antes de enviar o texto ao Claude: nomes da tabela origem
(__CPO_NOMES), matricula do beneficiario (__CPO_MATRIC) e, sem nome do beneficiario na origem, o
BA1_NOMUSR da matricula. Campo ausente no dicionario e ignorado. Nao vai para o log nem para o e-mail.
@type function
@param cAliMov, character, tabela origem, ja posicionada por fPosOrigem()
@return array, { cNomeOuMatricula, ... }
/*/
Static Function fPessoas(cAliMov)

	Local aRet     := {}
	Local aNomes   := __CPO_NOMES
	Local aMatric  := __CPO_MATRIC
	Local aPartes  := {}
	Local cValor   := ""
	Local cQuery   := ""
	Local cAlias   := ""
	Local cFalta   := ""
	Local lNomUsr  := .F.
	Local oErro    := Nil
	Local nPos     := 0
	Local nI       := 0

	For nI := 1 To Len(aNomes)
		nPos := (cAliMov)->(FieldPos(cAliMov + aNomes[nI]))
		If nPos > 0
			cValor := AllTrim(cValToChar((cAliMov)->(FieldGet(nPos))))
			If !Empty(cValor)
				aAdd(aRet, cValor)
				lNomUsr := lNomUsr .Or. aNomes[nI] == "_NOMUSR"
			EndIf
		EndIf
	Next nI

	For nI := 1 To Len(aMatric)
		nPos := (cAliMov)->(FieldPos(cAliMov + aMatric[nI]))
		If nPos == 0
			aPartes := {}
			Exit
		EndIf
		aAdd(aPartes, AllTrim(cValToChar((cAliMov)->(FieldGet(nPos)))))
	Next nI

	cValor := ""
	aEval(aPartes, {|x| cValor += x})
	If Len(aPartes) != Len(aMatric) .Or. Len(cValor) < 8 .Or. !fSoDigitos(cValor)
		Return aRet
	EndIf
	aAdd(aRet, cValor)

	If lNomUsr .Or. !fCamposOk("BA1", {"BA1_CODINT", "BA1_CODEMP", "BA1_MATRIC", "BA1_TIPREG", "BA1_DIGITO", "BA1_NOMUSR"}, @cFalta)
		Return aRet
	EndIf

	BEGIN SEQUENCE
		cQuery := "SELECT BA1_NOMUSR FROM " + RetSqlName("BA1") +;
			" WHERE BA1_FILIAL = '" + xFilial("BA1") + "'" +;
			" AND BA1_CODINT = '" + fSqlStr(aPartes[1]) + "'" +;
			" AND BA1_CODEMP = '" + fSqlStr(aPartes[2]) + "'" +;
			" AND BA1_MATRIC = '" + fSqlStr(aPartes[3]) + "'" +;
			" AND BA1_TIPREG = '" + fSqlStr(aPartes[4]) + "'" +;
			" AND BA1_DIGITO = '" + fSqlStr(aPartes[5]) + "'" +;
			" AND D_E_L_E_T_ = ' '"
		cAlias := MPSysOpenQuery(ChangeQuery(cQuery))
		If !(cAlias)->(Eof()) .And. !Empty((cAlias)->BA1_NOMUSR)
			aAdd(aRet, AllTrim((cAlias)->BA1_NOMUSR))
		EndIf
		(cAlias)->(DbCloseArea())
	RECOVER USING oErro
		fLog("WARN", "  nome do beneficiario (BA1) nao apurado para o mascaramento: " +;
			IIf(ValType(oErro) == "O", oErro:Description, "erro desconhecido"))
	END SEQUENCE

Return aRet

/*/{Protheus.doc} fCampoGuia
@type function
@return character, campo da guia na tabela origem, ou "" se o alias nao for tratado
/*/
Static Function fCampoGuia(cAliMov)

	Local aMapa := {;
		{"BEA", "BEA_GUIORI"},;
		{"BE4", "BE4_GUIORI"},;
		{"B44", "B44_GUIORI"},;
		{"B4Q", "B4Q_GUIREF"},;
		{"B4A", "B4A_GUIREF"}}
	Local nPos := aScan(aMapa, {|x| x[1] == cAliMov})

Return IIf(nPos > 0, aMapa[nPos][2], "")

/*/{Protheus.doc} fPosOrigem
Posiciona a tabela origem no R_E_C_N_O_ apontado por B71_RECMOV.
@type function
@return logical, .T. se o registro existe e nao esta deletado
/*/
Static Function fPosOrigem(cAliMov, nRecOri)

	DbSelectArea(cAliMov)
	(cAliMov)->(DbGoTo(nRecOri))

Return !(cAliMov)->(Eof()) .And. !(cAliMov)->(Deleted())

/*/{Protheus.doc} fBuscaAnexos
Anexos da guia no banco de conhecimento: B53 (B53_NUMGUI) -> AC9 (AC9_CODENT contem a guia) -> ACB.
@type function
@param cGuia, character, numero da guia original/referencia (sem espacos)
@return array, { {cCodObj, cObjeto}, ... }
/*/
Static Function fBuscaAnexos(cGuia)

	Local aAnexos := {}
	Local nTam    := TamSX3("B53_NUMGUI")[1]
	Local cNumGui := StrTran(Left(cGuia, nTam), "'", "''")
	Local cQuery  := ""
	Local cAlias  := ""

	cQuery := "SELECT DISTINCT ACB.ACB_CODOBJ, ACB.ACB_OBJETO" +;
		" FROM " + RetSqlName("B53") + " B53" +;
		" INNER JOIN " + RetSqlName("AC9") + " AC9" +;
		" ON AC9.AC9_FILIAL = '" + xFilial("AC9") + "'" +;
		" AND AC9.AC9_CODENT LIKE '%" + AllTrim(cNumGui) + "%'" +;
		" AND AC9.D_E_L_E_T_ = ' '" +;
		" INNER JOIN " + RetSqlName("ACB") + " ACB" +;
		" ON ACB.ACB_FILIAL = '" + xFilial("ACB") + "'" +;
		" AND ACB.ACB_CODOBJ = AC9.AC9_CODOBJ" +;
		" AND ACB.ACB_OBJETO <> ' '" +;
		" AND ACB.D_E_L_E_T_ = ' '" +;
		" WHERE B53.B53_FILIAL = '" + xFilial("B53") + "'" +;
		" AND B53.B53_NUMGUI = '" + PadR(cNumGui, nTam) + "'" +;
		" AND B53.D_E_L_E_T_ = ' '"

	If !Empty(__CODOBJ)
		cQuery += " AND ACB.ACB_CODOBJ = '" + __CODOBJ + "'"
	EndIf

	cQuery += " ORDER BY ACB.ACB_CODOBJ"

	cAlias := MPSysOpenQuery(ChangeQuery(cQuery))

	While !(cAlias)->(Eof())
		aAdd(aAnexos, {AllTrim((cAlias)->ACB_CODOBJ), AllTrim((cAlias)->ACB_OBJETO)})
		(cAlias)->(DbSkip())
	EndDo

	(cAlias)->(DbCloseArea())

Return aAnexos

/*/{Protheus.doc} fLogB71
Registra no log o resultado da resolucao de uma B71.
@type function
/*/
Static Function fLogB71(aItem)

	Local cMsg   := "B71 " + cValToChar(aItem[__I_RECNO]) + " (" + aItem[__I_ALIMOV] + " " + aItem[__I_RECMOV] + "): "
	Local cNivel := "INFO"
	Local nI     := 0

	Do Case
	Case aItem[__I_STATUS] == __ST_OK
		cMsg += "guia " + aItem[__I_NUMGUI] + ", " + cValToChar(Len(aItem[__I_ANEXOS])) + " anexo(s):"
		For nI := 1 To Len(aItem[__I_ANEXOS])
			cMsg += " [" + aItem[__I_ANEXOS][nI][__A_CODOBJ] + "] " + aItem[__I_ANEXOS][nI][__A_OBJETO]
		Next nI
	Case aItem[__I_STATUS] == __ST_SEMANEXO
		cMsg += "guia " + aItem[__I_NUMGUI] + " sem anexo no banco de conhecimento"
	Case aItem[__I_STATUS] == __ST_SEMGUIA
		cMsg += "campo da guia vazio na tabela origem"
	Case aItem[__I_STATUS] == __ST_ORIGEM
		cNivel := "WARN"
		cMsg   += "registro origem nao encontrado ou deletado"
	Case aItem[__I_STATUS] == __ST_ALIAS
		cNivel := "WARN"
		cMsg   += "alias de origem nao tratado; registro sera descartado"
	Case aItem[__I_STATUS] == __ST_CAMPO
		cNivel := "ERROR"
		cMsg   += "campo " + fCampoGuia(aItem[__I_ALIMOV]) + " nao existe no dicionario"
	EndCase

	fLog(cNivel, cMsg)

Return

/*/{Protheus.doc} fLeWatermark
Le o ultimo R_E_C_N_O_ da B71 ja verificado (SX6 Z_NOTIENCA).
Usa GetMV e nao SuperGetMV: o cache do SuperGetMV devolveria o valor antigo quando o job roda
mais de uma vez na mesma thread (U_tstMEDALTC, SmartClient) e a B71 seria reprocessada.
@type function
@return numeric, recno do watermark, ou -1 se o parametro nao existir / for invalido
/*/
Static Function fLeWatermark()

	Local xValor := Nil
	Local nValor := -1

	If !GetMV(__PAR_WATER, .T.)
		fLog("ERROR", "Parametro " + __PAR_WATER + " nao cadastrado na SX6. Execute U_OSCRIAZNOT.")
		Return nValor
	EndIf
	xValor := GetMV(__PAR_WATER)

	Do Case
	Case ValType(xValor) == "N"
		nValor := xValor
	Case ValType(xValor) == "C" .And. fSoDigitos(AllTrim(xValor))
		nValor := Val(AllTrim(xValor))
	Otherwise
		fLog("ERROR", "Parametro " + __PAR_WATER + " com conteudo invalido: '" + cValToChar(xValor) + "'")
	EndCase

Return nValor

/*/{Protheus.doc} fValidaCfg
Confere se as configuracoes obrigatorias estao preenchidas.
O token da API vem da SX6 para nao ficar no fonte.
@type function
@return logical, .T. se pode prosseguir
/*/
Static Function fValidaCfg()

	If Empty(__API_TOKEN)
		fLog("ERROR", "Parametro SX6 Z_MEDAPIT (token da API) nao preenchido.")
		Return .F.
	EndIf

	fLog("INFO", "Config: ambiente " + AllTrim(GetEnvServer()) + " | API " + __API_URL + " | e-mail " + __MAIL_TO +;
		IIf(Empty(__CODOBJ), "", " | filtro ACB_CODOBJ = " + __CODOBJ))

	If !Empty(__DATA_DBG)
		fLog("WARN", "__DATA_DBG ativo: B71_DATMOV = " + __DATA_DBG + ' em vez de hoje. Voltar para "" antes de produzir.')
	EndIf

Return .T.

/*/{Protheus.doc} fApiUrl
@type function
@return character, URL do POST __API_PATH: __URL_PROD quando o ambiente e __ENV_PROD, senao __URL_DEV
/*/
Static Function fApiUrl()
Return IIf(Upper(AllTrim(GetEnvServer())) == __ENV_PROD, __URL_PROD, __URL_DEV) + __API_PATH

/*/{Protheus.doc} fDataMov
@type function
@param cData, character, opcional; data informada em U_dataMEDALTC (AAAAMMDD)
@return character, B71_DATMOV consultado (AAAAMMDD): cData se informado, senao __DATA_DBG se
	preenchido, senao hoje
/*/
Static Function fDataMov(cData)

	Default cData := ""

	If !Empty(cData)
		Return cData
	EndIf

Return IIf(Empty(__DATA_DBG), DToS(Date()), __DATA_DBG)

/*/{Protheus.doc} fSoDigitos
@type function
@return logical, .T. se cTexto nao for vazio e tiver apenas digitos
/*/
Static Function fSoDigitos(cTexto)

	Local nI := 0

	If Empty(cTexto)
		Return .F.
	EndIf

	For nI := 1 To Len(cTexto)
		If !IsDigit(SubStr(cTexto, nI, 1))
			Return .F.
		EndIf
	Next nI

Return .T.

/*/{Protheus.doc} fLog
Registra a mensagem no console do AppServer, no log do framework e no arquivo do dia
(PlsPtuLog, ou fLogArq se a funcao nao estiver no RPO).
@type function
@param cNivel, character, INFO | WARN | ERROR
@param cMsg, character, mensagem
/*/
Static Function fLog(cNivel, cMsg)

	Local cLinha := "[" + __JOB_NAME + "][" + cNivel + "][" + DToC(Date()) + " " + Time() + "] " + cMsg

	ConOut(cLinha)
	FwLogMsg(cNivel, __JOB_NAME, __JOB_NAME, "", "", "", cMsg, 0, 0)
	If FindFunction("PlsPtuLog")
		PlsPtuLog(cLinha, __LOG_ARQ + "_" + DToS(Date()) + ".log")
	Else
		fLogArq(cLinha)
	EndIf

Return

/*/{Protheus.doc} fLogArq
Fallback do PlsPtuLog: so e usado quando a funcao nao existe no RPO.
Acrescenta a linha em __LOG_DIR + __LOG_ARQ + "_AAAAMMDD.log". Abre e fecha a cada linha, para nada
ficar em buffer se a thread cair e para o arquivo poder ser lido com o job rodando.
Falha de gravacao so vai para o console: nunca interrompe o job e nao chama fLog (recursao).
@type function
@param cLinha, character, linha ja formatada por fLog
/*/
Static Function fLogArq(cLinha)

	Local cArq := __LOG_DIR + __LOG_ARQ + "_" + DToS(Date()) + ".log"
	Local nHdl := -1

	If !ExistDir(__LOG_DIR)
		MakeDir(__LOG_DIR)
	EndIf

	If File(cArq)
		nHdl := FOpen(cArq, FO_READWRITE + FO_SHARED)
		If nHdl >= 0
			FSeek(nHdl, 0, FS_END)
		EndIf
	Else
		nHdl := FCreate(cArq)
	EndIf

	If nHdl < 0
		ConOut("[" + __JOB_NAME + "][WARN] nao foi possivel gravar " + cArq + " (FError " + cValToChar(FError()) + ")")
		Return
	EndIf

	FWrite(nHdl, cLinha + CRLF)
	FClose(nHdl)

Return
