# Variáveis do compose em produção (só interpolação de porta/IP; sem segredos — token e SFTP ficam no .env da API).
# Uso: docker compose --env-file infra/producao.env -f infra/docker-compose.yml up -d --build
# O Protheus (ambiente CYWSXT_PROD) chama http://10.1.5.14:6177/verificar-sftp.
API_BIND_IP=10.1.5.14
API_HOST_PORT=6177
